                            font-family: "JetBrains Mono"; font-size: 10px;
                            color: RedesignTheme.t.faint; letter-spacing: 1px;
                            horizontal-alignment: left; width: 444px; }
                        for s[i] in root.rows-other : Rectangle {
                            horizontal-stretch: 1; height: 22px;
                            background: sk-ot-ta.has-hover ? RedesignTheme.t.raised : transparent;
                            animate background { duration: 150ms; }
                            sk-ot-ta := TouchArea {
                                width: parent.width; height: parent.height;
                                clicked => { root.set-skill-global(s.id, !s.effective-enabled); }
                            }
                            HorizontalLayout {
                                x: 0; y: 0; width: parent.width; height: parent.height; spacing: 8px;
                                sq-toggle { active: s.effective-enabled; y: (parent.height - 8px) / 2; }
                                Text {
                                    text: s.name; font-size: 12px;
                                    color: s.effective-enabled ? RedesignTheme.t.fg : RedesignTheme.t.muted;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    min-width: 0;
                                    horizontal-stretch: 1;
                                }
                                if !s.effective-enabled : Text {
                                    text: AppStrings.set-skills-disabled;
                                    font-family: "JetBrains Mono"; font-size: 9px;
                                    color: RedesignTheme.t.danger;
                                    vertical-alignment: center;
                                }
                                if sk-ot-ta.has-hover : Text {
                                    text: AppStrings.set-skills-cat-other;
                                    font-family: "JetBrains Mono"; font-size: 9px;
                                    color: RedesignTheme.t.faint; vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // 空态提示仅在无过滤时显示；搜索命中为零时保持
                    // 「零行零分区标题」（brief §5.3 p3-search 验收态）。
                    if root.skills.length == 0 && root.skill-filter == "" : Text {
                        text: AppStrings.skills-empty;
                        font-size: 11px; color: RedesignTheme.t.faint;
                    }
                }
                }
            }
        }
    }
}
