// SettingsView — Phase 3 (with all sub-panels)
//
// Spec: `docs/superpowers/specs/2026-06-26-frontend-onboarding-design.md` §3.2.

import { ProviderItem, SkillStateItem, MCPItem, WorkspaceItem } from "../theme.slint";
import { RedesignTheme } from "../redesign_palette.slint";
import { AppStrings } from "../strings.slint";
import { ProviderSettingsPanel } from "ProviderSettingsPanel.slint";
import { SkillsSettingsPanel } from "SkillsSettingsPanel.slint";
import { MCPSettingsPanel } from "MCPSettingsPanel.slint";
import { WorkspaceSettingsPanel } from "WorkspaceSettingsPanel.slint";
import { GeneralSettingsPanel } from "GeneralSettingsPanel.slint";
import { AccessSettingsPanel } from "AccessSettingsPanel.slint";

export component SettingsView inherits Rectangle {
    background: RedesignTheme.t.bg;

    // A2=a: left menu item the user clicked. Slint enums are not
    // first-class in 1.16 - use a string property and match in panel.
    in-out property <string> active-section: "providers";  // providers|workspaces|skills|mcp|general|access

    // Settings menus (A1+a: sidebar entry; A1+b: cog icon)
    callback close-settings();

    // FR-T4-10b: 主题所有权收归 AppWindow——dark-mode 由 main.slint 传入，
    // toggle-theme 只透传上送，由 root 统一翻转并驱动 RedesignTheme.dark。
    in-out property <bool> dark-mode: RedesignTheme.dark;
    callback toggle-theme();
    // FR-T4-6a: 「编辑身份」行回调占位 TODO（接后端 identity 编辑通路）。
    callback edit-identity();

    // Phase 3: pass-through callbacks for sub-panels. SettingsView
    // doesn't process them; main.slint wires them to AppState methods.
    callback upsert-provider(string, string, string, string, string, string, bool);
    callback delete-provider(string);
    callback test-provider(string);
    callback set-default-model(string);
    callback cleanup-legacy-placeholders();
    callback set-skill-global(string, bool);
    callback set-skill-workspace(string, string);
    callback upsert-mcp(string, string, string, string, string, string, string, bool);
    callback delete-mcp(string);
    callback test-mcp(string);

    // Phase 4: workspace callbacks.
    callback pick-folder();
    callback add-workspace(string, string, bool);
    callback switch-workspace(string);
    callback remove-workspace(string);
    callback edit-identity-md(string);
    callback open-identity-creator();

    in property <[ProviderItem]> providers: [];
    in property <[SkillStateItem]> skills: [];
    in property <[MCPItem]> mcp-servers: [];
    in property <[WorkspaceItem]> workspaces: [];
    in property <int> current-workspace-index: -1;
    in property <string> default-model-provider-id: "";
    in property <int> legacy-placeholder-count: 0;
    in property <string> provider-test-result: "";
    in property <bool> provider-test-in-flight: false;
    // 2026-07-27 (K4a R3, Bug C, fix #5): the per-workspace
    // override column in `SkillsSettingsPanel` is only
    // rendered when this flag is true. The flag is computed
    // server-side (`refresh_settings_lists`) by probing
    // `facade.load_project_skills()` — the current facade
    // implementation is a stub that returns
    // `KernelError::Internal("not yet wired:
    // load_project_skills — workspace_path not available")`,
    // so the flag is always false. When a future K4a
    // follow-up exposes the per-workspace data source, the
    // flag will flip true and the cycle button reappears
    // automatically.
    in property <bool> workspace-override-supported: false;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding: 0px;

        // ===== Left nav (A2=a) =====
        Rectangle {
            width: 240px;
            height: parent.height;
            background: RedesignTheme.t.surface;

            VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding-left: RedesignTheme.t.s4;
                padding-right: RedesignTheme.t.s4;
                padding-top: RedesignTheme.t.s4;
                padding-bottom: RedesignTheme.t.s4;

                // Nav title — Fraunces serif, 24px
                Text {
                    text: AppStrings.settings-open;
                    font-family: "Fraunces";
                    font-size: 24px;
                    font-weight: 500;
                    color: RedesignTheme.t.fg;
                    horizontal-alignment: left;
                }

                Rectangle { height: RedesignTheme.t.s5; }

                // ── Group: 偏好 ──
                Text {
                    text: "偏好";
                    font-size: RedesignTheme.t.fs-md;
                    color: RedesignTheme.t.muted;
                    height: 20px;
                    vertical-alignment: center;
                }

                // Menu items — selection pattern via `active-section`.
                nav-providers := Rectangle {
                    height: 48px;
                    border-radius: RedesignTheme.t.r-sm;
                    background: root.active-section == "providers"
                        ? RedesignTheme.t.raised
                        : nav-providers-ta.has-hover ? RedesignTheme.t.raised : transparent;
                    animate background { duration: 200ms; easing: ease-in-out; }
                    nav-providers-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.active-section = "providers"; }
                    }
                    if root.active-section == "providers": Rectangle {
                        x: 0; width: 3px;
                        y: (parent.height - 16px) / 2; height: 16px;
                        background: RedesignTheme.t.rep-500;
                        border-radius: 2px;
                    }
                    Text {
                        text: AppStrings.settings-providers;
                        font-size: RedesignTheme.t.fs-body;
                        font-weight: root.active-section == "providers" ? 500 : 400;
                        color: RedesignTheme.t.fg;
                        x: RedesignTheme.t.s4;
                        vertical-alignment: center;
                    }
                }
                nav-workspaces := Rectangle {
                    height: 48px;
                    border-radius: RedesignTheme.t.r-sm;
                    background: root.active-section == "workspaces"
                        ? RedesignTheme.t.raised
                        : nav-workspaces-ta.has-hover ? RedesignTheme.t.raised : transparent;
                    animate background { duration: 200ms; easing: ease-in-out; }
                    nav-workspaces-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.active-section = "workspaces"; }
                    }
                    if root.active-section == "workspaces": Rectangle {
                        x: 0; width: 3px;
                        y: (parent.height - 16px) / 2; height: 16px;
                        background: RedesignTheme.t.rep-500;
                        border-radius: 2px;
                    }
                    Text {
                        text: AppStrings.settings-workspaces;
                        font-size: RedesignTheme.t.fs-body;
                        font-weight: root.active-section == "workspaces" ? 500 : 400;
                        color: RedesignTheme.t.fg;
                        x: RedesignTheme.t.s4;
                        vertical-alignment: center;
                    }
                }

                // ── Group: 能力 ──
                Rectangle { height: RedesignTheme.t.s5; }
                Text {
                    text: "能力";
                    font-size: RedesignTheme.t.fs-md;
                    color: RedesignTheme.t.muted;
                    height: 20px;
                    vertical-alignment: center;
                }

                nav-skills := Rectangle {
                    height: 48px;
                    border-radius: RedesignTheme.t.r-sm;
                    background: root.active-section == "skills"
                        ? RedesignTheme.t.raised
                        : nav-skills-ta.has-hover ? RedesignTheme.t.raised : transparent;
                    animate background { duration: 200ms; easing: ease-in-out; }
                    nav-skills-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.active-section = "skills"; }
                    }
                    if root.active-section == "skills": Rectangle {
                        x: 0; width: 3px;
                        y: (parent.height - 16px) / 2; height: 16px;
                        background: RedesignTheme.t.rep-500;
                        border-radius: 2px;
                    }
                    Text {
                        text: AppStrings.settings-skills;
                        font-size: RedesignTheme.t.fs-body;
                        font-weight: root.active-section == "skills" ? 500 : 400;
                        color: RedesignTheme.t.fg;
                        x: RedesignTheme.t.s4;
                        vertical-alignment: center;
                    }
                }
                nav-mcp := Rectangle {
                    height: 48px;
                    border-radius: RedesignTheme.t.r-sm;
                    background: root.active-section == "mcp"
                        ? RedesignTheme.t.raised
                        : nav-mcp-ta.has-hover ? RedesignTheme.t.raised : transparent;
                    animate background { duration: 200ms; easing: ease-in-out; }
                    nav-mcp-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.active-section = "mcp"; }
                    }
                    if root.active-section == "mcp": Rectangle {
                        x: 0; width: 3px;
                        y: (parent.height - 16px) / 2; height: 16px;
                        background: RedesignTheme.t.rep-500;
                        border-radius: 2px;
                    }
                    Text {
                        text: AppStrings.settings-mcp;
                        font-size: RedesignTheme.t.fs-body;
                        font-weight: root.active-section == "mcp" ? 500 : 400;
                        color: RedesignTheme.t.fg;
                        x: RedesignTheme.t.s4;
                        vertical-alignment: center;
                    }
                }

                // ── Group: 通用 ──
                Rectangle { height: RedesignTheme.t.s5; }
                Text {
                    text: "通用";
                    font-size: RedesignTheme.t.fs-md;
                    color: RedesignTheme.t.muted;
                    height: 20px;
                    vertical-alignment: center;
                }

                nav-general := Rectangle {
                    height: 48px;
                    border-radius: RedesignTheme.t.r-sm;
                    background: root.active-section == "general"
                        ? RedesignTheme.t.raised
                        : nav-general-ta.has-hover ? RedesignTheme.t.raised : transparent;
                    animate background { duration: 200ms; easing: ease-in-out; }
                    nav-general-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.active-section = "general"; }
                    }
                    if root.active-section == "general": Rectangle {
                        x: 0; width: 3px;
                        y: (parent.height - 16px) / 2; height: 16px;
                        background: RedesignTheme.t.rep-500;
                        border-radius: 2px;
                    }
                    Text {
                        text: AppStrings.settings-general;
                        font-size: RedesignTheme.t.fs-body;
                        font-weight: root.active-section == "general" ? 500 : 400;
                        color: RedesignTheme.t.fg;
                        x: RedesignTheme.t.s4;
                        vertical-alignment: center;
                    }
                }
                // FR-T4-6a: 访问权限 nav 项（照 settings-access.html 安全组）
                nav-access := Rectangle {
                    height: 48px;
                    border-radius: RedesignTheme.t.r-sm;
                    background: root.active-section == "access"
                        ? RedesignTheme.t.raised
                        : nav-access-ta.has-hover ? RedesignTheme.t.raised : transparent;
                    animate background { duration: 200ms; easing: ease-in-out; }
                    nav-access-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.active-section = "access"; }
                    }
                    if root.active-section == "access": Rectangle {
                        x: 0; width: 3px;
                        y: (parent.height - 16px) / 2; height: 16px;
                        background: RedesignTheme.t.rep-500;
                        border-radius: 2px;
                    }
                    Text {
                        text: "访问权限";
                        font-size: RedesignTheme.t.fs-body;
                        font-weight: root.active-section == "access" ? 500 : 400;
                        color: RedesignTheme.t.fg;
                        x: RedesignTheme.t.s4;
                        vertical-alignment: center;
                    }
                }

                // spacer pushes the close button to the bottom
                Rectangle { vertical-stretch: 1; }

                close-button := Rectangle {
                    height: 40px;
                    background: close-ta.has-hover ? RedesignTheme.t.border-soft : transparent;
                    border-radius: RedesignTheme.t.r-sm;
                    animate background { duration: 200ms; easing: ease-in-out; }
                    close-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.close-settings(); }
                    }
                    Text {
                        text: AppStrings.close;
                        font-size: RedesignTheme.t.fs-body;
                        color: RedesignTheme.t.fg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ===== Right detail panel (placeholder; sub-panels in Phase 3) =====
        // FR-T4-6a: 设置页淡雾--底色平铺 air-rep-settings（1.5% rep）+ 顶晕
        // halo-rep-settings（亮 2% / 暗 5%）径向，写法仿 AirTint。设置页在
        // archive（abyss 冷雾）/ main（rep 3.5%/7% 暖雾）之外的视觉分档。
        Rectangle {
            width: parent.width - 240px;
            height: parent.height;
            background: RedesignTheme.t.air-rep-settings;
            animate background { duration: 300ms; easing: ease-in-out; }

            // 顶晕径向 — 原型规格: ellipse 160% 120% at 50% 4%, rep-500 @ 2%
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height * 0.5;
                background: @radial-gradient(circle at parent.width / 2 parent.height * 0.04, RedesignTheme.t.rep-500.with-alpha(0.02) 0%, transparent 60%);
                animate background { duration: 300ms; easing: ease-in-out; }
            }

            VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding-left: 32px;
                padding-right: 40px;
                padding-top: RedesignTheme.t.s5;
                padding-bottom: RedesignTheme.t.s5;
                animate opacity { duration: 200ms; }

                // Sub-panel switcher (Phase 3). WorkplacesSettingsPanel is Phase 4.
                if root.active-section == "providers": ProviderSettingsPanel {
                    width: parent.width;
                    height: parent.height;
                    providers: root.providers;
                    default-model-provider-id: root.default-model-provider-id;
                    legacy-placeholder-count: root.legacy-placeholder-count;
                    provider-test-result: root.provider-test-result;
                    provider-test-in-flight: root.provider-test-in-flight;
                    upsert-provider(n, t, b, k, m, e, en) => { root.upsert-provider(n, t, b, k, m, e, en); }
                    delete-provider(id) => { root.delete-provider(id); }
                    test-provider(id) => { root.test-provider(id); }
                    set-default-model(id) => { root.set-default-model(id); }
                    cleanup-legacy-placeholders => { root.cleanup-legacy-placeholders(); }
                }
                if root.active-section == "skills": SkillsSettingsPanel {
                    width: parent.width;
                    height: parent.height;
                    skills: root.skills;
                    workspace-override-supported: root.workspace-override-supported;
                    set-skill-global(id, en) => { root.set-skill-global(id, en); }
                    set-skill-workspace(id, ov) => { root.set-skill-workspace(id, ov); }
                }
                if root.active-section == "mcp": MCPSettingsPanel {
                    width: parent.width;
                    height: parent.height;
                    mcp-servers: root.mcp-servers;
                    upsert-mcp(id, name, transport, command, args, url, env, enabled) => { root.upsert-mcp(id, name, transport, command, args, url, env, enabled); }
                    delete-mcp(id) => { root.delete-mcp(id); }
                    test-mcp(id) => { root.test-mcp(id); }
                }
                if root.active-section == "workspaces": WorkspaceSettingsPanel {
                    width: parent.width;
                    height: parent.height;
                    workspaces: root.workspaces;
                    current-workspace-index: root.current-workspace-index;
                    pick-folder => { root.pick-folder(); }
                    add-workspace(path, name, set-current) => { root.add-workspace(path, name, set-current); }
                    switch-workspace(id) => { root.switch-workspace(id); }
                    remove-workspace(id) => { root.remove-workspace(id); }
                    edit-identity-md(id) => { root.edit-identity-md(id); }
                    open-identity-creator => { root.open-identity-creator(); }
                }
                if root.active-section == "general": GeneralSettingsPanel {
                    width: parent.width;
                    height: parent.height;
                    dark-mode: root.dark-mode;
                    toggle-theme => {
                        // 主题所有权收归 AppWindow：只透传，由 main.slint 经
                        // root.toggle-theme() 统一翻转 dark-mode 驱动 token。
                        root.toggle-theme();
                    }
                    edit-identity => { root.edit-identity(); }
                }
                if root.active-section == "access": AccessSettingsPanel {
                    width: parent.width;
                    height: parent.height;
                }
            }
        }
    }
}

// Spec §6.5 C-iv: empty states get a centered card. Slint 1.16 doesn't
// support top-level `func` declarations in .slint files (only inside
// components), so the section-title is rendered inline below using
// a property-init block instead of a helper.