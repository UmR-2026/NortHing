                    Rectangle {
                        width: 444px; height: 28px;
                        border-width: 1px;
                        border-color: search-input.has-focus
                            ? RedesignTheme.t.mind-drive-accent
                            : RedesignTheme.t.border;
                        background: RedesignTheme.t.bg;
                        animate border-color { duration: 150ms; }
                        search-input := TextInput {
                            text <=> root.skill-filter;
                            edited => { root.set-skill-filter(root.skill-filter); }
                            font-family: "JetBrains Mono";
                            font-size: 11px;
                            color: RedesignTheme.t.fg;
                            x: 8px; y: 0;
                            width: parent.width - 16px; height: parent.height;
                            vertical-alignment: center;
                        }
                        if root.skill-filter == "" : Text {
                            text: AppStrings.set-skills-search-placeholder;
                            font-family: "JetBrains Mono"; font-size: 11px;
                            color: RedesignTheme.t.faint;
                            x: 8px; y: 0;
                            width: parent.width - 16px; height: parent.height;
                            vertical-alignment: center;
                        }
                    }

                    // 子类分区（序 = §10.1）。`visible` 绑 `cat-*`：
