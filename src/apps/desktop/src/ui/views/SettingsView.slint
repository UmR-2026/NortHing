// SettingsView - T4 settings v2 — 三页浮层（接入点 / MCP / 技能）
//
// 形态：scrim（点击关闭）+ 居中 480px 宽 window-block 浮层（max 80vh、内 Flickable）。
// 块皮 = 1px line 边 + bevel 顶边（亮 1px 覆盖层）+ radius 4px + bg2 + lift drop-shadow。
// station-head「全局设置」mono 11px ls 0.08em muted + 右 × 关闭。head 下 tab 行三页：
// 接入点 / MCP / 技能（segments 语法：raised 底 + active elevated + mind-drive-accent）。
// 切页 = 内容替换，无动画或 ≤200ms opacity（取轻量；本页用即时替换）。
//
// 全屏页氛围全撤（brief §9.6 终稿）：aura / containment / membrane / room-fog 不在此做
// （它们属主视图，T1/T2 已有）；浮层不复制 WindowChrome。「它的自我」不渲染、不留占位
// （归 T6 space）；显示模式仅右上 ☀（WindowChrome 已有）；工作区 → T6。
//
// 模块内部复用（与已废弃的全屏页共用同一份数据契约）：
//   - Skills 分区（§3.3 / §10.1）：cat-* 可见性 + 子串过滤（Rust 侧 set-skill-filter）；
//     行只 sq-toggle + name；hover 右侧显种类。
//   - MCP 行（§3.3）：sq-toggle + name + intro 单行截断 + 验证态副文。
//   - providers 行（§3.2）：dot-radio ENGINE + sq-toggle PROVIDER + 测试/删除入口。
//
// 系统继承（T1/T2/T3 API，不重新发明）：RedesignTheme / AppStrings。
// 公共 API（main.slint 绑定）全部保留，见下方声明；本任务视觉层用不到的回调
// （如 upsert-mcp 表单类）保留声明即可，详情见 task-04-report.md「保留但未渲染」清单。
//
// 注：Slint Rectangle 仅有统一 border-width/border-color（无 per-edge），bevel 顶边
// 用 1px Rectangle 覆盖层（y=0）表达；letter-spacing 0.08em -> 1px（Slint 不支持 em）。
// 8s sin 呼吸沿用 T2 I3 范式：opacity: 0.725 + 0.275 * Math.sin(animation-tick()/8000ms*360deg)。

import { ProviderItem, SkillStateItem, MCPItem, WorkspaceItem } from "../theme.slint";
import { RedesignTheme } from "../redesign_palette.slint";
import { AppStrings } from "../strings.slint";

// ---------------------------------------------------------------------------
// 局部子组件（仅本视图复用）
// ---------------------------------------------------------------------------

// dot-radio：8px 圆（border-radius 4px 定值，brief §7 决策）。active 时实心 accent。
component dot-radio inherits Rectangle {
    in property <bool> active: false;
    in property <color> accent: RedesignTheme.t.mind-drive-accent;
    width: 8px; height: 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.active ? root.accent : RedesignTheme.t.muted;
    background: root.active ? root.accent : transparent;
}

// sq-toggle：8px 方形（近尖角语言）。active 时实心 ok 绿。
component sq-toggle inherits Rectangle {
    in property <bool> active: false;
    width: 8px; height: 8px;
    border-width: 1px;
    border-color: root.active ? #46A758 : RedesignTheme.t.muted;
    background: root.active ? #46A758 : transparent;
}

// window-block：浮层面板皮（§3.1）。
// 1px line 边 + bevel 顶边（亮 1px 覆盖层）+ radius 4px + bg2 + drop-shadow lift。
// bg2 = elevated（真值 light bg2=#FFFFFF ≡ elevated LIGHT；浮层需与 scrim 后页面拉开层级）。
// 内容由 VerticalLayout 承载（station-head + tab-row + body Flickable）。
component window-block inherits Rectangle {
    width: 100%;
    height: 100%;
    background: RedesignTheme.t.elevated;
    border-width: 1px;
    border-color: RedesignTheme.t.border;
    border-radius: 4px;
    drop-shadow-color: RedesignTheme.t.shadow;
    drop-shadow-blur: 12px;
    clip: true;

    VerticalLayout {
        spacing: 0px;
        width: parent.width;

        @children
    }

    // bevel 顶边（真值 --bevel：border-top-color；Slint 无 per-edge border，
    // 用 1px 覆盖层表达，ChatMessageBubble 同款范式 fg.with-alpha(0.06)）。
    // 声明在 VerticalLayout 之后，确保覆盖 station-head 的 raised 底。
    Rectangle {
        y: 1px; height: 1px; width: parent.width;
        background: RedesignTheme.t.fg.with-alpha(0.06);
    }
}

// tab-segment：tab 行单元格（§3.1）。raised 底 + active elevated + mind-drive-accent 下划线。
component tab-segment inherits Rectangle {
    in property <string> text: "";
    in property <bool> active: false;
    callback clicked();

    min-width: 56px;
    height: 36px;
    background: root.active ? RedesignTheme.t.elevated : RedesignTheme.t.raised;
    animate background { duration: 150ms; }

    TouchArea {
        width: parent.width; height: parent.height;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.text;
        font-family: "JetBrains Mono";
        font-size: 12px;
        color: root.active ? RedesignTheme.t.fg : RedesignTheme.t.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    // active 下划线（mind-drive-accent 1px，brief §7 字面量决策）
    if root.active : Rectangle {
        x: 0; y: parent.height - 1px;
        width: parent.width; height: 1px;
        background: RedesignTheme.t.mind-drive-accent;
    }
}

// row-button：小行内按钮（测试/删除，hover 时 mind 边框）。
component row-button inherits Rectangle {
    in property <string> text: "";
    callback clicked();

    width: 24px; height: 18px;
    border-width: 1px;
    border-color: rb-ta.has-hover
        ? RedesignTheme.t.mind-drive-accent
        : RedesignTheme.t.border;
    border-radius: 3px;
    background: rb-ta.has-hover ? RedesignTheme.t.raised : transparent;
    animate border-color { duration: 150ms; }
    animate background { duration: 150ms; }

    rb-ta := TouchArea {
        width: parent.width; height: parent.height;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.text;
        font-family: "JetBrains Mono"; font-size: 9px;
        color: rb-ta.has-hover ? RedesignTheme.t.mind-drive-line : RedesignTheme.t.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
        animate color { duration: 150ms; }
    }
}

// ---------------------------------------------------------------------------
// SettingsView 主体
// ---------------------------------------------------------------------------

export component SettingsView inherits Rectangle {
    // === 公共 API 保留清单（main.slint 绑定，重写不得破坏）===
    in-out property <string> active-section: "providers";
    in-out property <bool> dark-mode: RedesignTheme.dark;
    in property <[ProviderItem]> providers: [];
    in property <[SkillStateItem]> skills: [];
    in property <[MCPItem]> mcp-servers: [];
    in property <[WorkspaceItem]> workspaces: [];
    in property <bool> workspace-override-supported: false;
    in property <int> current-workspace-index: -1;
    in property <string> default-model-provider-id: "";
    in property <int> legacy-placeholder-count: 0;
    in property <string> provider-test-result: "";
    in property <bool> provider-test-in-flight: false;

    // T4 (2026-08-05) §3.3 / §10.1: 9 partition visibility
    // booleans forwarded from Rust. Each partition's `visible`
    // binding is the ONLY gate that decides whether the title
    // + container render. When false, the partition takes no
    // layout space at all (no empty title bar, no 0-height
    // placeholder). Order matches brief §10.1
    // (引擎/玩法/设计/工程/office/meta/computer-use/gstack/其他).
    in property <bool> cat-engine: false;
    in property <bool> cat-gameplay: false;
    in property <bool> cat-design: false;
    in property <bool> cat-engineering: false;
    in property <bool> cat-office: false;
    in property <bool> cat-meta: false;
    in property <bool> cat-computer-use: false;
    in property <bool> cat-gstack: false;
    in property <bool> cat-other: false;

    // T4 (2026-08-05): per-partition row models pushed by Rust
    // (apply_skill_filter). for 体不能条件、visible 行占高，行级过滤在 Rust 侧。
    in property <[SkillStateItem]> rows-engine: [];
    in property <[SkillStateItem]> rows-gameplay: [];
    in property <[SkillStateItem]> rows-design: [];
    in property <[SkillStateItem]> rows-engineering: [];
    in property <[SkillStateItem]> rows-office: [];
    in property <[SkillStateItem]> rows-meta: [];
    in property <[SkillStateItem]> rows-computer-use: [];
    in property <[SkillStateItem]> rows-gstack: [];
    in property <[SkillStateItem]> rows-other: [];

    // callbacks（全部保留；视觉层用不到的也保留声明以便 main.slint 绑定）
    callback close-settings();
    callback toggle-theme();
    callback edit-identity();
    callback upsert-provider(string, string, string, string, string, string, bool);
    callback delete-provider(string);
    callback test-provider(string);
    callback set-default-model(string);
    callback cleanup-legacy-placeholders();
    callback set-skill-global(string, bool);
    callback set-skill-workspace(string, string);
    callback upsert-mcp(string, string, string, string, string, string, string, bool);
    callback delete-mcp(string);
    callback test-mcp(string);
    callback pick-folder();
    callback add-workspace(string, string, bool);
    callback switch-workspace(string);
    callback remove-workspace(string);
    callback edit-identity-md(string);
    callback open-identity-creator();

    // T4 (2026-08-05) §3.3: forward the search-input text to
    // Rust. Rust (`app_state::callbacks_settings::skill_filter`)
    // re-applies a case-insensitive substring match on `name`
    // or `description` and re-publishes `skills` (the same
    // `skills-list` model on `AppWindow`) + the 9 cat-*
    // booleans. The drawer (Inspector) model is unaffected.
    callback set-skill-filter(string);

    // === T4 浮层内部状态 ===
    // 当前 tab：providers / mcp / skills（与全屏旧 active-section 语义不同）。
    in-out property <string> overlay-tab: "providers";
    // MCP 添加表单展开态
    in-out property <bool> mcp-form-open: false;
    // 添加表单字段（仅 UI 缓冲；提交走 upsert-mcp）
    in-out property <string> mcp-form-name: "";
    in-out property <string> mcp-form-transport: "stdio";
    in-out property <string> mcp-form-command: "";
    in-out property <string> mcp-form-args: "";
    in-out property <string> mcp-form-url: "";
    in-out property <string> mcp-form-env: "";
    in-out property <bool> mcp-form-enabled: true;
    // Skills 搜索框文本：仅作为 UI 的输入缓冲（text 变化时转给
    // `set-skill-filter` 回调）。真正的过滤在 Rust 侧做。
    in-out property <string> skill-filter: "";

    background: transparent;

    // ===== 1. scrim（AirTint 现范式：深 0.5 alpha，点击关闭）=====
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: RedesignTheme.t.scrim.with_alpha(0.5);
        scrim-ta := TouchArea {
            width: parent.width; height: parent.height;
            clicked => { root.close-settings(); }
        }
    }

    // ===== 2. 居中浮层（480px 宽，高随内容，max 80vh；brief §3.1）=====
    // chrome = station-head 32 + tab 行 36 + 分隔线 1 = 69px；
    // body 上限 = 80vh - chrome，超出走 Flickable 滚动。
    panel := Rectangle {
        x: (parent.width - 480px) / 2;
        y: (parent.height - self.height) / 2;
        width: 480px;
        height: 69px + body-flick.height;

        window-block {
            // station-head：32px 高 + 8s sin 呼吸状态点（视觉提示路由在场）
            Rectangle {
                width: parent.width;
                height: 32px;
                background: RedesignTheme.t.raised;
                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-left: 16px;
                    padding-right: 8px;
                    spacing: 8px;

                    Text {
                        text: AppStrings.settings-v2-status;
                        font-family: "JetBrains Mono";
                        font-size: 11px;
                        color: RedesignTheme.t.muted;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 18px; height: 18px;
                        close-ta := TouchArea {
                            width: parent.width; height: parent.height;
                            clicked => { root.close-settings(); }
                        }
                        Text {
                            text: "×";
                            font-family: "JetBrains Mono"; font-size: 14px;
                            color: close-ta.has-hover ? RedesignTheme.t.mind-drive-line : RedesignTheme.t.muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                            animate color { duration: 150ms; }
                        }
                    }
                }
                // station-head 底边线
                Rectangle {
                    x: 0; y: parent.height - 1px;
                    width: parent.width; height: 1px;
                    background: RedesignTheme.t.border;
                }
            }

            // tab-row：3 segments（接入点 / MCP / 技能），raised 底 + active elevated
            Rectangle {
                width: parent.width;
                height: 36px;
                background: RedesignTheme.t.raised;
            HorizontalLayout {
                height: 36px;
                spacing: 0px;
                tab-providers := tab-segment {
                    text: AppStrings.overlay-tab-providers;
                    active: root.overlay-tab == "providers";
                    clicked => { root.overlay-tab = "providers"; }
                }
                tab-mcp := tab-segment {
                    text: AppStrings.overlay-tab-mcp;
                    active: root.overlay-tab == "mcp";
                    clicked => { root.overlay-tab = "mcp"; }
                }
                tab-skills := tab-segment {
                    text: AppStrings.overlay-tab-skills;
                    active: root.overlay-tab == "skills";
                    clicked => { root.overlay-tab = "skills"; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            }
            // tab-row 底边线
            Rectangle {
                width: parent.width; height: 1px;
                background: RedesignTheme.t.border;
            }

            // ===== 3. Flickable body（高随内容，上限 80vh - chrome）=====
            // 高度取 body-layout.preferred-height（布局自底向上计算，
            // 不依赖 viewport 实际高度，避免 binding loop）。
            body-flick := Flickable {
                width: parent.width;
                height: Math.min(body-layout.preferred-height, root.height * 0.8 - 69px);
                interactive: true;

                body-layout := VerticalLayout {
                    width: parent.width;

                // ----- 第一页 接入点 -----
                if root.overlay-tab == "providers" : VerticalLayout {
                    width: parent.width;
                    padding-top: 16px;
                    padding-bottom: 16px;
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 20px;

                    // -- 模型引擎 ENGINE（dot-radio 列表）--
                    // 444px = 480 浮层宽 - 2×18 页边距（定值，避免 stretch 歧义）
                    Rectangle {
                        width: 444px;
                        // station-section-head
                        height: 22px;
                        background: transparent;
                        Text {
                            text: AppStrings.set-engine-title;
                            font-family: "JetBrains Mono"; font-size: 10px;
                            color: RedesignTheme.t.faint;
                            letter-spacing: 1px;
                            width: 444px;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        width: 444px;
                        spacing: 4px;

                        for p[i] in root.providers : Rectangle {
                            horizontal-stretch: 1; height: 22px;
                            background: engine-ta.has-hover ? RedesignTheme.t.raised : transparent;
                            animate background { duration: 150ms; }
                            engine-ta := TouchArea {
                                width: parent.width; height: parent.height;
                                clicked => { root.set-default-model(p.id); }
                            }
                            HorizontalLayout {
                                x: 0; y: 0;
                                width: parent.width; height: parent.height;
                                padding-right: 4px;
                                spacing: 8px;
                                dot-radio {
                                    active: p.id == root.default-model-provider-id;
                                    accent: RedesignTheme.t.mind-drive-accent;
                                    y: (parent.height - 8px) / 2;
                                }
                                Text {
                                    text: p.model != "" ? p.model : p.name;
                                    font-size: 12px;
                                    color: p.id == root.default-model-provider-id
                                        ? RedesignTheme.t.fg : RedesignTheme.t.muted;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    min-width: 0;
                                    horizontal-stretch: 1;
                                }
                                Rectangle { horizontal-stretch: 0; }
                                if p.id == root.default-model-provider-id : Text {
                                    text: AppStrings.set-engine-current-tag;
                                    font-family: "JetBrains Mono"; font-size: 10px;
                                    color: RedesignTheme.t.mind-drive-line;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if root.providers.length == 0 : Text {
                            text: AppStrings.provider-empty;
                            font-size: 11px; color: RedesignTheme.t.faint;
                        }
                    }

                    // -- 接入点 PROVIDER（sq-toggle 列表 + 测试/删除）--
                    Rectangle {
                        width: 444px; height: 22px;
                        Text {
                            text: AppStrings.set-provider-title;
                            font-family: "JetBrains Mono"; font-size: 10px;
                            color: RedesignTheme.t.faint;
                            letter-spacing: 1px;
                            width: 444px;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        width: 444px; spacing: 4px;

                        for p[i] in root.providers : Rectangle {
                            horizontal-stretch: 1; height: 22px;
                            background: p-ta.has-hover ? RedesignTheme.t.raised : transparent;
                            animate background { duration: 150ms; }
                            p-ta := TouchArea {
                                width: parent.width; height: parent.height;
                                clicked => {
                                    root.upsert-provider(p.id, p.name, p.type,
                                        p.base-url, "", p.model, !p.enabled);
                                }
                            }
                            HorizontalLayout {
                                x: 0; y: 0;
                                width: parent.width; height: parent.height;
                                spacing: 8px;
                                sq-toggle { active: p.enabled; y: (parent.height - 8px) / 2; }
                                Text {
                                    text: p.name;
                                    font-size: 12px;
                                    color: p.enabled ? RedesignTheme.t.fg : RedesignTheme.t.muted;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    min-width: 0;
                                    horizontal-stretch: 1;
                                }
                                // 副文（mono 10px muted）+ 测试/删除入口（brief §3.2）。
                                Text {
                                    text: AppStrings.set-provider-direct;
                                    font-family: "JetBrains Mono"; font-size: 10px;
                                    color: p.enabled ? RedesignTheme.t.muted : RedesignTheme.t.faint;
                                    vertical-alignment: center;
                                }
                                row-button {
                                    text: AppStrings.set-provider-test;
                                    clicked => { root.test-provider(p.id); }
                                }
                                row-button {
                                    text: AppStrings.set-provider-delete;
                                    clicked => { root.delete-provider(p.id); }
                                }
                            }
                        }
                        if root.providers.length == 0 : Text {
                            text: AppStrings.provider-empty;
                            font-size: 11px; color: RedesignTheme.t.faint;
                        }
                    }
                }

                // ----- 第二页 MCP -----
                if root.overlay-tab == "mcp" : VerticalLayout {
                    width: parent.width;
                    padding-top: 16px;
                    padding-bottom: 16px;
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 12px;

                    // -- MCP 服务器列表（sq-toggle + name + intro）--
                    for m[i] in root.mcp-servers : Rectangle {
                        horizontal-stretch: 1; height: 22px;
                        background: mcp-ta.has-hover ? RedesignTheme.t.raised : transparent;
                        animate background { duration: 150ms; }
                        mcp-ta := TouchArea {
                            width: parent.width; height: parent.height;
                            clicked => {
                                root.upsert-mcp(m.id, m.name, m.transport,
                                    "", "", "", "", !m.enabled);
                            }
                        }
                        HorizontalLayout {
                            x: 0; y: 0;
                            width: parent.width; height: parent.height;
                            spacing: 8px;
                            // verified 当前数据流恒为 ""（refresh.rs：连接态探针
                            // N+1 RPC 被 K4a-T4 推迟），toggle 只反映 enabled。
                            sq-toggle {
                                active: m.enabled;
                                y: (parent.height - 8px) / 2;
                            }
                            Text {
                                text: m.name;
                                font-size: 12px;
                                color: m.enabled ? RedesignTheme.t.fg : RedesignTheme.t.muted;
                                vertical-alignment: center;
                                overflow: elide;
                                min-width: 0;
                                horizontal-stretch: 1;
                            }
                            // 简介一行（§10.2 fallback：faint mono 10px 单行截断）；
                            // 连接态 fail 时以 danger 副文取代简介。
                            Text {
                                text: m.verified == "fail"
                                    ? AppStrings.set-mcp-unauth
                                    : m.intro;
                                font-family: "JetBrains Mono"; font-size: 10px;
                                color: m.verified == "fail"
                                    ? RedesignTheme.t.danger : RedesignTheme.t.faint;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-alignment: right;
                                max-width: 220px;
                            }
                        }
                    }
                    if root.mcp-servers.length == 0 : Text {
                        text: AppStrings.mcp-empty;
                        font-size: 11px; color: RedesignTheme.t.faint;
                    }

                    // -- 添加服务器按钮（toggle form）--
                    Rectangle {
                        width: 444px; height: 28px;
                        border-width: 1px;
                        border-color: add-ta.has-hover
                            ? RedesignTheme.t.mind-drive-accent
                            : RedesignTheme.t.border;
                        border-radius: 3px;
                        background: add-ta.has-hover ? RedesignTheme.t.raised : transparent;
                        animate border-color { duration: 150ms; }
                        animate background { duration: 150ms; }
                        add-ta := TouchArea {
                            width: parent.width; height: parent.height;
                            clicked => { root.mcp-form-open = !root.mcp-form-open; }
                        }
                        Text {
                            text: root.mcp-form-open
                                ? AppStrings.overlay-mcp-form-collapse
                                : AppStrings.overlay-mcp-add;
                            font-family: "JetBrains Mono"; font-size: 11px;
                            color: add-ta.has-hover
                                ? RedesignTheme.t.mind-drive-line : RedesignTheme.t.muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                            animate color { duration: 150ms; }
                        }
                    }

                    // -- 添加表单（展开态；1px line 边、内 padding）--
                    if root.mcp-form-open : Rectangle {
                        width: 444px;
                        border-width: 1px;
                        border-color: RedesignTheme.t.border;
                        border-radius: 3px;
                        background: RedesignTheme.t.elevated;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            width: parent.width;

                            // name
                            Text { text: AppStrings.overlay-mcp-form-name;
                                font-family: "JetBrains Mono"; font-size: 9px;
                                color: RedesignTheme.t.faint; letter-spacing: 1px;
                                horizontal-alignment: left; width: 420px; }
                            Rectangle {
                                width: 420px; height: 24px;
                                border-width: 1px;
                                border-color: RedesignTheme.t.border;
                                background: RedesignTheme.t.bg;
                                name-input := TextInput {
                                    text <=> root.mcp-form-name;
                                    font-family: "JetBrains Mono"; font-size: 11px;
                                    color: RedesignTheme.t.fg;
                                    x: 6px; y: 0;
                                    width: parent.width - 12px; height: parent.height;
                                    vertical-alignment: center;
                                }
                            }

                            // transport segments（stdio / sse / streamable-http）
                            HorizontalLayout {
                                width: 420px; height: 24px; spacing: 0px;
                                t-stdio := tab-segment {
                                    text: AppStrings.overlay-mcp-transport-stdio;
                                    active: root.mcp-form-transport == "stdio";
                                    clicked => { root.mcp-form-transport = "stdio"; }
                                }
                                t-sse := tab-segment {
                                    text: AppStrings.overlay-mcp-transport-sse;
                                    active: root.mcp-form-transport == "sse";
                                    clicked => { root.mcp-form-transport = "sse"; }
                                }
                                t-sh := tab-segment {
                                    text: AppStrings.overlay-mcp-transport-sh;
                                    active: root.mcp-form-transport == "streamable-http";
                                    clicked => { root.mcp-form-transport = "streamable-http"; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }

                            // command / args / url / env（简化版：单行 mono input）
                            Text { text: AppStrings.overlay-mcp-form-command;
                                font-family: "JetBrains Mono"; font-size: 9px;
                                color: RedesignTheme.t.faint; letter-spacing: 1px;
                                horizontal-alignment: left; width: 420px; }
                            Rectangle {
                                width: 420px; height: 24px;
                                border-width: 1px;
                                border-color: RedesignTheme.t.border;
                                background: RedesignTheme.t.bg;
                                cmd-input := TextInput {
                                    text <=> root.mcp-form-command;
                                    font-family: "JetBrains Mono"; font-size: 11px;
                                    color: RedesignTheme.t.fg;
                                    x: 6px; y: 0;
                                    width: parent.width - 12px; height: parent.height;
                                    vertical-alignment: center;
                                }
                            }
                            Text { text: AppStrings.overlay-mcp-form-args;
                                font-family: "JetBrains Mono"; font-size: 9px;
                                color: RedesignTheme.t.faint; letter-spacing: 1px;
                                horizontal-alignment: left; width: 420px; }
                            Rectangle {
                                width: 420px; height: 24px;
                                border-width: 1px;
                                border-color: RedesignTheme.t.border;
                                background: RedesignTheme.t.bg;
                                args-input := TextInput {
                                    text <=> root.mcp-form-args;
                                    font-family: "JetBrains Mono"; font-size: 11px;
                                    color: RedesignTheme.t.fg;
                                    x: 6px; y: 0;
                                    width: parent.width - 12px; height: parent.height;
                                    vertical-alignment: center;
                                }
                            }
                            Text { text: AppStrings.overlay-mcp-form-url;
                                font-family: "JetBrains Mono"; font-size: 9px;
                                color: RedesignTheme.t.faint; letter-spacing: 1px;
                                horizontal-alignment: left; width: 420px; }
                            Rectangle {
                                width: 420px; height: 24px;
                                border-width: 1px;
                                border-color: RedesignTheme.t.border;
                                background: RedesignTheme.t.bg;
                                url-input := TextInput {
                                    text <=> root.mcp-form-url;
                                    font-family: "JetBrains Mono"; font-size: 11px;
                                    color: RedesignTheme.t.fg;
                                    x: 6px; y: 0;
                                    width: parent.width - 12px; height: parent.height;
                                    vertical-alignment: center;
                                }
                            }
                            Text { text: AppStrings.overlay-mcp-form-env;
                                font-family: "JetBrains Mono"; font-size: 9px;
                                color: RedesignTheme.t.faint; letter-spacing: 1px;
                                horizontal-alignment: left; width: 420px; }
                            Rectangle {
                                width: 420px; height: 24px;
                                border-width: 1px;
                                border-color: RedesignTheme.t.border;
                                background: RedesignTheme.t.bg;
                                env-input := TextInput {
                                    text <=> root.mcp-form-env;
                                    font-family: "JetBrains Mono"; font-size: 11px;
                                    color: RedesignTheme.t.fg;
                                    x: 6px; y: 0;
                                    width: parent.width - 12px; height: parent.height;
                                    vertical-alignment: center;
                                }
                            }

                            // enabled toggle（定值宽：stretch 在嵌套布局不可靠）
                            HorizontalLayout {
                                width: 420px; height: 22px; spacing: 8px;
                                sq-toggle {
                                    active: root.mcp-form-enabled;
                                    y: (parent.height - 8px) / 2;
                                }
                                Text {
                                    text: AppStrings.overlay-mcp-form-enabled;
                                    font-size: 12px; color: RedesignTheme.t.fg;
                                    vertical-alignment: center;
                                }
                                enabled-ta := TouchArea {
                                    width: 340px; height: parent.height;
                                    clicked => { root.mcp-form-enabled = !root.mcp-form-enabled; }
                                }
                            }

                            // 提交按钮（312 + 8 + 100 = 420 定值）
                            HorizontalLayout {
                                width: 420px; height: 28px; spacing: 8px;
                                Rectangle {
                                    width: 312px; height: 28px;
                                    border-width: 1px;
                                    border-color: cancel-ta.has-hover
                                        ? RedesignTheme.t.muted
                                        : RedesignTheme.t.border;
                                    border-radius: 3px;
                                    background: cancel-ta.has-hover ? RedesignTheme.t.raised : transparent;
                                    animate border-color { duration: 150ms; }
                                    animate background { duration: 150ms; }
                                    cancel-ta := TouchArea {
                                        width: parent.width; height: parent.height;
                                        clicked => { root.mcp-form-open = false; }
                                    }
                                    Text {
                                        text: AppStrings.overlay-mcp-form-cancel;
                                        font-family: "JetBrains Mono"; font-size: 11px;
                                        color: cancel-ta.has-hover
                                            ? RedesignTheme.t.fg : RedesignTheme.t.muted;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width; height: parent.height;
                                        animate color { duration: 150ms; }
                                    }
                                }
                                Rectangle {
                                    width: 100px; height: 28px;
                                    border-width: 1px;
                                    border-color: submit-ta.has-hover
                                        ? RedesignTheme.t.mind-drive-accent
                                        : RedesignTheme.t.border;
                                    border-radius: 3px;
                                    background: submit-ta.has-hover ? RedesignTheme.t.raised : RedesignTheme.t.surface;
                                    animate border-color { duration: 150ms; }
                                    animate background { duration: 150ms; }
                                    submit-ta := TouchArea {
                                        width: parent.width; height: parent.height;
                                        clicked => {
                                            root.upsert-mcp("", root.mcp-form-name,
                                                root.mcp-form-transport, root.mcp-form-command,
                                                root.mcp-form-args, root.mcp-form-url,
                                                root.mcp-form-env, root.mcp-form-enabled);
                                            root.mcp-form-open = false;
                                        }
                                    }
                                    Text {
                                        text: AppStrings.overlay-mcp-form-save;
                                        font-family: "JetBrains Mono"; font-size: 11px;
                                        color: submit-ta.has-hover
                                            ? RedesignTheme.t.mind-drive-line : RedesignTheme.t.fg;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width; height: parent.height;
                                        animate color { duration: 150ms; }
                                    }
                                }
                            }
                        }
                    }
                }

                // ----- 第三页 技能 -----
                if root.overlay-tab == "skills" : VerticalLayout {
                    width: parent.width;
                    padding-top: 16px;
