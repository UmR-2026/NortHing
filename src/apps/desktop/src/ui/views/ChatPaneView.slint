import { MessageItem, ProviderItem } from "../theme.slint";
import { RedesignTheme } from "../redesign_palette.slint";
import { SystemConstants } from "../system_constants.slint";
import { AppStrings } from "../strings.slint";
import { RoomHead } from "../components/RoomHead.slint";
import { DeckBar } from "../components/DeckBar.slint";
import { DoorbellGem } from "../components/DoorbellGem.slint";

export component ChatPaneView inherits Rectangle {
    in property <[MessageItem]> messages: [];
    in-out property <string> input-text: "";
    in property <bool> dark-mode: true;
    in property <string> current-session-name: "";
    in property <string> current-session-model: "";
    in property <bool> current-session-broken: false;
    in property <string> inline-error: "";
    in property <string> workspace-name: "";
    in property <[ProviderItem]> providers: [];
    in property <string> default-model-provider-id: "";
    in-out property <bool> model-popup-open: false;
    in property <bool> is-streaming: false;
    in-out property <string> expanded-message-id: "";

    in-out property <bool> left-drawer-open: false;
    in-out property <bool> right-drawer-open: false;
    in-out property <bool> room-head-folded: false;
    callback toggle-room-head-fold();

    out property <bool> input-focused: deck.focused;

    callback send-message(string);
    callback load-more-messages();
    callback stop-streaming();
    callback export-markdown();
    callback open-session-settings();
    callback set-default-model(string);
    callback open-settings();

    // 真值 L221 + L485：左结 top = --gem-mid = 头像中心线（相对 room 顶），margin-top -32px。
    // RoomHead 已暴露 avatar-mid-y（折叠态 21px / 展开态 52px），此处真绑，不再硬编码。
    property <length> gem-mid-y: room-head.y + room-head.avatar-mid-y - 32px;

    // 左侧膜结
    Rectangle {
        x: 0px; width: 1px; height: parent.height;
        background: RedesignTheme.t.mind-drive-accent;
        opacity: 0.35 * Math.max(0, -Math.cos(animation-tick() / 8000ms * 360deg));
    }
    // 右侧膜结
    Rectangle {
        x: parent.width - 1px; width: 1px; height: parent.height;
        background: RedesignTheme.t.mind-drive-accent;
        opacity: 0.35 * Math.max(0, -Math.cos(animation-tick() / 8000ms * 360deg));
    }

    // 底雾 (room-fog) - 移入 room
    Rectangle {
        x: 0;
        y: parent.height - 140px;
        width: parent.width;
        height: 140px;
        background: @linear-gradient(0deg, RedesignTheme.t.bg 0%, transparent 100%);
        opacity: 0.55;
        animate opacity { duration: 300ms; easing: ease-in-out; }
    }

    VerticalLayout {
        spacing: 0px;

        HorizontalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            padding-left: 18px;
            padding-right: 18px;
            spacing: 16px;

            HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 8px;
                opacity: 0.7;

                Rectangle {
                    width: 15px;
                    height: 15px;

                    Path {
                        width: 100%;
                        height: 100%;
                        viewbox-width: 200;
                        viewbox-height: 200;
                        stroke: RedesignTheme.t.fg;
                        stroke-width: 2.5px;
                        commands: "M 112.68 72.84 A 30 30 0 1 1 87.32 72.84";
                    }
                    Path {
                        width: 100%;
                        height: 100%;
                        viewbox-width: 200;
                        viewbox-height: 200;
                        stroke: RedesignTheme.t.fg;
                        stroke-width: 5px;
                        commands: "M 126 54.97 A 52 52 0 1 1 82.28 51.22";
                    }
                    Path {
                        width: 100%;
                        height: 100%;
                        viewbox-width: 200;
                        viewbox-height: 200;
                        stroke: RedesignTheme.t.fg;
                        stroke-width: 9px;
                        commands: "M 132.13 31.13 A 76 76 0 1 1 56.35 37.47";
                    }
                    Path {
                        width: 100%;
                        height: 100%;
                        viewbox-width: 200;
                        viewbox-height: 200;
                        stroke: RedesignTheme.t.fg;
                        stroke-width: 8px;
                        commands: "M 56.35 37.47 Q 48 30, 44 24";
                    }
                    Path {
                        width: 100%;
                        height: 100%;
                        viewbox-width: 200;
                        viewbox-height: 200;
                        stroke: RedesignTheme.t.fg;
                        stroke-width: 8px;
                        commands: "M 132.13 31.13 Q 137 24, 139 19";
                    }
                }

                Text {
                    text: "northing";
                    font-family: "Fraunces";
                    font-italic: true;
                    font-size: 12px;
                    color: RedesignTheme.t.fg;
                    vertical-alignment: center;
                }
            }

            Text {
                text: AppStrings.room-status-identity;
                font-family: "JetBrains Mono";
                font-size: 10px;
                color: RedesignTheme.t.muted;
                letter-spacing: 1px;
                vertical-alignment: center;
            }

            Text {
                text: AppStrings.room-status-context;
                font-family: "JetBrains Mono";
                font-size: 10px;
                color: RedesignTheme.t.faint;
                letter-spacing: 1px;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            Rectangle {
                width: 6px; height: 6px; border-radius: 3px;
                background: RedesignTheme.t.rep-500;
                opacity: 0.725 + 0.275 * Math.sin(animation-tick() / 8000ms * 360deg);
            }
        }

        room-head := RoomHead {
            folded <=> root.room-head-folded;
            dark-mode: root.dark-mode;
            toggle-fold => { root.toggle-room-head-fold(); }
        }

        Rectangle {
            vertical-stretch: 1;
            width: parent.width;

            chat-flow := Flickable {
                width: parent.width;
                height: parent.height;

                VerticalLayout {
                    padding: 22px;
                    spacing: 22px;

                    HorizontalLayout {
                        spacing: 12px;
                        // A-4: 移除 alignment: center
                        
                        Rectangle { height: 1px; horizontal-stretch: 1; background: RedesignTheme.t.border; y: 4px; }
                        Text {
                            text: AppStrings.chat-mock-session-banner;
                            font-family: "JetBrains Mono";
                            font-size: 10px;
                            letter-spacing: 1px;
                            color: RedesignTheme.t.faint;
                        }
                        Rectangle { height: 1px; horizontal-stretch: 1; background: RedesignTheme.t.border; y: 4px; }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: AppStrings.chat-mock-agent-who; font-family: "JetBrains Mono"; font-size: 10px; color: RedesignTheme.t.mind-drive-line; }
                        Rectangle {
                            background: RedesignTheme.t.elevated;
                            border-width: 1px; border-color: RedesignTheme.t.border; border-radius: 4px;
                            drop-shadow-color: RedesignTheme.t.shadow; drop-shadow-blur: 4px;

                            Rectangle {
                                x: 1px; y: 0px;
                                width: parent.width - 2px;
                                height: 1px;
                                background: RedesignTheme.t.mind-drive-frame;
                            }

                            VerticalLayout {
                                padding-top: 12px; padding-bottom: 12px;
                                padding-left: 14px; padding-right: 14px;
                                spacing: 8px;

                                Text {
                                    text: AppStrings.chat-mock-agent-body;
                                    font-family: "Fraunces"; font-size: 16px; color: RedesignTheme.t.fg; wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    Rectangle {
                                        border-width: 0px;
                                        width: tlog-text.width + 10px + (tlog-ta.has-hover ? 5px : 0px);
                                        animate width { duration: 150ms; }

                                        Rectangle {
                                            width: 2px; height: parent.height; x: 0px; background: RedesignTheme.t.rep-500;
                                        }

                                        tlog-text := Text {
                                            text: AppStrings.chat-mock-tool-log; font-family: "JetBrains Mono"; font-size: 10px; color: RedesignTheme.t.mind-drive-line;
                                            x: tlog-ta.has-hover ? 13px : 8px;
                                            vertical-alignment: center;
                                            animate x { duration: 150ms; }
                                        }

                                        tlog-ta := TouchArea {}
                                    }

                                    // A-6: 限制 width 以形成 inline pill
                                    Rectangle {
                                        
                                        border-width: 1px; border-radius: 3px;
                                        border-color: chip-ta.has-hover ? RedesignTheme.t.rep-500 : RedesignTheme.t.border;
                                        background: RedesignTheme.t.bg;

                                        HorizontalLayout {
                                            padding-left: 9px; padding-right: 9px; padding-top: 3px; padding-bottom: 3px;
                                            chip-text := Text {
                                                text: AppStrings.chat-mock-artifact-chip; font-family: "JetBrains Mono"; font-size: 10px;
                                                color: chip-ta.has-hover ? RedesignTheme.t.mind-drive-line : RedesignTheme.t.muted;
                                            }
                                        }
                                        chip-ta := TouchArea {}
                                    }
                                    
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 10px;
                        VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: AppStrings.chat-mock-witness-who;
                                font-family: "JetBrains Mono"; font-size: 10px; letter-spacing: 0.8px;
                                color: RedesignTheme.t.faint;
                            }
                            Text {
                                text: AppStrings.chat-mock-witness-body;
                                font-family: "Fraunces"; font-size: 15px; color: RedesignTheme.t.muted; wrap: word-wrap;
                            }
                        }
                        // V1：witness 右缘 2px 中性线（裁决：不染 rep）
                        Rectangle { width: 2px; background: RedesignTheme.t.border; }
                    }
                    
                    // A-5: 第三条 agent 消息
                    VerticalLayout {
                        spacing: 8px; alignment: start;
                        Text { text: AppStrings.chat-mock-agent-who; font-family: "JetBrains Mono"; font-size: 10px; color: RedesignTheme.t.mind-drive-line; }
                        Rectangle {
                            background: RedesignTheme.t.elevated;
                            border-width: 1px; border-color: RedesignTheme.t.border; border-radius: 4px;
                            drop-shadow-color: RedesignTheme.t.shadow; drop-shadow-blur: 4px;
                            Rectangle { x: 1px; y: 0px; width: parent.width - 2px; height: 1px; background: RedesignTheme.t.mind-drive-frame; }
                            VerticalLayout {
                                padding-top: 12px; padding-bottom: 12px; padding-left: 14px; padding-right: 14px; spacing: 8px;
                                Text { text: AppStrings.chat-mock-agent-body; font-family: "Fraunces"; font-size: 16px; color: RedesignTheme.t.fg; wrap: word-wrap; }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 8px; alignment: start;
                        HorizontalLayout {
                            // A-5: 移除 alignment: center
                            Rectangle {
                                // A-5: 移除 width: 560px
                                border-width: 1px; border-color: RedesignTheme.t.mind-gaze-accent; border-radius: 4px;
                                background: RedesignTheme.t.elevated; drop-shadow-color: RedesignTheme.t.shadow; drop-shadow-blur: 4px;

                                HorizontalLayout {
                                    padding-top: 12px; padding-bottom: 12px; padding-left: 14px; padding-right: 14px;
                                    spacing: 14px; alignment: center;

                                    VerticalLayout {
                                        spacing: 6px; horizontal-stretch: 1;
                                        Text { text: AppStrings.chat-mock-approval-head; font-family: "JetBrains Mono"; font-size: 10px; color: RedesignTheme.t.mind-gaze-accent; letter-spacing: 0.8px; }
                                        Text { text: AppStrings.chat-mock-approval-main; font-size: 12px; color: RedesignTheme.t.fg; }
                                        Text { text: AppStrings.chat-mock-approval-risk; font-family: "JetBrains Mono"; font-size: 10px; color: RedesignTheme.t.muted; }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px; alignment: center;
                                        Rectangle {
                                            border-width: 1px; border-radius: 3px;
                                            border-color: RedesignTheme.t.mind-drive-accent;
                                            background: approve-ta.has-hover ? RedesignTheme.t.mind-drive-accent : RedesignTheme.t.mind-drive-intense;
                                            animate background { duration: 150ms; }
                                            HorizontalLayout {
                                                padding-left: 12px; padding-right: 12px; padding-top: 6px; padding-bottom: 6px;
                                                Text { text: AppStrings.chat-mock-approval-approve; font-size: 10px; color: approve-ta.has-hover ? RedesignTheme.t.bg : RedesignTheme.t.fg; }
                                            }
                                            approve-ta := TouchArea {}
                                        }
                                        Rectangle {
                                            border-width: 1px; border-radius: 3px;
                                            border-color: RedesignTheme.t.danger;
                                            background: reject-ta.has-hover ? RedesignTheme.t.danger : transparent;
                                            animate background { duration: 150ms; }
                                            HorizontalLayout {
                                                padding-left: 12px; padding-right: 12px; padding-top: 6px; padding-bottom: 6px;
                                                Text { text: AppStrings.chat-mock-approval-reject; font-size: 10px; color: reject-ta.has-hover ? #ffffff : RedesignTheme.t.danger; }
                                            }
                                            reject-ta := TouchArea {}
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // A-5: 第二张 resolved 卡
                    VerticalLayout {
                        spacing: 8px; alignment: start;
                        HorizontalLayout {
                            Rectangle {
                                border-width: 1px; border-color: RedesignTheme.t.border; border-radius: 4px;
                                background: RedesignTheme.t.elevated; drop-shadow-color: RedesignTheme.t.shadow; drop-shadow-blur: 4px;
                                opacity: 0.9;
                                HorizontalLayout {
                                    padding-top: 12px; padding-bottom: 12px; padding-left: 14px; padding-right: 14px; spacing: 14px; alignment: center;
                                    VerticalLayout {
                                        spacing: 6px; horizontal-stretch: 1;
                                        // 真值 L421-423：resolved 卡自带带时戳的 head 与不同的 cmd，非复用 pending 卡文案。
                                        Text { text: AppStrings.chat-mock-approval-head-2; font-family: "JetBrains Mono"; font-size: 10px; color: RedesignTheme.t.mind-gaze-accent; letter-spacing: 0.8px; }
                                        Text { text: AppStrings.chat-mock-approval-main-2; font-size: 12px; color: RedesignTheme.t.fg; }
                                        Text { text: AppStrings.chat-mock-approval-risk; font-family: "JetBrains Mono"; font-size: 10px; color: RedesignTheme.t.muted; }
                                    }
                                    // 真值 L425 .approval-state：结果陈述，与「拒绝」按钮文案不同源。
                                    Text {
                                        text: AppStrings.chat-mock-approval-state;
                                        font-family: "JetBrains Mono"; font-size: 12px; font-weight: 700; letter-spacing: 0.8px; color: RedesignTheme.t.danger;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // A-7: 细滚动条
            if (chat-flow.viewport-height > chat-flow.height): Rectangle {
                width: 5px;
                height: max(20px, chat-flow.height * (chat-flow.height / chat-flow.viewport-height));
                x: parent.width - 5px;
                y: (-chat-flow.viewport-y / (chat-flow.viewport-height - chat-flow.height)) * (chat-flow.height - self.height);
                background: RedesignTheme.t.border;
                border-radius: 3px;
            }
        }

        deck := DeckBar {
            text <=> root.input-text;
            streaming: root.is-streaming;
        }
    }


    // Left vertical tag
    Text {
        text: AppStrings.mind-mod-title;
        color: RedesignTheme.t.mind-drive-accent;
        font-family: "JetBrains Mono";
        font-size: 10px;
        opacity: root.left-drawer-open ? 0.0 : (left_gem.has-hover ? 0.95 : 0.55 + 0.1 * Math.sin(animation-tick() / 8000ms * 360deg));
        x: 12px;
        y: root.gem-mid-y + 80px;
        width: 12px;
        wrap: word-wrap;
    }

    // Right vertical tag
    Text {
        text: AppStrings.work-mod-title;
        color: RedesignTheme.t.mind-abyss-accent;
        font-family: "JetBrains Mono";
        font-size: 10px;
        opacity: root.right-drawer-open ? 0.0 : (right_gem.has-hover ? 0.95 : 0.55 + 0.1 * Math.sin(animation-tick() / 8000ms * 360deg));
        x: parent.width - 24px;
        y: root.gem-mid-y + 80px;
        width: 12px;
        wrap: word-wrap;
    }
    left_gem := DoorbellGem {
        is-left: true;
        is-open: root.left-drawer-open;
        base-color: RedesignTheme.t.mind-drive-accent;
        x: 0px;
        y: root.gem-mid-y;
        toggle => { root.left-drawer-open = !root.left-drawer-open; }
    }
    right_gem := DoorbellGem {
        is-left: false;
        is-open: root.right-drawer-open;
        base-color: RedesignTheme.t.mind-abyss-accent;
        x: parent.width - self.width;
        // 右结 y 按真值 L244 var(--node-bottom, 230px)，Slint 侧译为绑 WorkMod 泊位中线；WorkMod 闭态宽 0 无法实测时退回 230px 常量
        y: root.gem-mid-y;
        toggle => { root.right-drawer-open = !root.right-drawer-open; }
    }

}