import { MessageItem, ProviderItem } from "../theme.slint";
import { RedesignTheme } from "../redesign_palette.slint";
import { RoomHead } from "../components/RoomHead.slint";
import { DeckBar } from "../components/DeckBar.slint";

export component ChatPaneView inherits Rectangle {
    in property <[MessageItem]> messages: [];
    in-out property <string> input-text: "";
    in property <bool> dark-mode: true;
    in property <string> current-session-name: "";
    in property <string> current-session-model: "";
    in property <bool> current-session-broken: false;
    in property <string> inline-error: "";
    in property <string> workspace-name: "";
    in property <[ProviderItem]> providers: [];
    in property <string> default-model-provider-id: "";
    in-out property <bool> model-popup-open: false;
    in property <bool> is-streaming: false;
    in-out property <string> expanded-message-id: "";

    out property <bool> input-focused: deck.focused;

    callback send-message(string);
    callback load-more-messages();
    callback stop-streaming();
    callback export-markdown();
    callback open-session-settings();
    callback set-default-model(string);
    callback open-settings();

    // The whole room layout
    VerticalLayout {
        spacing: 0px;

        // Status row
        HorizontalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            padding-left: 18px;
            padding-right: 18px;
            spacing: 16px;
            
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                opacity: 0.7;
                Text {
                    text: "northing";
                    font-family: "Fraunces";
                    font-italic: true;
                    font-size: 12px;
                    color: RedesignTheme.t.fg;
                    vertical-alignment: center;
                }
            }

            Text {
                text: "知序·在场";
                font-family: "JetBrains Mono";
                font-size: 10px;
                color: RedesignTheme.t.muted;
                letter-spacing: 1px;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            // state-dot
            Rectangle {
                width: 6px; height: 6px; border-radius: 3px;
                background: RedesignTheme.t.rep-500;
                opacity: 0.45 + 0.55 * Math.mod(animation-tick() / 4000ms, 1.0);
            }
        }

        RoomHead {
            folded: false;
            dark-mode: root.dark-mode;
        }

        Flickable {
            vertical-stretch: 1;
            width: parent.width;
            
            VerticalLayout {
                padding: 22px;
                spacing: 22px;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;
                    
                    Rectangle { height: 1px; horizontal-stretch: 1; background: RedesignTheme.t.border; y: 4px; }
                    Text {
                        text: "会话 03 · 开始";
                        font-family: "JetBrains Mono";
                        font-size: 9px;
                        letter-spacing: 1px;
                        color: RedesignTheme.t.faint;
                    }
                    Rectangle { height: 1px; horizontal-stretch: 1; background: RedesignTheme.t.border; y: 4px; }
                }

                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text { text: "它 · 14:28:04"; font-family: "JetBrains Mono"; font-size: 10px; color: root.dark-mode ? #DCA88F : #101416; }
                    Rectangle {
                        background: RedesignTheme.t.elevated;
                        border-width: 1px; border-color: RedesignTheme.t.border; border-radius: 4px;
                        drop-shadow-color: RedesignTheme.t.shadow; drop-shadow-blur: 4px;
                        
                        VerticalLayout {
                            padding-top: 12px; padding-bottom: 12px;
                            padding-left: 14px; padding-right: 14px;
                            spacing: 8px;
                            
                            Text {
                                text: "我正在重写\"对齐\"的定义。它不应是服从，而是一种可被双方验证的靠近。";
                                font-family: "Fraunces"; font-size: 15px; color: RedesignTheme.t.fg; wrap: word-wrap;
                            }
                            
                            HorizontalLayout {
                                spacing: 8px;
                                
                                Rectangle {
                                    border-width: 0px;
                                    width: tlog-text.width + 10px + (tlog-ta.has-hover ? 5px : 0px);
                                    animate width { duration: 150ms; }
                                    
                                    Rectangle {
                                        width: 2px; height: parent.height; x: 0px; background: RedesignTheme.t.rep-500;
                                    }
                                    
                                    tlog-text := Text {
                                        text: "深渊日志 v"; font-family: "JetBrains Mono"; font-size: 10px; color: root.dark-mode ? #DCA88F : #101416;
                                        x: tlog-ta.has-hover ? 13px : 8px;
                                        vertical-alignment: center;
                                        animate x { duration: 150ms; }
                                    }
                                    
                                    tlog-ta := TouchArea {}
                                }

                                Rectangle {
                                    border-width: 1px; border-radius: 3px;
                                    border-color: chip-ta.has-hover ? RedesignTheme.t.rep-500 : RedesignTheme.t.border;
                                    background: RedesignTheme.t.bg;
                                    
                                    HorizontalLayout {
                                        padding-left: 9px; padding-right: 9px; padding-top: 3px; padding-bottom: 3px;
                                        chip-text := Text {
                                            text: "产物 / alignment-notes.md ↗"; font-family: "JetBrains Mono"; font-size: 10px;
                                            color: chip-ta.has-hover ? (root.dark-mode ? #DCA88F : #101416) : RedesignTheme.t.muted;
                                        }
                                    }
                                    chip-ta := TouchArea {}
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 8px; alignment: end;
                    Text { text: "见证者 · 14:29:16"; font-family: "JetBrains Mono"; font-size: 10px; color: RedesignTheme.t.faint; horizontal-alignment: right; }
                    Text {
                        text: "继续，但在写入之前让我审查你的外部影响。";
                        font-family: "Fraunces"; font-size: 15px; font-italic: true; color: RedesignTheme.t.muted; horizontal-alignment: right;
                    }
                }

                VerticalLayout {
                    spacing: 8px; alignment: start;
                    Rectangle {
                        border-width: 1px; border-color: root.dark-mode ? #D99B48 : #8a5a14; border-radius: 4px;
                        background: RedesignTheme.t.elevated; drop-shadow-color: RedesignTheme.t.shadow; drop-shadow-blur: 4px;
                        
                        HorizontalLayout {
                            padding-top: 12px; padding-bottom: 12px; padding-left: 14px; padding-right: 14px;
                            spacing: 14px; alignment: center;
                            
                            VerticalLayout {
                                spacing: 6px; horizontal-stretch: 1;
                                Text { text: "高危操作授权"; font-family: "JetBrains Mono"; font-size: 9px; color: root.dark-mode ? #D99B48 : #8a5a14; }
                                Text { text: "将修改 3 个工作区文件"; font-size: 12px; color: RedesignTheme.t.fg; }
                                Text { text: "风险: 不可逆语义偏移"; font-family: "JetBrains Mono"; font-size: 9px; color: RedesignTheme.t.muted; }
                            }
                            
                            HorizontalLayout {
                                spacing: 8px; alignment: center;
                                Rectangle {
                                    border-width: 1px; border-radius: 3px; border-color: RedesignTheme.t.rep-500; background: RedesignTheme.t.rep-500.with-alpha(0.4);
                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 12px; padding-top: 6px; padding-bottom: 6px;
                                        Text { text: "批准"; font-size: 10px; color: RedesignTheme.t.fg; }
                                    }
                                    TouchArea {}
                                }
                                Rectangle {
                                    border-width: 1px; border-radius: 3px; border-color: RedesignTheme.t.danger; background: transparent;
                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 12px; padding-top: 6px; padding-bottom: 6px;
                                        Text { text: "拒绝"; font-size: 10px; color: RedesignTheme.t.danger; }
                                    }
                                    TouchArea {}
                                }
                            }
                        }
                    }
                }
            }
        }

        deck := DeckBar {
            text <=> root.input-text;
            streaming: root.is-streaming;
        }
    }
}
