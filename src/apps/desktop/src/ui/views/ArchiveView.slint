// ArchiveView - 档案册（FR-T4-4，照 archive.html MVP）
// 设计真值：docs/design/2026-07-22-frontend-redesign/prototypes/archive.html
// 配色全 abyss 冷系（禁 rep 红线）；数值照抄 archive.html（设计显式 px 允许）。
// 数据缺口：横跨天数 / 摘要 / 展开 log / 时间分组 --占位，报告列数据需求清单。

import { RedesignTheme } from "../redesign_palette.slint";
import { SessionItem } from "../theme.slint";

export component ArchiveView inherits Rectangle {
    in property <[SessionItem]> sessions: [];
    callback back();
    callback open-session(string);
    callback export-markdown();

    background: transparent;

    // 滚动主体（archive.html 全页滚动：header + timeline 皆在流中）
    // 660/720 居中约束（ChatPaneView 同款 Flickable 宽约束模式）
    Flickable {
        width: min(parent.width, 720px);
        x: (parent.width - self.width) / 2;
        height: parent.height;

        VerticalLayout {
            width: parent.width;
            spacing: 0px;

            // ── 沉积剖面装饰条（archive.html .sediment-profile L143）──
            Rectangle {
                width: parent.width;
                height: 3px;
                background: @linear-gradient(90deg,
                    RedesignTheme.t.abyss-500 0%,
                    RedesignTheme.t.abyss-300 25%,
                    RedesignTheme.t.border-soft 60%,
                    RedesignTheme.t.border 100%);
                opacity: 0.35;
            }

            // ── 返回行（桌面端需要返回 main；archive.html 无此元素）──
            Rectangle {
                width: parent.width;
                height: 44px;

                back-touch := TouchArea {
                    width: 80px;
                    height: 36px;
                    y: 8px;
                    clicked => { root.back(); }

                    Text {
                        text: "← 返回";
                        color: RedesignTheme.t.muted;
                        font-size: RedesignTheme.t.fs-body;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }

            // ── archive-header（archive.html L159-198）──
            // padding-top 52px
            Rectangle { width: parent.width; height: 52px; background: transparent; }

            // archive-title「档案馆」28px brand（archive.html L167-174）
            Text {
                text: "档案馆";
                color: RedesignTheme.t.fg;
                font-size: 28px;
                font-weight: 500;
                font-family: "Fraunces";
            }

            // archive-subtitle margin-top 6px（archive.html L180）
            Rectangle { width: parent.width; height: 6px; background: transparent; }

            // archive-subtitle「它走过的路，沉在这里」16px faint（archive.html L176-183）
            Text {
                text: "它走过的路，沉在这里";
                color: RedesignTheme.t.faint;
                font-size: 16px;
            }

            // archive-meta-row margin-top 14px（archive.html L185-189）
            Rectangle { width: parent.width; height: 14px; background: transparent; }

            // archive-stats「N 段封存 · 横跨 - 天」mono 10px faint（archive.html L191-197）
            // M 占位「-」（Rust 投影缺口：横跨天数需 sessions 时间跨度计算）
            HorizontalLayout {
                alignment: end;

                Text {
                    text: root.sessions.length + " 段封存 · 横跨 - 天";
                    color: RedesignTheme.t.faint;
                    font-size: RedesignTheme.t.fs-sm;
                    font-family: "Consolas, monospace";
                }
            }

            // timeline margin-top 40px（archive.html .archive-timeline L202）
            Rectangle { width: parent.width; height: 40px; background: transparent; }

            // ── 时间轴 session-cards（archive.html .session-card L229+）──
            // 内嵌 VerticalLayout，spacing 14px = card margin-bottom
            VerticalLayout {
                width: parent.width;
                spacing: 14px;

                for session[index] in root.sessions: HorizontalLayout {
                    spacing: 0px;

                    // subagent 缩进：depth * s4（data-depth 语义）
                    Rectangle {
                        width: session.depth * RedesignTheme.t.s4;
                        background: transparent;
                    }

                    // 卡片本体
                    card := Rectangle {
                        horizontal-stretch: 1;

                        // 沉积淡化：1.0 - index * 0.06，下限 0.5；hover 回升 max(base, 0.85)
                        property <float> base-opacity: max(0.5, 1.0 - index * 0.06);

                        background: card-touch.has-hover
                            ? RedesignTheme.t.abyss-500.with-alpha(0.05)
                            : RedesignTheme.t.archive-card-bg;
                        border-radius: RedesignTheme.t.r-md;
                        border-width: 1px;
                        border-color: card-touch.has-hover
                            ? RedesignTheme.t.abyss-500.with-alpha(0.30)
                            : RedesignTheme.t.archive-cold-border;
                        opacity: card-touch.has-hover
                            ? max(0.85, self.base-opacity)
                            : self.base-opacity;

                        animate background { duration: 350ms; }
                        animate border-color { duration: 350ms; }
                        animate opacity { duration: 350ms; }

                        // 卡片点击 TouchArea（置于内容之下，与 TurnContainer hover-ta
                        // 惯例一致；export-touch 在 VerticalLayout 内 z 序更高，
                        // 点击「导出」不被 card-touch 吞掉）
                        card-touch := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: pointer;
                            clicked => { root.open-session(session.id); }
                        }

                        // 深渊竖线（archive.html .session-card::before L303-314）
                        // 2.5px abyss-400，opacity 0.30，hover 0.50
                        Rectangle {
                            x: 0;
                            y: 14px;
                            width: 2.5px;
                            height: parent.height - 28px;
                            background: RedesignTheme.t.abyss-400;
                            border-radius: 2px;
                            opacity: card-touch.has-hover ? 0.50 : 0.30;
                            animate opacity { duration: 350ms; }
                        }

                        VerticalLayout {
                            padding: 18px;
                            padding-left: 28px;
                            padding-right: 22px;
                            spacing: 8px;

                            // card-top（archive.html L321-327：flex space-between）
                            HorizontalLayout {
                                spacing: 12px;

                                // card-title: session.name 17px fg（archive.html L329-336）
                                Text {
                                    text: session.name;
                                    color: RedesignTheme.t.fg;
                                    font-size: 17px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    wrap: word-wrap;
                                }

                                // card-right（archive.html L338-344：column end）
                                VerticalLayout {
                                    spacing: 5px;
                                    horizontal-stretch: 0;

                                    // card-date: session.timestamp mono 10px faint
                                    Text {
                                        text: session.timestamp;
                                        color: RedesignTheme.t.faint;
                                        font-size: RedesignTheme.t.fs-sm;
                                        font-family: "Consolas, monospace";
                                        horizontal-alignment: right;
                                    }

                                    // card-tag: is-active ?「活跃」:「已封存」
                                    // mono 9px abyss-500 pill（archive.html L354-369）
                                    Rectangle {
                                        height: 16px;
                                        border-radius: RedesignTheme.t.r-pill;
                                        border-width: 1px;
                                        border-color: RedesignTheme.t.archive-cold-border;
                                        background: transparent;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            padding-top: 2px;
                                            padding-bottom: 2px;
                                            alignment: center;

                                            Text {
                                                text: session.is-active ? "活跃" : "已封存";
                                                color: RedesignTheme.t.abyss-500;
                                                font-size: 9px;
                                                font-family: "Consolas, monospace";
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // card-summary（archive.html L371-379）
                            // 占位：摘要待档案功能接入（数据缺口）
                            Text {
                                text: "摘要待档案功能接入";
                                color: RedesignTheme.t.muted;
                                font-size: 13px;
                                wrap: word-wrap;
                            }

                            // 导出行（仅活跃会话显示）
                            // 限制：export-markdown() 无 session-id 参数，
                            // 仅导出当前活跃会话（Rust 侧 callback 签名限制）
                            if session.is-active: Rectangle {
                                height: 20px;

                                HorizontalLayout {
                                    alignment: end;

                                    export-touch := TouchArea {
                                        width: 48px;
                                        height: 20px;
                                        clicked => { root.export-markdown(); }

                                        Text {
                                            text: "导出";
                                            color: RedesignTheme.t.abyss-400;
                                            font-size: RedesignTheme.t.fs-sm;
                                            font-family: "Consolas, monospace";
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            width: parent.width;
                                            height: parent.height;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 空态装饰（archive.html .archive-ornament L466+）
                if root.sessions.length == 0: VerticalLayout {
                    width: parent.width;
                    alignment: center;
                    spacing: 16px;

                    Rectangle { height: 60px; background: transparent; }

                    Rectangle {
                        width: 48px;
                        height: 1px;
                        background: RedesignTheme.t.border;
                        x: (parent.width - self.width) / 2;
                    }

                    Text {
                        text: "尚无封存";
                        color: RedesignTheme.t.faint;
                        font-size: RedesignTheme.t.fs-sm;
                        font-family: "Consolas, monospace";
                        horizontal-alignment: center;
                    }
                }
            }

            // bottom padding 80px（archive.html .archive-timeline padding-bottom 80px）
            Rectangle { width: parent.width; height: 80px; background: transparent; }
        }
    }
}
