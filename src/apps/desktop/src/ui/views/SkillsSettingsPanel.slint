// SkillsSettingsPanel — Phase 3 sub-panel for g6 Skills
//
// Spec: `docs/superpowers/specs/2026-06-26-frontend-onboarding-design.md` §3.2,
// E3=a (one-line display), E2=c (global + per-workspace toggle).

import { SkillStateItem } from "../theme.slint";
import { RedesignTheme } from "../redesign_palette.slint";
import { MaterialCard } from "../components/MaterialCard.slint";
import { AppStrings } from "../strings.slint";

export component SkillsSettingsPanel inherits Rectangle {
    background: RedesignTheme.t.bg;

    in property <[SkillStateItem]> skills: [];
    // 2026-07-27 (K4a R3, Bug C, fix #5): the per-workspace
    // override cycle button is only rendered when the Rust
    // side has confirmed the facade can resolve per-workspace
    // data. The pre-fix code unconditionally rendered the
    // button with `workspace-override == ""` (the "follow
    // global" state), which silently no-op'd the user's
    // clicks — the click callback wrote to AppSettings but
    // nothing in the data flow read from there, so the
    // override never took effect. That's a UX trap: the
    // button LOOKED clickable but the click was a dead
    // end. The honest path: hide the column when the
    // data source is unavailable, and let the user know
    // via the per-row label.
    in property <bool> workspace-override-supported: false;
    callback set-skill-global(string, bool);  // (skill_id, enabled)
    callback set-skill-workspace(string, string);  // (skill_id, override: "" | "on" | "off")

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: RedesignTheme.t.s5;
        spacing: RedesignTheme.t.s4;

        Text {
            text: AppStrings.settings-skills;
            font-size: RedesignTheme.t.fs-lg;
            color: RedesignTheme.t.fg;
        }

        if root.skills.length == 0: Rectangle {
            height: 80px;
            background: RedesignTheme.t.surface;
            border-radius: RedesignTheme.t.r-sm;

            Text {
                text: AppStrings.skills-empty;
                color: RedesignTheme.t.muted;
                opacity: 0.7;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
            }
        }

        Flickable {
            vertical-stretch: 1;
            width: parent.width;

            VerticalLayout {
                spacing: RedesignTheme.t.s1;
                width: parent.width;

                // E3=a: one-line display (name + description).
                for skill in root.skills: MaterialCard {
                    width: parent.width;
                    card-padding: RedesignTheme.t.s4;
                    height: 56px;

HorizontalLayout {
                            spacing: RedesignTheme.t.s4;
                            width: parent.width;

                            info := VerticalLayout {
                            width: parent.width - 360px;
                            spacing: 0;

                            Text {
                                text: skill.name;
                                color: RedesignTheme.t.fg;
                                font-size: RedesignTheme.t.fs-body;
                                font-weight: 600;
                            }
                            Text {
                                text: skill.description;
                                color: RedesignTheme.t.muted;
                                opacity: 0.7;
                                font-size: RedesignTheme.t.fs-md;
                            }
                        }

                        // Global toggle.
                        HorizontalLayout {
                            spacing: RedesignTheme.t.s1;
                            width: 180px;

                            Text {
                                text: AppStrings.skills-global-label;
                                color: RedesignTheme.t.fg;
                                font-size: RedesignTheme.t.fs-md;
                                vertical-alignment: center;
                                width: 50px;
                            }

                            global-toggle := Rectangle {
                                width: 36px;
                                height: 20px;
                                border-radius: RedesignTheme.t.r-pill;
                                background: skill.global-enabled ? RedesignTheme.t.rep-500 : RedesignTheme.t.surface;
                                TouchArea {
                                    width: parent.width;
                                    height: parent.height;
                                    clicked => { root.set-skill-global(skill.id, !skill.global-enabled); }
                                }
                                indicator := Rectangle {
                                    x: skill.global-enabled ? 18px : 0px;
                                    width: 20px;
                                    height: 20px;
                                    border-radius: RedesignTheme.t.r-pill;
                                    background: RedesignTheme.t.bg;
                                }
                            }
                        }

                        // Workspace override cycle button ("" → "on" → "off" → "").
                        // Gated on `workspace-override-supported`: when
                        // the Rust side has confirmed the facade can
                        // resolve per-workspace data, render the
                        // interactive cycle button; otherwise show
                        // a passive "跟随全局" label so the column
                        // width is consistent but the user cannot
                        // click a button that would silently no-op.
                        if root.workspace-override-supported: workspace-cycle := Rectangle {
                            width: 140px;
                            height: 36px;
                            padding: RedesignTheme.t.s1;
                            background: RedesignTheme.t.surface;
                            border-radius: RedesignTheme.t.r-sm;

                            TouchArea {
                                width: parent.width;
                                height: parent.height;
                                clicked => {
                                    // Cycle: "" → "on" → "off" → ""
                                    // (string comparisons on string property)
                                    if skill.workspace-override == "" {
                                        root.set-skill-workspace(skill.id, "on");
                                    } else if skill.workspace-override == "on" {
                                        root.set-skill-workspace(skill.id, "off");
                                    } else {
                                        root.set-skill-workspace(skill.id, "");
                                    }
                                }
                            }

                            Text {
                                text: skill.workspace-override == "" ? "跟随全局"
                                    : skill.workspace-override == "on" ? "本工作文件夹: 开"
                                    : "本工作文件夹: 关";
                                color: RedesignTheme.t.fg;
                                font-size: RedesignTheme.t.fs-md;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                width: parent.width;
                            }
                        }
                        if !root.workspace-override-supported: workspace-cycle-disabled := Rectangle {
                            width: 140px;
                            height: 36px;
                            padding: RedesignTheme.t.s1;
                            background: RedesignTheme.t.surface;
                            border-radius: RedesignTheme.t.r-sm;
                            opacity: 0.5;

                            Text {
                                text: skill.workspace-override == "" ? "跟随全局"
                                    : skill.workspace-override == "on" ? "本工作文件夹: 开"
                                    : "本工作文件夹: 关";
                                color: RedesignTheme.t.faint;
                                font-size: RedesignTheme.t.fs-md;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                width: parent.width;
                            }
                        }
                    }
                }
            }
        }
    }
}