// SpaceView - FR-T4-1 单栏骨架容器
//
// Spec: docs/superpowers/plans/2026-07-28-fr-t4-layout-migration.md
//
// 三段垂直布局：
//   1. presence 占位（T4-2 替换为 PresenceZone，内部先留空）
//   2. stream 区（ChatPaneView 消息流）
//   3. deck 区（ChatPaneView DeckBar）
// 左右让出 28px 把手区由 main.slint 定位
//（x: 28px; width: parent.width - 56px;）。
// 720 居中约束在 ChatPaneView 内部实现（消息流 + DeckBar 各自居中）。

import { MessageItem, ProviderItem } from "../theme.slint";
import { RedesignTheme } from "../redesign_palette.slint";
import { ChatPaneView } from "ChatPaneView.slint";
import { PresenceZone } from "../components/PresenceZone.slint";

export component SpaceView inherits Rectangle {
    in property <[MessageItem]> messages: [];
    in-out property <string> input-text: "";
    in property <bool> dark-mode: true;
    in property <string> current-session-name: "";
    in property <string> current-session-model: "";
    in property <bool> current-session-broken: false;
    in property <string> inline-error: "";
    in property <string> workspace-name: "";
    in property <[ProviderItem]> providers: [];
    in property <string> default-model-provider-id: "";
    in-out property <bool> model-popup-open: false;
    callback set-default-model(string);
    in property <bool> is-streaming: false;
    out property <bool> input-focused: chat-pane.input-focused;
    callback send-message(string);
    callback load-more-messages();
    callback stop-streaming();
    callback export-markdown();
    callback open-session-settings();
    callback open-settings();
    in-out property <string> expanded-message-id: "";

    // T2：转发 ChatPaneView 的抽屉开合 + RoomHead 折叠状态/回调。
    in-out property <bool> left-drawer-open: false;
    in-out property <bool> right-drawer-open: false;
    in-out property <bool> room-head-folded: false;
    callback toggle-room-head-fold();

    // 透明：让 main.slint 的 AirTint 整屋暖雾/speaking 升档透进来（FR-T4-10）
    background: transparent;

    HorizontalLayout {
        padding-top: 26px;
        padding-bottom: 26px;
        padding-left: 48px;
        padding-right: 48px;
        alignment: center;
        
        room-wrap := Rectangle {
            width: min(780px, parent.width - 96px);
            
            room := Rectangle {
                width: parent.width;
                height: parent.height;
                background: RedesignTheme.t.bg;
                border-color: RedesignTheme.t.border;
                border-width: 1px;
                border-radius: 6px;
                clip: true;
                drop-shadow-color: RedesignTheme.dark ? rgba(0, 0, 0, 0.28) : rgba(23, 34, 42, 0.10);
                drop-shadow-offset-y: 12px;
                drop-shadow-blur: 32px;

                chat-pane := ChatPaneView {
                    width: parent.width;
                    messages: root.messages;
                    input-text <=> root.input-text;
                    dark-mode: root.dark-mode;
                    current-session-name: root.current-session-name;
                    current-session-model: root.current-session-model;
                    current-session-broken: root.current-session-broken;
                    inline-error: root.inline-error;
                    workspace-name: root.workspace-name;
                    providers: root.providers;
                    default-model-provider-id: root.default-model-provider-id;
                    model-popup-open <=> root.model-popup-open;
                    is-streaming: root.is-streaming;
                    expanded-message-id <=> root.expanded-message-id;
                    left-drawer-open <=> root.left-drawer-open;
                    right-drawer-open <=> root.right-drawer-open;
                    room-head-folded <=> root.room-head-folded;

                    send-message(text) => { root.send-message(text); }
                    load-more-messages => { root.load-more-messages(); }
                    stop-streaming => { root.stop-streaming(); }
                    export-markdown => { root.export-markdown(); }
                    open-session-settings => { root.open-session-settings(); }
                    set-default-model(id) => { root.set-default-model(id); }
                    open-settings => { root.open-settings(); }
                    toggle-room-head-fold => { root.toggle-room-head-fold(); }
                }
            }
        }
    }
}
