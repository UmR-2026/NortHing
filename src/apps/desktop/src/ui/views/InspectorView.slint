// SUPERSEDED(FR-T4-5): 内容已迁移至 OuterDrawer（Skills/主题切换/MCP 状态）；文件保留待 FR-T6 清理。
// Inspector View - Skills, settings, model info

import { SkillItem } from "../theme.slint";
import { RedesignTheme } from "../redesign_palette.slint";
import { MaterialListItem } from "../components/MaterialList.slint";
import { MaterialIconButton } from "../components/MaterialIconButton.slint";
import { MaterialBadge } from "../components/MaterialBadge.slint";

export component InspectorView inherits Rectangle {
    in property <[SkillItem]> skills: [];
    in property <string> model-status: "Model: Not configured";
    in property <bool> dark-mode: true;
    
    callback toggle-skill(string);
    callback toggle-theme();
    
    background: RedesignTheme.t.surface;
    
    VerticalLayout {
        padding: RedesignTheme.t.s4;
        spacing: RedesignTheme.t.s4;
        
        // Header - fixed height
        HorizontalLayout {
            height: 48px;
            alignment: space-between;
            
            Text {
                text: "Inspector";
                font-size: RedesignTheme.t.fs-lg;
                color: RedesignTheme.t.fg;
                font-weight: 600;
                vertical-alignment: center;
            }
            
            MaterialIconButton {
                icon: dark-mode ? "☀" : "🌙";
                clicked => { root.toggle-theme(); }
            }
        }
        
        // Model status - fixed height
        Rectangle {
            height: 48px;
            background: RedesignTheme.t.bg;
            border-radius: RedesignTheme.t.r-sm;
            // padding is layout-only in Slint; use inner layout spacing instead
            // padding: RedesignTheme.t.s2;
            
            Text {
                text: root.model-status;
                font-size: RedesignTheme.t.fs-md;
                color: RedesignTheme.t.fg;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
        
        // Skills label - fixed height
        Text {
            text: "Skills";
            font-size: RedesignTheme.t.fs-name;
            color: RedesignTheme.t.fg;
            font-weight: 600;
        }
        
        // Skills list - fill remaining space
        Rectangle {
            height: root.height - 48px - 48px - 32px - RedesignTheme.t.s4 * 3;
            
            Flickable {
                width: parent.width;
                height: parent.height;
                
                VerticalLayout {
                    spacing: RedesignTheme.t.s1;
                    
                    for skill in skills: HorizontalLayout {
                        height: 40px;
                        spacing: RedesignTheme.t.s2;
                        
                        MaterialListItem {
                            text: skill.name;
                            secondary-text: skill.description;
                            selected: skill.enabled;
                            width: root.width - 50px;
                            
                            clicked => { root.toggle-skill(skill.id); }
                        }
                        
                        if skill.enabled: MaterialBadge {
                            text: "●";
                            background-color: RedesignTheme.t.abyss-500;
                        }
                    }
                    
                    if skills.length == 0: Text {
                        text: "No skills available.\nCheck your agent configuration.";
                        font-size: RedesignTheme.t.fs-body;
                        color: RedesignTheme.t.faint;
                        opacity: 0.5;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}