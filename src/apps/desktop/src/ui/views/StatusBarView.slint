// Status Bar View - Bottom status bar

import { RedesignTheme } from "../redesign_palette.slint";

export component StatusBarView inherits Rectangle {
    in property <string> mcp-status: "MCP: Initializing...";
    in property <string> model-status: "Model: Not configured";
    in property <string> app-title: "northhing v0.1.0";
    in property <bool> dark-mode: true;
    
    background: RedesignTheme.t.surface;
    border-width: 1px;
    border-color: RedesignTheme.t.border;
    opacity: 0.1;
    
    HorizontalLayout {
        padding: RedesignTheme.t.s2;
        alignment: space-between;
        
        Text {
            text: root.app-title;
            font-size: RedesignTheme.t.fs-md;
            color: RedesignTheme.t.muted;
            opacity: 0.6;
            vertical-alignment: center;
        }
        
        HorizontalLayout {
            spacing: RedesignTheme.t.s5;
            
            Text {
                text: root.mcp-status;
                font-size: RedesignTheme.t.fs-md;
                color: RedesignTheme.t.muted;
                opacity: 0.7;
                vertical-alignment: center;
            }
            
            Text {
                text: root.model-status;
                font-size: RedesignTheme.t.fs-md;
                color: RedesignTheme.t.muted;
                opacity: 0.5;
                vertical-alignment: center;
            }
        }
    }
}
