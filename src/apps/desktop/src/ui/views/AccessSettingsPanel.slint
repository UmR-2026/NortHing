// AccessSettingsPanel - FR-T4-6a 访问权限 panel（壳）
//
// 设计真值：docs/design/2026-07-22-frontend-redesign/prototypes/settings-access.html
// 任务书 T4-6a 改动清单 §4：照 settings-access.html 布局做壳--自治档 segment
// （按设计稿实际档位：自治·完全 / 需确认 两档），选中态 rep 高亮；无后端：
// property<int> selected 本地态 + 注释「TODO 接后端自治档」。
//
// 数据需求（报告列）：后端需提供--(1) 全局自治档当前值（permissive/strict）；
// (2) 每模式覆盖表（mode × 当前档，含默认档标记）；(3) 命令黑名单（内置 +
// 用户自定义）；(4) 审计日志路径与读取通路。当前 panel 仅自治档 segment 为
// 本地交互态，其余卡片为静态壳待后端接入。

import { RedesignTheme } from "../redesign_palette.slint";
import { MaterialCard } from "../components/MaterialCard.slint";
import { MaterialButton } from "../components/MaterialButton.slint";

export component AccessSettingsPanel inherits Rectangle {
    // 透明：让 SettingsView 内容区设置淡雾透过卡片间隙显形（同 GeneralSettingsPanel）。
    background: transparent;

    // TODO 接后端自治档：本地态占位，0=自治·完全(permissive) 1=需确认(strict)。
    // 后端接入后改为 in property + callback set-autonomy(int)。
    in-out property <int> selected: 0;

    Flickable {
        width: parent.width;
        height: parent.height;
        viewport-height: access-layout.preferred-height;

        access-layout := VerticalLayout {
            width: parent.width;
            padding: RedesignTheme.t.s5;
            spacing: RedesignTheme.t.s5;

                // section-eyebrow
                Text {
                    text: "访问权限";
                    font-size: RedesignTheme.t.fs-md;
                    color: RedesignTheme.t.muted;
                }

                // ===== Card 1: 自治档（segment，选中态 rep 高亮）=====
                MaterialCard {
                    width: parent.width;
                    card-padding: RedesignTheme.t.s6;

                    VerticalLayout {
                        width: parent.width;
                        padding: RedesignTheme.t.s6;
                        spacing: RedesignTheme.t.s4;

                        Text {
                            text: "自治档";
                            font-size: RedesignTheme.t.fs-body;
                            color: RedesignTheme.t.fg;
                            font-weight: 600;
                        }

                        // segment 容器（pill，raised 底 + border）
                        Rectangle {
                            width: parent.width;
                            height: 48px;
                            border-radius: RedesignTheme.t.r-pill;
                            background: RedesignTheme.t.raised;
                            border-width: 1px;
                            border-color: RedesignTheme.t.border;

                            HorizontalLayout {
                                x: 4px;
                                y: 4px;
                                width: parent.width - 8px;
                                height: parent.height - 8px;
                                spacing: RedesignTheme.t.s1;

                                // 选项 0：自治·完全
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: RedesignTheme.t.r-pill;
                                    background: root.selected == 0
                                        ? RedesignTheme.t.elevated
                                        : transparent;
                                    drop-shadow-color: root.selected == 0 ? RedesignTheme.t.shadow.with-alpha(0.06) : transparent;
                                    drop-shadow-blur: root.selected == 0 ? 8px : 0px;
                                    drop-shadow-offset-y: root.selected == 0 ? 2px : 0px;
                                    animate background { duration: RedesignTheme.dur-normal; easing: ease-in-out; }

                                    Text {
                                        text: "自治·完全";
                                        font-size: RedesignTheme.t.fs-body;
                                        color: root.selected == 0
                                            ? RedesignTheme.t.rep-500
                                            : RedesignTheme.t.muted;
                                        font-weight: root.selected == 0 ? 600 : 400;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        animate color { duration: RedesignTheme.dur-normal; easing: ease-in-out; }
                                    }

                                    TouchArea {
                                        width: parent.width;
                                        height: parent.height;
                                        clicked => { root.selected = 0; }
                                    }
                                }

                                // 选项 1：需确认
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: RedesignTheme.t.r-pill;
                                    background: root.selected == 1
                                        ? RedesignTheme.t.elevated
                                        : transparent;
                                    drop-shadow-color: root.selected == 1 ? RedesignTheme.t.shadow.with-alpha(0.06) : transparent;
                                    drop-shadow-blur: root.selected == 1 ? 8px : 0px;
                                    drop-shadow-offset-y: root.selected == 1 ? 2px : 0px;
                                    animate background { duration: RedesignTheme.dur-normal; easing: ease-in-out; }

                                    Text {
                                        text: "需确认";
                                        font-size: RedesignTheme.t.fs-body;
                                        color: root.selected == 1
                                            ? RedesignTheme.t.rep-500
                                            : RedesignTheme.t.muted;
                                        font-weight: root.selected == 1 ? 600 : 400;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        animate color { duration: RedesignTheme.dur-normal; easing: ease-in-out; }
                                    }

                                    TouchArea {
                                        width: parent.width;
                                        height: parent.height;
                                        clicked => { root.selected = 1; }
                                    }
                                }
                            }
                        }

                        // seg-desc（随选中档切换文案）
                        Text {
                            text: root.selected == 0
                                ? "agent 执行命令不打断你。适合信任的编码模式。"
                                : "每条 shell 命令执行前先问你。";
                            font-size: RedesignTheme.t.fs-sm;
                            color: RedesignTheme.t.faint;
                            wrap: word-wrap;
                            width: parent.width;
                        }
                    }
                }

                // ===== Card 2: 每模式覆盖（壳，待后端）=====
                MaterialCard {
                    width: parent.width;
                    card-padding: RedesignTheme.t.s6;

                    VerticalLayout {
                        width: parent.width;
                        padding: RedesignTheme.t.s6;
                        spacing: RedesignTheme.t.s3;

                        Text {
                            text: "每模式覆盖";
                            font-size: RedesignTheme.t.fs-body;
                            color: RedesignTheme.t.fg;
                            font-weight: 600;
                        }
                        Text {
                            text: "编码相关模式默认完全自治；可为单个模式改档。";
                            font-size: RedesignTheme.t.fs-sm;
                            color: RedesignTheme.t.faint;
                            wrap: word-wrap;
                            width: parent.width;
                        }
                        // TODO 接后端：每模式（agentic/plan/debug/...）× 当前档，含默认档标记
                        Text {
                            text: "待后端接入每模式自治档数据";
                            font-size: RedesignTheme.t.fs-sm;
                            color: RedesignTheme.t.muted;
                            opacity: 0.7;
                        }
                    }
                }

                // ===== Card 3: 命令黑名单（静态壳，内置危险命令）=====
                MaterialCard {
                    width: parent.width;
                    card-padding: RedesignTheme.t.s6;

                    VerticalLayout {
                        width: parent.width;
                        padding: RedesignTheme.t.s6;
                        spacing: RedesignTheme.t.s3;

                        Text {
                            text: "命令黑名单";
                            font-size: RedesignTheme.t.fs-body;
                            color: RedesignTheme.t.fg;
                            font-weight: 600;
                        }
                        Text {
                            text: "这些危险命令永远被拦截，无论自治档。";
                            font-size: RedesignTheme.t.fs-sm;
                            color: RedesignTheme.t.faint;
                            wrap: word-wrap;
                            width: parent.width;
                        }

                        // deny-card（abyss 冷调，照 settings-access.html .deny-card）
                        Rectangle {
                            width: parent.width;
                            height: deny-list.preferred-height;
                            border-radius: RedesignTheme.t.r-sm;
                            background: RedesignTheme.t.archive-card-bg;
                            border-width: 1px;
                            border-color: RedesignTheme.t.abyss-300;

                            deny-list := VerticalLayout {
                                width: parent.width;
                                padding: RedesignTheme.t.s3;
                                spacing: RedesignTheme.t.s1;

                                Text { text: "• rm -rf 危险目标"; color: RedesignTheme.t.abyss-500; font-size: RedesignTheme.t.fs-sm; }
                                Text { text: "• dd of=\\\\.\\physicaldrive"; color: RedesignTheme.t.abyss-500; font-size: RedesignTheme.t.fs-sm; }
                                Text { text: "• mkfs 格式化"; color: RedesignTheme.t.abyss-500; font-size: RedesignTheme.t.fs-sm; }
                                Text { text: "• format c:"; color: RedesignTheme.t.abyss-500; font-size: RedesignTheme.t.fs-sm; }
                                Text { text: "• :(){ :|:& };: fork 炸弹"; color: RedesignTheme.t.abyss-500; font-size: RedesignTheme.t.fs-sm; }
                                Text { text: "• shutdown / reboot"; color: RedesignTheme.t.abyss-500; font-size: RedesignTheme.t.fs-sm; }
                            }
                        }
                    }
                }

                // ===== Card 4: 审计日志（壳）=====
                MaterialCard {
                    width: parent.width;
                    card-padding: RedesignTheme.t.s6;

                    VerticalLayout {
                        width: parent.width;
                        padding: RedesignTheme.t.s6;
                        spacing: RedesignTheme.t.s3;

                        Text {
                            text: "审计日志";
                            font-size: RedesignTheme.t.fs-body;
                            color: RedesignTheme.t.fg;
                            font-weight: 600;
                        }
                        Text {
                            text: "每条 shell 命令的决策（允许 / 拦截 / 确认）都记录在案。";
                            font-size: RedesignTheme.t.fs-sm;
                            color: RedesignTheme.t.faint;
                            wrap: word-wrap;
                            width: parent.width;
                        }

                        // audit-path（mono 风，raised 底）
                        Rectangle {
                            height: 28px;
                            border-radius: RedesignTheme.t.r-sm;
                            background: RedesignTheme.t.raised;
                            border-width: 1px;
                            border-color: RedesignTheme.t.border-soft;

                            Text {
                                text: ".northing/audit.log";
                                color: RedesignTheme.t.muted;
                                font-size: RedesignTheme.t.fs-sm;
                                x: RedesignTheme.t.s2;
                                vertical-alignment: center;
                            }
                        }

                        // TODO 接后端：审计日志查看通路
                        MaterialButton {
                            text: "查看审计日志";
                            primary: false;
                            clicked => { }
                        }
                    }
                }
        }
    }
}
