export global SystemConstants {
    // 8s 基础单钟余弦波：1.0(0s) -> -1.0(4s) -> 1.0(8s)
    out property <float> breathe-phase: Math.cos(animation-tick() / 8000ms * 360deg);
    
    // 归一化进度：1.0(0s) -> 0.0(4s) -> 1.0(8s)
    out property <float> breathe-progress: (breathe-phase + 1.0) / 2.0;

    // 振幅分级 (按真值):
    // 主体 (AvatarWrap): 结合 spike 用 opacity 代替 scale。1.0(0s) -> 0.85(4s) -> 1.0(8s)
    out property <float> amp-avatar: 0.85 + 0.15 * breathe-progress; 
    
    // 边界 (membrane-frame): 静息地板 0.08, 峰值 0.35
    out property <float> amp-membrane: 0.08 + 0.27 * (1.0 - breathe-progress);
    
    // 顶晕 (global-aura): 1.0(0s) -> 0.65(4s) -> 1.0(8s)
    out property <float> amp-aura: 0.65 + 0.35 * breathe-progress;
}