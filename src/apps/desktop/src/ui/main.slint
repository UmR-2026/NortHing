// northhing Main Window - Three-region layout with Material Design

// Brand font embedding (FR-T5)
import "./fonts/Fraunces-Regular.ttf";
import "./fonts/Fraunces-Display.ttf";
import "./fonts/Fraunces-Italic.ttf";
import "./fonts/NotoSansSC.ttf";
import "./fonts/JetBrainsMono.ttf";

import { MaterialTheme, SessionItem, MessageItem, SkillItem, ProviderItem, SkillStateItem, MCPItem, WorkspaceItem } from "theme.slint";
import { RedesignTheme } from "redesign_palette.slint";
import { SystemConstants } from "system_constants.slint";
import { SpaceView } from "views/SpaceView.slint";
import { SettingsView } from "views/SettingsView.slint";
import { WelcomeView } from "views/WelcomeView.slint";
import { ArchiveView } from "views/ArchiveView.slint";
import { MaterialBanner } from "components/MaterialBanner.slint";
import { AirTint } from "components/AirTint.slint";
import { WindowChrome } from "components/WindowChrome.slint";
import { InnerDrawer } from "components/InnerDrawer.slint";
import { OuterDrawer } from "components/OuterDrawer.slint";

export component AppWindow inherits Window {
    title: "northhing";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 800px;
    min-height: 600px;
    background: RedesignTheme.t.bg;
    // FR-T3b: frameless 绐楀彛銆俿lint 1.16 鏃?no-titlebar 灞炴€э紙1.16/1.17
    // 鍧囦粎鏈?no-frame锛夛紝鐢?no-frame: true 绉婚櫎鏍囬鏍?+ 绯荤粺杈规锛?
    // 鑷粯绐楀彛鎺у埗鎸夐挳瑙?WindowChrome.slint銆傝嚜瀹氫箟杈圭紭 resize 鍑烘湰鍗?
    // 鑼冨洿锛坰lint winit 鍚庣 resize-border-width 鍙悗缁惎鐢級銆?
    no-frame: true;

    // FR-T3: 绌烘皵鏌撹壊搴曞眰鑳屾櫙锛坺 搴忔渶搴曪級
    AirTint {
        width: root.width;
        height: root.height;
        speaking: root.speaking;
        // FR-T4-4: archive 璺敱鍒?abyss 鍐烽浘锛堟。妗堥绂?rep 鏆栭浘锛?
        cold: root.current-route == "archive";
    }

    // 2026-06-26 (Phase 2): route switching. Spec 搂6.1.
    // "main" 鈥?the regular 3-pane layout
    // "welcome" 鈥?first-run onboarding (Phase 4)
    // "settings" 鈥?Settings panel (Phase 2 shell)
    in-out property <string> current-route: "main";
    // 2026-06-26 (review follow-up): both the open and close hooks
    // are now pure Slint 鈥?no FFI round-trip to Rust. The sidebar
    // entry forwards to `open-settings =>` and the SettingsView's
    // 脳 button forwards to `close-settings =>`; both set
    // `current-route` directly. Removes the `ui.on_open_settings`
    // Rust handler that was added in `97890b2` to fix the original
    // wiring bug.
    callback close-settings();

    // 2026-07-18 (D2h): refresh settings lists whenever the settings
    // route is entered so the panel always shows current data.
    callback refresh-settings();
    changed current-route => {
        if root.current-route == "settings" {
            root.refresh-settings();
        }
        // FR-T3b锛氱寮€ main 璺敱鏃跺浣?speaking锛坵elcome/settings 涓嶆煋鑹诧級
        if root.current-route != "main" {
            root.speaking = false;
        }
    }

    in-out property <string> app-title: "northhing v0.1.0";
    in-out property <string> mcp-status: "MCP: Initializing...";
    in-out property <string> model-status: "Model: Not configured";
    in-out property <bool> dark-mode: true;
    // Phase C.2: when true, the sidebar renders sessions nested by
    // `parent-id` / `depth`. Bound from `app_state.rs` to the
    // `SESSION_TREE_VIEW` const in `main.rs`.
    in-out property <bool> session-tree-view: false;
    // FR-T3b: left sidebar panel open state; wired to WindowChrome toggle-left.
    in-out property <bool> left-panel-open: false;
    // FR-T3b: right inspector panel open state; wired to WindowChrome toggle-right.
    in-out property <bool> right-panel-open: false;
    // FR-T3b: 鏁村眿 speaking 鍗囨。锛圖eckBar 鑱氱劍 -> AirTint 鏌撹壊鍔犳繁锛夈€?
    // ChatPaneView 鍦?main 璺敱鍐呴┍鍔紱鍒囧埌 welcome/settings 鏃跺浣?false銆?
    in-out property <bool> speaking: false;
    // Phase G.3: user-facing toggle for whether subagent (depth >= 1)
    // sessions are visible in the sidebar. Default true. Bound from
    // `app_state.rs::AppState::show_subagents`.
    in-out property <bool> show-subagents: true;
    // Phase G.3: callback fired when the user flips the
    // "Show subagents" checkbox in the sidebar header.
    callback toggle-show-subagents();
    in-out property <[SessionItem]> sessions: [];
    in-out property <[MessageItem]> messages: [];
    in-out property <[SkillItem]> skills: [];

    // 2026-06-26 (Phase 3): Settings sub-panel state pushed from Rust.
    in-out property <[ProviderItem]> providers-list: [];
    in-out property <[SkillStateItem]> skills-list: [];
    in-out property <[MCPItem]> mcp-servers-list: [];
    in-out property <[WorkspaceItem]> workspaces-list: [];
    in-out property <int> current-workspace-index: -1;
    in-out property <string> default-model-provider-id: "";
    in-out property <int> legacy-placeholder-count: 0;
    // 2026-07-27 (K4a R3, Bug C, fix #5): per-workspace
    // override column gate. Wired from
    // `refresh_settings_lists` (see
    // `app_state::callbacks_settings::refresh::refresh_settings_lists`).
    in-out property <bool> workspace-override-supported: false;

    // T4 (2026-08-05): 9 partition visibility booleans for the
    // settings Skills module. Order matches brief §10.1
    // (引擎/玩法/设计/工程/office/meta/computer-use/gstack/其他).
    // A partition's `visible` binding on the Slint side is the
    // only gate that decides whether the partition (title +
    // container) renders — when false, neither the title nor
    // the rows under it take any layout space, so empty
    // partitions don't appear at all. Pushed by Rust from
    // `apply_skill_filter` (both the initial `refresh_settings_
    // lists` dispatch and the `set-skill-filter` keystroke
    // callback).
    in-out property <bool> skill-cat-engine: false;
    in-out property <bool> skill-cat-gameplay: false;
    in-out property <bool> skill-cat-design: false;
    in-out property <bool> skill-cat-engineering: false;
    in-out property <bool> skill-cat-office: false;
    in-out property <bool> skill-cat-meta: false;
    in-out property <bool> skill-cat-computer-use: false;
    in-out property <bool> skill-cat-gstack: false;
    in-out property <bool> skill-cat-other: false;

    // T4 (2026-08-05): per-partition row models. Slint 1.16 的 for 体不能是
    // 条件元素、visible:false 行仍占布局高，故行级过滤在 Rust 侧完成
    // （apply_skill_filter 与 set-skill-filter 同源推送），每个分区只渲染
    // 自己类别的行模型。序同 §10.1。
    in-out property <[SkillStateItem]> skill-rows-engine: [];
    in-out property <[SkillStateItem]> skill-rows-gameplay: [];
    in-out property <[SkillStateItem]> skill-rows-design: [];
    in-out property <[SkillStateItem]> skill-rows-engineering: [];
    in-out property <[SkillStateItem]> skill-rows-office: [];
    in-out property <[SkillStateItem]> skill-rows-meta: [];
    in-out property <[SkillStateItem]> skill-rows-computer-use: [];
    in-out property <[SkillStateItem]> skill-rows-gstack: [];
    in-out property <[SkillStateItem]> skill-rows-other: [];

    // T4 (2026-08-05): settings Skills search-input filter
    // callback. Forwards the current text from the
    // `SettingsView` search box to Rust, which re-applies a
    // case-insensitive substring match on `name` or
    // `description` and re-publishes `skills-list` + the 9
    // partition visibility booleans. The settings drawer
    // (Inspector) model is NOT touched by this callback.
    callback set-skill-filter(string);

    // 2026-06-26 (Phase 3): Settings sub-panel callbacks (wired to AppState methods).
    callback upsert-provider(string, string, string, string, string, string, bool);
    callback delete-provider(string);
    callback test-provider(string);
    callback test-provider-config(string, string, string, string, string, bool);
    callback set-default-model(string);
    callback cleanup-legacy-placeholders();
    callback set-skill-global(string, bool);
    callback set-skill-workspace(string, string);
    callback upsert-mcp(string, string, string, string, string, string, string, bool);
    callback delete-mcp(string);
    callback test-mcp(string);
    // 2026-06-26 (Phase 4): Workspace callbacks (wired to AppState methods).
     callback pick-folder();
     callback add-workspace(string, string, bool);
     callback switch-workspace(string);
     callback remove-workspace(string);
     callback edit-identity-md(string);
     callback open-identity-creator();
      // 2026-06-26 (Phase 4 fix): welcome-step1-path is written by the
      // Rust handler via invoke_from_event_loop; binding it here lets
      // WelcomeView's `next-step1` button un-gray once a folder
      // is chosen. provider-test-result / provider-test-in-flight /
      // last-saved-provider-id are written by the test-provider handler.
      in-out property <string> welcome-step1-path: "";
      in-out property <string> provider-test-result: "";
      in-out property <bool> provider-test-in-flight: false;
      in-out property <string> last-saved-provider-id: "";
      callback onboarding-completed();
     // T2：主诊室 RoomHead 折叠 + 抽屉开合（转发到 SpaceView -> ChatPaneView）。
     in-out property <bool> room-head-folded: false;
     in-out property <bool> left-drawer-open: false;
     in-out property <bool> right-drawer-open: false;
     callback toggle-room-head-fold();
    in-out property <string> current-session-id: "";
    in-out property <string> current-session-name: "";
    in-out property <string> current-session-model: "";
    in-out property <bool> current-session-broken: false;
    in-out property <bool> is-streaming: false;
    in-out property <string> chat-inline-error: "";
    in-out property <string> input-text: "";
    // P0-C (2026-06-25): error display channels. Previously all callback
    // failures went to stderr via `eprintln!` and the user saw nothing.
    // The Rust side sets these via `ui.set_session_error` / `ui.set_input_error`;
    // the SidebarView renders a banner when either is non-empty. The Rust
    // helper auto-clears after 5s; users can also click the banner 脳 to clear.
    in-out property <string> session-error: "";
    in-out property <string> input-error: "";
    // 2026-06-26 (Phase 5): Q8=c dual error channels.
    // - `banner-message` + `banner-detail`: first channel, rendered by
    //   MaterialBanner at the top of the main view. Auto-dismissed
    //   after 5s (P0-C schedule_error_clear pattern).
    // - `chat-inline-error`: second channel, rendered by ChatPaneView
    //   above the input. Manual close only. Pushed to by either:
    //     a) the Rust side via set_inline_error (validation failure)
    //     b) the user clicking "璇︽儏" on the banner (the parent
    //        component copies `banner-message` 鈫?`chat-inline-error`)
    in-out property <string> banner-message: "";
    in-out property <string> banner-detail: "";

    callback send-message(string);
    callback new-session();
    callback switch-session(string);
    callback delete-session(string);
    callback rename-session(string, string);
    callback toggle-theme();
    callback toggle-skill(string);
    callback load-more-messages();
    // Phase 4: session-level callbacks
    callback stop-streaming();
    callback export-markdown();
    callback open-session-settings();
    // Phase 5: banner callbacks
    callback dismiss-banner();
    callback clear-inline-error();
    // P0-C: callbacks fired when the user clicks the banner 脳 button.
    callback clear-session-error();
    callback clear-input-error();

    // Internal refresh callbacks (used by app_state to push updates)
    callback refresh-sessions();
    callback refresh-messages();
    // FR-T3b: frameless 绐楀彛鑷粯鎺у埗鎸夐挳鍥炶皟锛屾帴 Rust slint::Window API銆?
    callback window-minimize();
    callback window-maximize();
    callback window-close();

    changed dark-mode => {
        RedesignTheme.dark = dark-mode;
    }

    // 2026-06-26 (Phase 2): route switching via `if current-route == ...`.
    // Spec 搂6.1 鈥?state in `current-route` is preserved across switches.
    // Welcome view (first-run) is rendered when current-route == "welcome";
    // Settings view replaces the main UI when current-route == "settings".

    if root.current-route == "welcome": WelcomeView {
        width: root.width;
        height: root.height;
        // Phase 4 callbacks: Welcome view fires them when the user
        // picks a folder, adds a workspace, or configures a provider.
        // They map to the same handlers as the SettingsWorkspacePanel.
        pick-folder => { root.pick-folder(); }
        add-workspace(path, name, set-current) => { root.add-workspace(path, name, set-current); }
        upsert-provider(id, name, type, base-url, api-key, model, enabled)
            => { root.upsert-provider(id, name, type, base-url, api-key, model, enabled); }
        // 2026-06-26 (Phase 4 fix): bind WelcomeView's internal state to
        // root properties so Rust handlers (which can only set root-level
        // properties via invoke_from_event_loop) can drive the UI.
        step1-path <=> root.welcome-step1-path;
        step2-test-result <=> root.provider-test-result;
        step2-test-in-flight <=> root.provider-test-in-flight;
        step2-saved-provider-id <=> root.last-saved-provider-id;
        on-completed => { root.onboarding-completed(); }
    }

    if root.current-route == "settings": SettingsView {
        width: root.width;
        height: root.height;
        dark-mode: root.dark-mode;
        toggle-theme => { root.toggle-theme(); }
        providers: root.providers-list;
        skills: root.skills-list;
        mcp-servers: root.mcp-servers-list;
        workspaces: root.workspaces-list;
        workspace-override-supported: root.workspace-override-supported;
        current-workspace-index: root.current-workspace-index;
        default-model-provider-id: root.default-model-provider-id;
        legacy-placeholder-count: root.legacy-placeholder-count;
        provider-test-result: root.provider-test-result;
        provider-test-in-flight: root.provider-test-in-flight;
        // T4 (2026-08-05): forward 9 partition visibility booleans
        // (brief §10.1) to the SettingsView. Each partition's
        // `visible` binding is the ONLY gate that decides whether
        // the title + rows render. Empty partitions don't appear.
        cat-engine: root.skill-cat-engine;
        cat-gameplay: root.skill-cat-gameplay;
        cat-design: root.skill-cat-design;
        cat-engineering: root.skill-cat-engineering;
        cat-office: root.skill-cat-office;
        cat-meta: root.skill-cat-meta;
        cat-computer-use: root.skill-cat-computer-use;
        cat-gstack: root.skill-cat-gstack;
        cat-other: root.skill-cat-other;
        rows-engine: root.skill-rows-engine;
        rows-gameplay: root.skill-rows-gameplay;
        rows-design: root.skill-rows-design;
        rows-engineering: root.skill-rows-engineering;
        rows-office: root.skill-rows-office;
        rows-meta: root.skill-rows-meta;
        rows-computer-use: root.skill-rows-computer-use;
        rows-gstack: root.skill-rows-gstack;
        rows-other: root.skill-rows-other;
        // T4 (2026-08-05): forward the search-input filter text
        // to Rust. The Rust side applies the substring match and
        // re-publishes `skills-list` + the 9 cat-* booleans.
        set-skill-filter(text) => { root.set-skill-filter(text); }
        close-settings => { root.current-route = "main"; }

        upsert-provider(id, name, type, base-url, api-key, model, enabled)
            => { root.upsert-provider(id, name, type, base-url, api-key, model, enabled); }
        delete-provider(id) => { root.delete-provider(id); }
        test-provider(id) => { root.test-provider(id); }
        set-default-model(id) => { root.set-default-model(id); }
        cleanup-legacy-placeholders => { root.cleanup-legacy-placeholders(); }
        set-skill-global(id, enabled) => { root.set-skill-global(id, enabled); }
        set-skill-workspace(id, override) => { root.set-skill-workspace(id, override); }
        upsert-mcp(id, name, transport, command, args, url, env, enabled)
            => { root.upsert-mcp(id, name, transport, command, args, url, env, enabled); }
        delete-mcp(id) => { root.delete-mcp(id); }
        test-mcp(id) => { root.test-mcp(id); }
        pick-folder => { root.pick-folder(); }
        add-workspace(path, name, set-current) => { root.add-workspace(path, name, set-current); }
        switch-workspace(id) => { root.switch-workspace(id); }
        remove-workspace(id) => { root.remove-workspace(id); }
        edit-identity-md(id) => { root.edit-identity-md(id); }
        open-identity-creator => { root.open-identity-creator(); }
    }

    if root.current-route == "main": Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;

        // FR-T4-1: 鍗曟爮楠ㄦ灦 SpaceView
        space := SpaceView {
            x: 0px;
            y: 0;
            width: parent.width;
            height: parent.height;
            messages: root.messages;
            input-text <=> root.input-text;
            dark-mode: root.dark-mode;
            current-session-name: root.current-session-name;
            current-session-model: root.current-session-model;
            current-session-broken: root.current-session-broken;
            is-streaming: root.is-streaming;
            inline-error: root.chat-inline-error;
            workspace-name: root.current-workspace-index >= 0 ? root.workspaces-list[root.current-workspace-index].display-name : "";
            providers: root.providers-list;
            default-model-provider-id: root.default-model-provider-id;

            // T2：转发主诊室 RoomHead 折叠 + 抽屉开合。
            room-head-folded <=> root.room-head-folded;
            left-drawer-open <=> root.left-drawer-open;
            right-drawer-open <=> root.right-drawer-open;
            toggle-room-head-fold => { root.toggle-room-head-fold(); }

            send-message(text) => { root.send-message(text); }
            load-more-messages => { root.load-more-messages(); }
            stop-streaming => { root.stop-streaming(); }
            export-markdown => { root.export-markdown(); }
            open-session-settings => { root.open-session-settings(); }
            set-default-model(id) => { root.set-default-model(id); }
            // FR-T4-1: 鈿?鍏?deck -> settings 璺敱
            open-settings => { root.current-route = "settings"; }
            // FR-T3b锛欴eckBar 鑱氱劍 -> 鏁村眿 speaking 鍗囨。
            changed input-focused => { root.speaking = space.input-focused; }
        }

        // 2026-06-26 (Phase 5): global MaterialBanner overlay.
        // Q8=c dual channel: this is the first channel (auto-dismiss).
        // Renders only when `banner-message` is non-empty. The
        // `detail-clicked` callback copies the banner to the
        // chat-inline-error second channel (manual close).
        if root.banner-message != "": MaterialBanner {
            x: 0;
            y: root.height - 56px;
            width: root.width;
            height: 56px;
            message: root.banner-message;
            detail: root.banner-detail;
            dismissed => { root.dismiss-banner(); }
            detail-clicked => {
                // Q8=c "璇︽儏" expand: copy the same error to the
                // inline channel. The Rust side reads chat-inline-error
                // and renders it inside ChatPaneView above the input.
                root.chat-inline-error = root.banner-message;
                root.dismiss-banner();
            }
        }
    }

    // FR-T4-4: archive 璺敱 -- 妗ｆ鍐?ArchiveView锛堢収 archive.html MVP锛?
    if root.current-route == "archive": ArchiveView {
        width: root.width;
        height: root.height;
        sessions: root.sessions;
        back => { root.current-route = "main"; }
        open-session(id) => {
            root.switch-session(id);
            root.current-route = "main";
        }
        export-markdown => { root.export-markdown(); }
    }

    // FR-T4-3: 宸︽娊灞夈€屽唴鍦ㄣ€嶅３锛岃法璺敱瑕嗙洊锛寊 搴忓湪 SpaceView 涔嬩笂銆乄indowChrome 涔嬩笅
    InnerDrawer {
        width: root.width;
        height: root.height;
        open: root.left-panel-open;
        close => { root.left-panel-open = false; }
        export-markdown => { root.export-markdown(); root.left-panel-open = false; }
        // FR-T4-4: 妗ｆ鍐屽叆鍙?-> archive 璺敱 + 鍏虫娊灞?
        open-archive => { root.current-route = "archive"; root.left-panel-open = false; }
    }

    // FR-T4-5: 鍙虫娊灞夈€屽鐗┿€嶅３锛岃法璺敱瑕嗙洊锛寊 搴忎笌 InnerDrawer 鍚岀骇
    OuterDrawer {
        width: root.width;
        height: root.height;
        open: root.right-panel-open;
        skills: root.skills;
        mcp-status: root.mcp-status;
        dark-mode: root.dark-mode;
        close => { root.right-panel-open = false; }
        toggle-skill(id) => { root.toggle-skill(id); }
        toggle-theme => { root.toggle-theme(); }
        open-session-settings => { root.open-session-settings(); }
    }

    // FR-T3/FR-T3b: 绐楀彛瑁呴グ灞傗€旇法璺敱瑕嗙洊锛圓ppWindow 鐩存帴瀛愯妭鐐癸紝
    // 鍦ㄥ洓涓?if route 鍧椾箣鍚庯紝welcome/settings/main/archive 鍏ㄨ矾鐢卞彲瑙侊級銆?
        WindowChrome {
        width: root.width;
        height: root.height;
        inner-drawer-open: root.left-panel-open;
        outer-drawer-open: root.right-panel-open;
        toggle-left => { root.left-panel-open = !root.left-panel-open; }
        // FR-T3b锛氬彸鏍忥紙InspectorView锛夊紑鍏筹紝瀵圭О浜庡乏鏍?
        toggle-right => { root.right-panel-open = !root.right-panel-open; }
        // FR-T3b锛歠rameless 绐楀彛鎺у埗鎸夐挳杞彂鍒?root 鍥炶皟锛圧ust 渚ф帴绾匡級
        window-minimize => { root.window-minimize(); }
        window-maximize => { root.window-maximize(); }
        window-close => { root.window-close(); }
        toggle-theme => { root.toggle-theme(); }
    }
}   // close AppWindow
