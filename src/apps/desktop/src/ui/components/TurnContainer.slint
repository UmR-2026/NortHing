// TurnContainer Component - 对话轮容器（FR-T3b）
//
// 每轮对话的外层容器。Token 全部来自 RedesignTheme.t.*（redesign_palette.slint）。
// - active：进行中的轮次（背景 turn-active + 左缘 rep-400 竖线）
// - sedimented：历史轮次（opacity 0.5，hover 回升 0.7）

import { RedesignTheme } from "../redesign_palette.slint";

export component TurnContainer inherits Rectangle {
    in property <bool> active: false;
    in property <bool> sedimented: false;

    background: root.active ? RedesignTheme.t.turn-active : transparent;

    opacity: root.sedimented
        ? (hover-ta.has-hover ? 0.7 : 0.5)
        : 1.0;
    animate opacity { duration: RedesignTheme.dur-normal; }

    // 置于内容之下：不拦截子元素（工具调用展开等）的点击，hover 仅在不被
    // 子 TouchArea 覆盖的区域生效。
    hover-ta := TouchArea {
        width: parent.width;
        height: parent.height;
    }

    // active 左缘 2.5px 竖线：绝对定位撑满高度。不用 HorizontalLayout--
    // 其主轴横向会与子元素 width 绑定构成 layoutinfo-h 绑定环。
    if root.active: Rectangle {
        x: 0;
        y: 0;
        width: 2.5px;
        height: parent.height;
        background: RedesignTheme.t.rep-400;
    }

    VerticalLayout {
        padding: RedesignTheme.t.s4;
        @children
    }
}
