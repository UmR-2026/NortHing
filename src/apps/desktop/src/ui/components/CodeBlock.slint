// Code Block Component

import { RedesignTheme } from "../redesign_palette.slint";

export component CodeBlock inherits Rectangle {
    in property <string> code: "";
    in property <string> language: "";
    
    background: #1E1E1E;
    border-radius: 4px;
    padding: RedesignTheme.t.s4;
    
    VerticalLayout {
        if language != "": Text {
            text: language;
            font-size: RedesignTheme.t.fs-md;
            color: RedesignTheme.t.fg;
            opacity: 0.6;
        }
        
        Text {
            text: root.code;
            font-size: RedesignTheme.t.fs-body;
            color: #D4D4D4;
            font-family: "Consolas, monospace";
            wrap: word-wrap;
        }
    }
}
