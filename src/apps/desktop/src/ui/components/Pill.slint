// Pill Component - 閫氱敤寰界珷/鏍囩锛團R-T3b锛?
//
// pill 褰紝鍥涚鍙樹綋锛歞efault / abyss / faint / tool銆?
// Token 鏉ヨ嚜 RedesignTheme.t.*銆?

import { RedesignTheme } from "../redesign_palette.slint";

export component Pill inherits Rectangle {
    in property <string> text: "";
    in property <string> variant: "default"; // "default" | "abyss" | "faint" | "tool"

    border-radius: 0px;
    border-width: 1px;

    background: root.variant == "abyss" ? RedesignTheme.t.abyss-500.with-alpha(0.10)
               : root.variant == "faint" ? RedesignTheme.t.raised
               : root.variant == "tool"  ? RedesignTheme.t.abyss-500.with-alpha(0.06)
               : RedesignTheme.t.raised;

    border-color: root.variant == "abyss" ? RedesignTheme.t.abyss-300.with-alpha(0.18)
                : root.variant == "faint" ? RedesignTheme.t.border
                : root.variant == "tool"  ? RedesignTheme.t.abyss-300
                : RedesignTheme.t.border;

    HorizontalLayout {
        padding-top: RedesignTheme.t.s1;
        padding-bottom: RedesignTheme.t.s1;
        padding-left: 10px;
        padding-right: 10px;

        Text {
            text: root.text;
            font-size: RedesignTheme.t.fs-md;
            color: root.variant == "abyss" ? RedesignTheme.t.abyss-500
                 : root.variant == "faint" ? RedesignTheme.t.muted
                 : root.variant == "tool"  ? RedesignTheme.t.abyss-500
                 : RedesignTheme.t.fg;
            font-family: root.variant == "tool" ? "JetBrains Mono" : "";
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
