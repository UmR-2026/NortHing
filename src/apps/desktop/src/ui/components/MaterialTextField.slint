// Material Text Field Component

import { RedesignTheme } from "../redesign_palette.slint";

export component MaterialTextField inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder: "";
    in property <bool> multi-line: false;
    in property <bool> disabled: false;
    in property <bool> password: false;  // 2026-06-26: obscure input for API keys (E2)
    in property <length> font-size: RedesignTheme.t.fs-body;

    callback accepted();
    callback edited();

    height: multi-line ? 80px : 48px;
    background: RedesignTheme.t.surface;
    border-radius: RedesignTheme.t.r-sm;
    border-width: 1px;
    border-color: RedesignTheme.t.fg;

    if text == "" && placeholder != "": Text {
        x: RedesignTheme.t.s2;
        y: RedesignTheme.t.s2;
        text: root.placeholder;
        font-size: root.font-size;
        color: RedesignTheme.t.faint;
        opacity: 0.5;
    }

    ti := TextInput {
        x: RedesignTheme.t.s2;
        y: RedesignTheme.t.s2;
        width: root.width - RedesignTheme.t.s4;
        height: root.height - RedesignTheme.t.s4;
        text <=> root.text;
        font-size: root.font-size;
        color: RedesignTheme.t.fg;
        wrap: multi-line ? word-wrap : no-wrap;
        input-type: root.password ? InputType.password : InputType.text;

        accepted => { root.accepted(); }
        edited => { root.edited(); }
    }

    states [
        focused when ti.has-focus: {
            root.border-color: RedesignTheme.t.rep-500;
            root.border-width: 2px;
        }
    ]
}
