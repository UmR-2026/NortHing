// Chat Message Bubble Component

import { RedesignTheme } from "../redesign_palette.slint";
import { MaterialCard } from "MaterialCard.slint";

export component ChatMessageBubble inherits Rectangle {
    in property <string> role: "user";
    in property <string> content: "";
    in property <string> timestamp: "";
    in property <bool> is-streaming: false;
    
    pure function bubble-color() -> color {
        if role == "user" { RedesignTheme.t.elevated; }
        else if role == "assistant" { RedesignTheme.t.surface; }
        else if role == "system" { RedesignTheme.t.muted; }
        else if role == "tool" { RedesignTheme.t.archive-card-bg; }
        else { RedesignTheme.t.surface; }
    }
    
    pure function text-color() -> color {
        // 真值 theme-system.html：用户气泡文字继承 fg（亮态白底近白字曾不可读）
        RedesignTheme.t.fg;
    }
    
    // padding is layout-only in Slint; use card-padding on MaterialCard instead
    // padding: RedesignTheme.t.s2;
    
    HorizontalLayout {
        alignment: role == "user" ? end : start;
        
        MaterialCard {
            width: root.width * 0.8;
            card-padding: RedesignTheme.t.s4;
            background: root.bubble-color();
            
            VerticalLayout {
                spacing: RedesignTheme.t.s1;
                
                Text {
                    text: root.content;
                    font-size: RedesignTheme.t.fs-body;
                    color: root.text-color();
                    wrap: word-wrap;
                }
                
                if is-streaming: Rectangle {
                    height: 2px;
                    background: RedesignTheme.t.rep-500;
                    
                    Rectangle {
                        width: 20px;
                        height: 2px;
                        background: RedesignTheme.t.abyss-500;
                        x: mod(animation-tick(), 1000ms) / 1000ms * (parent.width - 20px);
                    }
                }
                
                if timestamp != "": Text {
                    text: root.timestamp;
                    font-size: RedesignTheme.t.fs-md;
                    color: root.text-color();
                    opacity: 0.5;
                }
            }
        }
    }
}