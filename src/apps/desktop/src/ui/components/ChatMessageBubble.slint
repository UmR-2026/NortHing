import { RedesignTheme } from "../redesign_palette.slint";

export component ChatMessageBubble inherits Rectangle {
    in property <string> role: "user";
    in property <string> content: "";
    in property <string> timestamp: "";
    in property <bool> is-streaming: false;
    in property <bool> active: false;
    
    // .rec.entity 左对齐：.who + .body
    if role == "assistant": VerticalLayout {
        spacing: 8px;
        alignment: start;
        
        Text {
            // .who (mono 10px faint)
            // 档一：agent 代词着色 -> .who color mind-line 70% mixed with faint
            // Wait, "它" gets colored. 
            text: "它 · " + root.timestamp;
            font-family: "JetBrains Mono";
            font-size: 10px;
            letter-spacing: 0.8px;
            color: RedesignTheme.t.rep-500.with-alpha(0.7); // approximate mix
        }
        
        // .body
        Rectangle {
            background: RedesignTheme.t.surface; // Wait, bg2 is elevated? Let's use elevated
            border-width: 1px;
            border-color: RedesignTheme.t.border;
            border-radius: 4px;
            drop-shadow-color: RedesignTheme.t.shadow;
            drop-shadow-blur: 4px;
            drop-shadow-offset-y: 1px;
            
            // bevel top border
            Rectangle {
                y: 0px; height: 1px; width: parent.width;
                background: RedesignTheme.t.fg.with-alpha(0.06);
            }
            
            HorizontalLayout {
                padding-top: 12px; padding-bottom: 12px;
                padding-left: 14px; padding-right: 14px;
                Text {
                    text: root.content;
                    font-family: "Fraunces";
                    font-size: 15px;
                    color: RedesignTheme.t.fg; // .msg-agent
                    wrap: word-wrap;
                }
            }
        }
    }

    // .rec.witness 右对齐：.body (无背景框) + 右缘 2px 中性线
    if role == "user": HorizontalLayout {
        alignment: end;
        spacing: 10px;
        VerticalLayout {
            spacing: 8px;
            alignment: end;
            
            Text {
                text: "见证者 · " + root.timestamp;
                font-family: "JetBrains Mono";
                font-size: 10px;
                letter-spacing: 0.8px;
                color: RedesignTheme.t.faint;
                horizontal-alignment: right;
            }
            
            HorizontalLayout {
                alignment: end;
                Text {
                    text: root.content;
                    font-family: "Fraunces";
                    font-size: 15px;
                    font-italic: true;
                    color: RedesignTheme.t.muted;
                    wrap: word-wrap;
                    horizontal-alignment: right;
                }
            }
        }
        Rectangle { width: 2px; background: RedesignTheme.t.border; }
    }
}
