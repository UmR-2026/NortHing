import { RedesignTheme } from "../redesign_palette.slint";

export component ChronicleBar inherits Rectangle {
    // 暴露属性供后续任务绑定
    in property <color> birth: RedesignTheme.t.birth;
    in property <color> now: RedesignTheme.t.rep-500;
    
    // Five colors for demo: Coral, Purple, DeepBlue/Teal, SoftGreen, ColdCyan
    property <[color]> palette: [
        #C8714C, #8B5FBF, #3F837B, #46A758, #3A7B8C
    ];
    property <int> color-idx: 0;
    
    // For the ritual animation
    property <color> old-now: RedesignTheme.t.rep-500;
    property <color> current-now: RedesignTheme.t.rep-500;
    
    property <float> old-ratio: 1.0;
    
    height: 4px;
    opacity: 0.7;
    border-radius: 0px;

    // The new color background
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: @linear-gradient(90deg, root.birth 0%, root.current-now 100%);
    }

    // The old colors slowly shrinking
    Rectangle {
        width: parent.width * root.old-ratio;
        height: parent.height;
        x: 0px;
        background: @linear-gradient(90deg, root.birth 0%, root.old-now 100%);
    }

    animate old-ratio { duration: 1200ms; easing: ease-in-out; }

    TouchArea {
        width: parent.width;
        height: parent.height;
        double-clicked => {
            root.old-now = root.current-now;
            root.old-ratio = 1.0; 
            root.color-idx = Math.mod(root.color-idx + 1, 5);
            root.current-now = root.palette[root.color-idx];
            
            root.old-ratio = 0.65; 
        }
    }

    init => {
        // Mock ritual in progress
        root.old-now = root.palette[0];
        root.current-now = root.palette[1];
        root.old-ratio = 0.65;
    }
}
