// AirTint - 整屋空气染色
import { RedesignTheme } from "../redesign_palette.slint";
import { SystemConstants } from "../system_constants.slint";

export component AirTint inherits Rectangle {
    in property <bool> speaking: false;
    in property <bool> cold: false;

    background: root.cold
        ? RedesignTheme.t.fog-abyss
        : (root.speaking ? RedesignTheme.t.air-rep-speaking : RedesignTheme.t.air-rep);
    animate background { duration: 300ms; easing: ease-in-out; }

    // 顶晕 (global-aura)
    // 真值 L81: radial-gradient(circle 640px at 50% 200px, mind-glow 0%, transparent 74%)
    // + breath-aura 8s opacity 1 -> .65；亮色态不再 display:none (v5)
    // 尺寸按真值落地，亮态缩为 560px，暗态 640px。
    Rectangle {
        x: RedesignTheme.dark ? (parent.width - 1280px) / 2 : (parent.width - 1120px) / 2;
        y: RedesignTheme.dark ? 200px - 640px : 200px - 560px;
        width: RedesignTheme.dark ? 1280px : 1120px;
        height: RedesignTheme.dark ? 1280px : 1120px;
        
        property <color> halo-color: RedesignTheme.dark 
            ? (root.cold ? RedesignTheme.t.halo-abyss : (root.speaking ? RedesignTheme.t.mind-drive-intense : RedesignTheme.t.mind-drive-glow))
            : (root.cold ? RedesignTheme.t.mind-abyss-accent.with-alpha(0.08) : (root.speaking ? RedesignTheme.t.mind-drive-accent.with-alpha(0.12) : RedesignTheme.t.mind-drive-accent.with-alpha(0.08)));
            
        background: @radial-gradient(circle, halo-color 0%, halo-color.with-alpha(0) 74%);
        // 绑定顶晕呼吸 (8s 单钟 opacity 0.65..1.0)。亮暗统一呼吸，不再清零。
        opacity: SystemConstants.amp-aura;
        animate background { duration: 300ms; easing: ease-in-out; }
    }
}
