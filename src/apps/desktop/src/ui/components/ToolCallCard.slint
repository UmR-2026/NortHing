// Tool Call Card Component

import { RedesignTheme } from "../redesign_palette.slint";
import { MaterialCard } from "MaterialCard.slint";
import { MaterialIconButton } from "MaterialIconButton.slint";

export component ToolCallCard inherits Rectangle {
    in property <string> tool-name: "";
    in property <string> tool-params: "";
    in property <string> tool-result: "";
    in property <string> tool-status: "running";
    in property <bool> expanded: false;
    
    padding: RedesignTheme.t.s2;
    
    MaterialCard {
        width: parent.width - RedesignTheme.t.s4;
        card-padding: RedesignTheme.t.s4;
        background: RedesignTheme.t.surface;
        
        VerticalLayout {
            spacing: RedesignTheme.t.s2;
            
            HorizontalLayout {
                height: 36px;
                alignment: space-between;
                
                HorizontalLayout {
                    spacing: RedesignTheme.t.s2;
                    alignment: center;
                    
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: RedesignTheme.t.r-sm;
                        background: tool-status == "running" ? RedesignTheme.t.abyss-500
                                : tool-status == "completed" ? RedesignTheme.t.abyss-400
                                : RedesignTheme.t.danger;
                    }
                    
                    Text {
                        text: "🔧 " + root.tool-name;
                        font-size: RedesignTheme.t.fs-name;
                        color: RedesignTheme.t.fg;
                        font-weight: 600;
                    }
                }
                
                MaterialIconButton {
                    icon: expanded ? "▼" : "▶";
                    clicked => { root.expanded = !root.expanded; }
                }
            }
            
            if tool-params != "": Text {
                text: tool-params;
                font-size: RedesignTheme.t.fs-md;
                color: RedesignTheme.t.muted;
                opacity: 0.7;
                wrap: word-wrap;
                max-height: expanded ? 200px : 40px;
                overflow: elide;
            }
            
            if expanded && tool-result != "": Rectangle {
                height: 100px;
                background: RedesignTheme.t.abyss-500;
                border-radius: RedesignTheme.t.r-sm;
                padding: RedesignTheme.t.s2;
                
                Text {
                    text: root.tool-result;
                    font-size: RedesignTheme.t.fs-body;
                    color: RedesignTheme.t.muted;
                    font-family: "Consolas, monospace";
                    wrap: word-wrap;
                }
            }
        }
    }
}