// PresenceZone - 在场区：体温光晕 + 头像/名字/状态/编年史/心境语垂直居中列（FR-T4-2）。
//
// 结构与数值照 theme-system.html .presence（L58-70 / L210-217）+ 暗色光晕 L34：
//   padding 36px 0 20px / gap 8px / avatar 64×64 / p-name 18px w500 /
//   p-state 6px rep-500 呼吸点 + 文案 / p-chrono 140×4 / p-mood MoodText。
// 光晕用本批新增 token presence-halo-rep（亮 20% 暗 15%）/ presence-halo-rep-soft
// （亮 7% 暗 5%）；at 参数用 halo 自身宽高表达式（禁 %；halo 固定 520×340，
// parent.width/2 会误引 PresenceZone 宽进 halo 局部坐标）。
// Token 全部来自 RedesignTheme.t.*（redesign_palette.slint）。
import { RedesignTheme } from "../redesign_palette.slint";
import { AvatarWrap } from "AvatarWrap.slint";
import { ChronicleBar } from "ChronicleBar.slint";
import { MoodText } from "MoodText.slint";

export component PresenceZone inherits Rectangle {
    in property <bool> streaming: false;
    in property <string> agent-name: "知序";
    in property <string> mood-text: "";

    background: transparent;

    // ── presence::before 体温光晕（z 序最底，bleed 向上 -30px）──
    halo := Rectangle {
        width: 520px;
        height: 340px;
        x: (parent.width - halo.width) / 2;
        y: -30px;
        // at 50% 30% -> halo 自身宽高表达式（POC「禁 %」规则；固定盒，resize 不偏）
        property <length> cx: halo.width / 2;
        property <length> cy: halo.height * 0.3;
        background: @radial-gradient(circle at halo.cx halo.cy,
            RedesignTheme.t.presence-halo-rep 0%,
            RedesignTheme.t.presence-halo-rep-soft 30%,
            transparent 64%);
    }

    // ── 居中列：gap 8px，padding 36px 0 20px ──
    VerticalLayout {
        padding-top: 36px;
        padding-bottom: 20px;
        spacing: 8px;
        width: parent.width;

        // 1. AvatarWrap 64×64（breathing 绑 streaming；光环 auraBreath 机制已在组件内）
        HorizontalLayout {
            alignment: center;
            AvatarWrap {
                size: 64px;
                initial: "序";
                breathing: streaming;
            }
        }

        // 2. p-name：18px weight 500
        // TODO(FR-T5): Fraunces serif（可变字体未自托管，暂用默认字体）
        HorizontalLayout {
            alignment: center;
            Text {
                text: agent-name;
                font-size: 18px;
                font-weight: 500;
                color: RedesignTheme.t.fg;
            }
        }

        // 3. p-state：6px rep-500 呼吸点 + 文案
        //    streaming ->「生成回复中 · Ns」（N 每秒 +1，见下方计时），否则「在场」
        HorizontalLayout {
            alignment: center;
            spacing: 7px;

            // 呼吸点容器：撑满行高，内含 6px 居中圆点（参 PresenceBar 同款写法）
            Rectangle {
                width: 6px;
                height: 18px;
                background: transparent;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    y: (parent.height - 6px) / 2;
                    border-radius: RedesignTheme.t.r-pill;
                    background: RedesignTheme.t.rep-500;
                    // breathe 6s：opacity .65 <-> 1.0（@keyframes breathe）
                    opacity: 0.825 + 0.175 * Math.sin(animation-tick() / 6000ms * 360deg);
                }
            }

            Text {
                text: streaming ? ("生成回复中 · " + elapsed-secs + "s") : "在场";
                font-size: RedesignTheme.t.fs-md;
                color: RedesignTheme.t.muted;
                height: 18px;
                vertical-alignment: center;
            }
        }

        // 4. p-chrono：ChronicleBar 140×4
        HorizontalLayout {
            alignment: center;
            ChronicleBar {
                width: 140px;
                height: 4px;
            }
        }

        // 5. p-mood：MoodText（mood-text 非空用之，空则占位；i18n frozen 硬编码中文可接受）
        HorizontalLayout {
            alignment: center;
            MoodText {
                mood: mood-text != "" ? mood-text : "今天想安静地把这件事做透。";
            }
        }
    }

    // ── p-state 秒数计时（§3，纯 Slint：animation-tick() 驱动，streaming 上升沿记起点做差）──
    property <duration> stream-start: 0ms;
    init => {
        if (streaming) { root.stream-start = animation-tick(); }
    }
    changed streaming => {
        if (streaming) { root.stream-start = animation-tick(); }
    }
    property <int> elapsed-secs: streaming ? Math.floor((animation-tick() - root.stream-start) / 1000ms) : 0;
}
