// PresenceBar - 在场名片组合件（FR-T3b 名片系）：
// 左 AvatarWrap（breathing 随 streaming）+ 右[名字 / 状态行] + 下 ChronicleBar。
// 布局按任务 item-4；Token 全部来自 RedesignTheme.t.*（redesign_palette.slint）。
import { RedesignTheme } from "../redesign_palette.slint";
import { AvatarWrap } from "../components/AvatarWrap.slint";
import { ChronicleBar } from "../components/ChronicleBar.slint";
// MoodText 属名片系（item 3）；此处 import 以纳入 Slint 编译图（build.rs 仅编译
// main.slint 的传递 import，否则 MoodText 不被编译/校验），未在 item-4 布局中实例化。
import { MoodText } from "../components/MoodText.slint";

export component PresenceBar inherits Rectangle {
    in property <string> agent-name: "知序";
    in property <string> status-text: "在场";
    in property <bool> streaming: false;

    VerticalLayout {
        padding: RedesignTheme.t.s4;
        spacing: RedesignTheme.t.s4;

        // 上行：头像 + 名字/状态
        HorizontalLayout {
            spacing: RedesignTheme.t.s4;

            AvatarWrap {
                size: 44px;
                breathing: streaming;
            }

            VerticalLayout {
                spacing: RedesignTheme.t.s1;

                // 名字
                Text {
                    text: agent-name;
                    font-size: RedesignTheme.t.fs-name;
                    color: RedesignTheme.t.fg;
                    font-weight: 500;
                }

                // 状态行：呼吸点 + status-text
                HorizontalLayout {
                    spacing: RedesignTheme.t.s1;

                    // 呼吸点容器：撑满行高，内含 6px 居中圆点。
                    Rectangle {
                        width: 6px;
                        height: 18px;
                        background: transparent;
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            y: (parent.height - 6px) / 2;
                            border-radius: RedesignTheme.t.r-pill;
                            background: streaming ? RedesignTheme.t.rep-500 : RedesignTheme.t.muted;
                        }
                    }

                    Text {
                        text: status-text;
                        font-size: RedesignTheme.t.fs-md;
                        color: RedesignTheme.t.muted;
                        height: 18px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 下行：编年史条撑满宽
        ChronicleBar {
            width: parent.width;
        }
    }
}
