// MoodText - 心境语：挂载后淡入 + 6s 周期微弱呼吸的次级文本（FR-T3b 名片系）。
// Token 全部来自 RedesignTheme.t.*（redesign_palette.slint）。
import { RedesignTheme } from "../redesign_palette.slint";

export component MoodText inherits Text {
    in property <string> mood: "";

    text: mood;
    color: RedesignTheme.t.muted;
    font-size: RedesignTheme.t.fs-md;

    // fade: 挂载后从 0 淡入到 1（由 animate + init 驱动）。
    property <float> fade: 0;
    animate fade { duration: RedesignTheme.dur-once; }
    init => {
        root.fade = 1;
    };

    // 呼吸：基础 0.9 ± 0.05，6s 正弦周期。fade 控制淡入，breathing 叠加其上。
    // 设计依据：审计 §2.4 活跃轮差异化——MoodText 作为心境语需保持「活着」的视觉
    // 反馈，但不能抢夺用户注意力；±0.05 幅度（0.85–0.95）在可读性与生命感之间
    // 取得平衡，6s 周期与 AvatarWrap 呼吸一致，形成统一的节奏语言。
    opacity: (0.9 + 0.05 * Math.sin(animation-tick() / 6000ms * 360deg)) * root.fade;
}
