// Markdown Text Component (Simplified)

import { RedesignTheme } from "../redesign_palette.slint";

export component MarkdownText inherits Rectangle {
    in property <string> text: "";
    
    Text {
        text: root.text;
        font-size: RedesignTheme.t.fs-body;
        color: RedesignTheme.t.fg;
        wrap: word-wrap;
    }
}
