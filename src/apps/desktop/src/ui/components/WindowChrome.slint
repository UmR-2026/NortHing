// WindowChrome - 透明背景，左下品牌水印 + 左右把手 + 右上窗口控制按钮。
// FR-T3 前置；toggle-left/right 回调 FR-T3b 接线。
// FR-T3b: frameless 窗口自绘 −□× 三键，回调接 Rust window API。

import { RedesignTheme } from "../redesign_palette.slint";

export component WindowChrome inherits Rectangle {
    // 透明背景，仅覆盖内容
    background: transparent;

    // 抽屉状态（由 main.slint 传入，驱动箭头方向）
    in property<bool> inner-drawer-open: false;
    in property<bool> outer-drawer-open: false;

    // FR-T4-3: signal 占位属性，供左把手信号点使用；后续可由 main.slint 注入
    in property<bool> signal: false;

    // 左下品牌水印
    watermark := Text {
        x: 44px;
        y: parent.height - 22px - self.height;
        text: "NortHing";
        opacity: watermark-touch.has-hover ? 0.4 : 0.25;
        font-size: RedesignTheme.t.fs-md;
        color: RedesignTheme.t.faint;
        font-family: "Fraunces";
        animate opacity { duration: 200ms; easing: ease-in-out; }

        watermark-touch := TouchArea {
            width: parent.width;
            height: parent.height;
        }
    }

    // 左把手（28px 全高，垂直居中）
    left-handle := Rectangle {
        x: 0;
        y: 0;
        width: 28px;
        height: parent.height;
        background: transparent;

        // 渗光近似条（右缘，rep-300 → 透明）
        Rectangle {
            x: parent.width - 6px;
            y: 0;
            width: 6px;
            height: parent.height;
            background: @linear-gradient(90deg, transparent 0%, left-touch.has-hover ? RedesignTheme.t.rep-400 : RedesignTheme.t.rep-300 100%);
            animate background { duration: 200ms; easing: ease-in-out; }
        }

        // 信号点
        Rectangle {
            x: parent.width - 5px - 6px;
            y: 20px;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: RedesignTheme.t.rep-500;
            visible: root.signal;
        }

        VerticalLayout {
            alignment: center;
            spacing: 4px;

            Text {
                text: root.inner-drawer-open ? "‹" : "›";
                color: left-touch.has-hover ? RedesignTheme.t.fg : RedesignTheme.t.muted;
                font-size: RedesignTheme.t.fs-lg;
                horizontal-alignment: center;
                width: parent.width;
                animate color { duration: 200ms; easing: ease-in-out; }
            }

            Text {
                text: "内\n在";
                color: RedesignTheme.t.faint;
                font-size: RedesignTheme.t.fs-sm;
                horizontal-alignment: center;
                width: parent.width;
            }
        }

        left-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.toggle-left(); }
        }
    }

    // 右把手（28px 全高，垂直居中）
    Rectangle {
        x: parent.width - 28px;
        y: 0;
        width: 28px;
        height: parent.height;
        background: transparent;

        // 渗光近似条（左缘，abyss-300 → 透明）
        Rectangle {
            x: 0;
            y: 0;
            width: 6px;
            height: parent.height;
            background: @linear-gradient(90deg, right-touch.has-hover ? RedesignTheme.t.abyss-400 : RedesignTheme.t.abyss-300 0%, transparent 100%);
            animate background { duration: 200ms; easing: ease-in-out; }
        }

        VerticalLayout {
            alignment: center;
            spacing: 4px;

            Text {
                text: root.outer-drawer-open ? "›" : "‹";
                color: right-touch.has-hover ? RedesignTheme.t.fg : RedesignTheme.t.muted;
                font-size: RedesignTheme.t.fs-lg;
                horizontal-alignment: center;
                width: parent.width;
                animate color { duration: 200ms; easing: ease-in-out; }
            }

            Text {
                text: "外\n物";
                color: RedesignTheme.t.faint;
                font-size: RedesignTheme.t.fs-sm;
                horizontal-alignment: center;
                width: parent.width;
            }
        }

        right-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.toggle-right(); }
        }
    }

    // 右上窗口控制按钮：最小化 / 最大化还原 / 关闭。
    // FR-T3b: right 缩进 s6+s3(=44px) 让出把手渗光线，顶部 s3 带垂直居中。
    // 纯 RedesignTheme token，无硬编码 hex。
    Rectangle {
        x: parent.width - (RedesignTheme.t.s6 + RedesignTheme.t.s3)
            - (3 * 28px + 2 * 2px);
        y: 16px;
        width: 3 * 28px + 2 * 2px;
        height: 28px;
        background: transparent;

        // 最小化（−）
        Rectangle {
            x: 0;
            y: 0;
            width: 28px;
            height: 28px;
            border-radius: 7px;
            background: min-touch.has-hover ? RedesignTheme.t.raised : transparent;
            animate background { duration: 150ms; }

            min-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.window-minimize(); }
            }

            Text {
                text: "−";
                color: min-touch.has-hover ? RedesignTheme.t.fg : RedesignTheme.t.muted;
                font-size: RedesignTheme.t.fs-lg;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }

        // 最大化 / 还原（□）
        Rectangle {
            x: 30px;
            y: 0;
            width: 28px;
            height: 28px;
            border-radius: 7px;
            background: max-touch.has-hover ? RedesignTheme.t.raised : transparent;
            animate background { duration: 150ms; }

            max-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.window-maximize(); }
            }

            Text {
                text: "□";
                color: max-touch.has-hover ? RedesignTheme.t.fg : RedesignTheme.t.muted;
                font-size: RedesignTheme.t.fs-lg;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }

        // 关闭（×）
        Rectangle {
            x: 60px;
            y: 0;
            width: 28px;
            height: 28px;
            border-radius: 7px;
            background: close-touch.has-hover ? RedesignTheme.t.danger.with-alpha(0.18) : transparent;
            animate background { duration: 150ms; }

            close-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.window-close(); }
            }

            Text {
                text: "×";
                color: close-touch.has-hover ? RedesignTheme.t.danger : RedesignTheme.t.muted;
                font-size: RedesignTheme.t.fs-lg;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }
    }

    callback toggle-left();
    callback toggle-right();
    callback window-minimize();
    callback window-maximize();
    callback window-close();
}
