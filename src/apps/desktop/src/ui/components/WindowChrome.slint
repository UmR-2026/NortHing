import { RedesignTheme } from "../redesign_palette.slint";
import { SystemConstants } from "../system_constants.slint";

export component WindowChrome inherits Rectangle {
    background: transparent;

    in property<bool> inner-drawer-open: false;
    in property<bool> outer-drawer-open: false;
    in property<bool> signal: false;

    callback toggle-left();
    callback toggle-right();
    callback window-minimize();
    callback window-maximize();
    callback window-close();
    callback toggle-theme();

    // ˫߽ (Double border)
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-width: 1px;
        border-color: RedesignTheme.dark ? RedesignTheme.t.mind-drive-frame : RedesignTheme.t.border;

        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            border-width: 1px;
            border-color: RedesignTheme.t.border;
            visible: !RedesignTheme.dark;
        }
    }

    // Ĥ (Membrane frame)
    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-width: 1px;
        border-color: RedesignTheme.t.mind-drive-accent;
        opacity: SystemConstants.amp-membrane;
    }

    // ״̬/room-head ק (Status line / drag area)
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width - 150px;
        height: 48px;
        background: transparent;
        
        HorizontalLayout {
            x: 24px;
            y: 0;
            height: parent.height;
            alignment: start;
            spacing: 8px;

            Text {
                text: "northing";
                font-family: "Fraunces";
                font-italic: true;
                font-size: 12px;
                color: RedesignTheme.t.fg;
                vertical-alignment: center;
                opacity: 0.7;
            }
        }
    }

    // ӡ (Seal watermark)
    Text {
        x: 24px;
        y: parent.height - 24px - self.height;
        text: "northing";
        opacity: watermark-touch.has-hover ? 0.4 : 0.25;
        font-size: RedesignTheme.t.fs-md;
        color: RedesignTheme.t.faint;
        font-family: "Fraunces";
        animate opacity { duration: 200ms; easing: ease-in-out; }

        watermark-touch := TouchArea {
            width: parent.width;
            height: parent.height;
        }
    }

    // ϴڿưť (Window controls)
    Rectangle {
        x: parent.width - 140px;
        y: 8px;
        width: 120px;
        height: 28px;
        background: transparent;

        HorizontalLayout {
            alignment: end;
            spacing: 2px;
            
            // л (Theme switch: Sun)
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 3px;
                background: theme-touch.has-hover ? RedesignTheme.t.raised : transparent;
                animate background { duration: 150ms; }

                theme-touch := TouchArea {
                    clicked => { root.toggle-theme(); }
                }
                
                Path {
                    width: 14px;
                    height: 14px;
                    x: (parent.width - 14px) / 2;
                    y: (parent.height - 14px) / 2;
                    stroke: theme-touch.has-hover ? RedesignTheme.t.fg : RedesignTheme.t.muted;
                    stroke-width: 1px;
                    commands: "M 7 1 L 7 3 M 7 11 L 7 13 M 1 7 L 3 7 M 11 7 L 13 7 M 2.75 2.75 L 4.17 4.17 M 9.83 9.83 L 11.25 11.25 M 2.75 11.25 L 4.17 9.83 M 9.83 4.17 L 11.25 2.75";
                }
                Rectangle {
                    width: 6px;
                    height: 6px;
                    x: (parent.width - 6px) / 2;
                    y: (parent.height - 6px) / 2;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: theme-touch.has-hover ? RedesignTheme.t.fg : RedesignTheme.t.muted;
                }
            }

            // С (Minimize)
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 3px;
                background: min-touch.has-hover ? RedesignTheme.t.raised : transparent;
                animate background { duration: 150ms; }

                min-touch := TouchArea {
                    clicked => { root.window-minimize(); }
                }
                
                Rectangle {
                    x: (parent.width - 10px) / 2;
                    y: (parent.height - 1px) / 2;
                    width: 10px;
                    height: 1px;
                    background: min-touch.has-hover ? RedesignTheme.t.fg : RedesignTheme.t.muted;
                }
            }

            //  (Maximize)
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 3px;
                background: max-touch.has-hover ? RedesignTheme.t.raised : transparent;
                animate background { duration: 150ms; }

                max-touch := TouchArea {
                    clicked => { root.window-maximize(); }
                }
                
                Rectangle {
                    x: (parent.width - 10px) / 2;
                    y: (parent.height - 10px) / 2;
                    width: 10px;
                    height: 10px;
                    border-width: 1px;
                    border-color: max-touch.has-hover ? RedesignTheme.t.fg : RedesignTheme.t.muted;
                    background: transparent;
                }
            }

            // ر (Close)
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 3px;
                background: close-touch.has-hover ? RedesignTheme.t.danger.with-alpha(0.18) : transparent;
                animate background { duration: 150ms; }

                close-touch := TouchArea {
                    clicked => { root.window-close(); }
                }
                
                Path {
                    width: 10px;
                    height: 10px;
                    x: (parent.width - 10px) / 2;
                    y: (parent.height - 10px) / 2;
                    stroke: close-touch.has-hover ? RedesignTheme.t.danger : RedesignTheme.t.muted;
                    stroke-width: 1px;
                    commands: "M 0 0 L 10 10 M 0 10 L 10 0";
                }
            }
        }
    }
}
