// SegmentedControl - 通用分段控件
//
// 三种尺寸变体（当前实现 medium / large）：
//   size=0 medium：Provider 类型选择、MCP 传输方式（r-sm 圆角）
//   size=1 large ：Access 自治档 pill 形态（r-pill 圆角，选中态 rep-500）
//
// 设计真值：docs/design/2026-07-22-frontend-redesign/prototypes/*.html 中 .segments

import { RedesignTheme } from "../redesign_palette.slint";

export struct SegmentItem {
    label: string,
}

export component SegmentedControl inherits Rectangle {
    in property <[SegmentItem]> items;
    in property <int> selected-index: 0;
    in property <int> size: 0;  // 0=medium, 1=large
    callback selected(int);

    // ---- 尺寸派生 ----
    // medium: h=36px, pad=3px, gap=3px, r=r-sm, fs=fs-lg(13px)
    // large:  h=48px, pad=4px, gap=s1,   r=r-pill, fs=fs-body(15px)
    private property <length> container-height: root.size == 1 ? 48px : 36px;
    private property <length> container-pad: root.size == 1 ? 4px : 3px;
    private property <length> item-gap: root.size == 1 ? RedesignTheme.t.s1 : 3px;
    private property <length> item-radius: root.size == 1 ? RedesignTheme.t.r-pill : RedesignTheme.t.r-sm;
    private property <length> item-font-size: root.size == 1 ? RedesignTheme.t.fs-body : RedesignTheme.t.fs-lg;

    height: container-height;
    border-radius: item-radius;
    background: RedesignTheme.t.raised;
    border-width: 1px;
    border-color: RedesignTheme.t.border;

    HorizontalLayout {
        x: container-pad;
        y: container-pad;
        width: parent.width - container-pad * 2;
        height: parent.height - container-pad * 2;
        spacing: item-gap;

        for item[idx] in root.items: Rectangle {
            horizontal-stretch: 1;
            height: parent.height;
            border-radius: item-radius;
            background: root.selected-index == idx
                ? RedesignTheme.t.elevated
                : transparent;
            drop-shadow-color: root.selected-index == idx
                ? RedesignTheme.t.shadow.with-alpha(0.06)
                : transparent;
            drop-shadow-blur: root.selected-index == idx ? 2px : 0px;
            drop-shadow-offset-y: root.selected-index == idx ? 1px : 0px;
            animate background { duration: 200ms; easing: ease-in-out; }

            Text {
                text: item.label;
                // large 变体选中态用 rep-500；其余选中态用 fg；未选中均用 muted
                color: root.size == 1 && root.selected-index == idx
                    ? RedesignTheme.t.rep-500
                    : (root.selected-index == idx
                        ? RedesignTheme.t.fg
                        : RedesignTheme.t.muted);
                font-size: item-font-size;
                font-weight: root.selected-index == idx ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                animate color { duration: 200ms; easing: ease-in-out; }
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.selected(idx); }
            }
        }
    }
}
