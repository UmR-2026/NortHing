import { RedesignTheme } from "../redesign_palette.slint";
import { AppStrings } from "../strings.slint";
import { AvatarWrap } from "AvatarWrap.slint";
import { ChronicleBar } from "ChronicleBar.slint";
import { SystemConstants } from "../system_constants.slint";

export component RoomHead inherits Rectangle {
    in-out property <bool> folded: false;
    in property <string> state-text: AppStrings.room-head-state-text;
    in property <bool> dark-mode: true;
    // T3：灰寂创世态（onboarding 路由）。true 时 avatar 走虚线框 + 灰底（data-inhabited=false），
    // 顶晕用灰 15% rep 派生（gray 阶段无色相）。默认 false，对 T2 主诊室无回归。
    in property <bool> gray-state: false;
    // T3：灰寂态 avatar 名字 + 首字（创世未命名）。默认沿用主诊室 AppStrings。
    in property <string> name-text: AppStrings.room-head-name;
    in property <string> initial-text: AppStrings.room-head-initial;
    // T3：灰寂态 mind 色（--mind-base #7e8896 灰）。选中后由 WelcomeView 改写为选中色 token。
    in property <color> mind-base: #7e8896;
    callback toggle-fold();

    // C-6: 暴露 avatar 中线 relative to RoomHead top
    out property <length> avatar-mid-y: root.folded ? 21px : 52px;

    // 状态行兼作窗口拖拽区（T1 已知无 Rust FFI，留 TODO 注释）
    // TODO: add window drag

    property <length> cx: root.width / 2;

    // T3：灰寂态用 mind-base 灰派生顶晕（无色相）；主诊室态沿用 rep-500。
    property <color> aura-color: root.gray-state ? root.mind-base : RedesignTheme.t.rep-500;

    background: root.folded
        ? @linear-gradient(90deg, transparent 0%, aura-color.with-alpha(0.15) 50%, transparent 100%)
        : @radial-gradient(circle, aura-color.with-alpha(0.15) 0%, transparent 78%);

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        // T3：灰寂态缝线用 mind-base 16%；主诊室态沿用 mind-drive-frame token。
        background: root.gray-state ? root.mind-base.with-alpha(0.16) : RedesignTheme.t.mind-drive-frame;
    }

    // C4 修复：整块 TouchArea 触发 toggle-fold（click 覆 RoomHead 全宽）。
    // 直接翻转 folded（in-out），无需外部 Rust 回调即可交互。
    // T2b: 收纳按钮必须在 TouchArea 之上（z-order），故 TouchArea 排在前面
    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.folded = !root.folded;
            root.toggle-fold();
        }
    }

    // T2b / T2c: 收纳按钮 (head-fold)
    // C-3: 无论 folded 与否都常显（去掉 if !root.folded 限制），只切 ▴/▾ 符号。
    // C-4: 亮态 opacity 提至 0.7（暗态 0.35），hover 统一 0.95。
    Rectangle {
        x: parent.width - 66px;
        y: parent.height - 26px;
        width: 52px;
        height: 18px;
        border-width: 1px;
        border-radius: 3px;
        border-color: fold-ta.has-hover ? RedesignTheme.t.mind-drive-accent : RedesignTheme.t.border;
        background: fold-ta.has-hover ? RedesignTheme.t.elevated : transparent;
        opacity: fold-ta.has-hover ? 0.95 : (RedesignTheme.dark ? 0.35 : 0.7);
        animate opacity, background, border-color { duration: 200ms; }

        Text {
            text: root.folded ? AppStrings.room-head-unfold : AppStrings.room-head-fold;
            font-family: "JetBrains Mono";
            font-size: 10px;
            color: fold-ta.has-hover ? RedesignTheme.t.mind-drive-line : RedesignTheme.t.muted;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }

        fold-ta := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => {
                root.folded = !root.folded;
                root.toggle-fold();
            }
        }
    }

    // Folded layout
    if root.folded: HorizontalLayout {
        padding-top: 8px;
        padding-bottom: 8px;
        padding-left: 18px;
        padding-right: 18px;
        alignment: center;
        spacing: 12px;

        // T3：灰寂态用虚线感头像（data-inhabited=false）。
        // Slint Rectangle border 无 dash；用 1px mind-base 边框 + 灰底径向近似虚线观感
        // （真值 dashed border + box-shadow:none 已由灰 mind-base + 无光环表达）。
        if root.gray-state: Rectangle {
            width: 26px;
            height: 26px;
            border-radius: 0px;
            border-width: 1px;
            border-color: root.mind-base;
            background: @radial-gradient(circle, root.mind-base.with-alpha(0.4) 0%, transparent 74%);
            Text {
                text: root.initial-text;
                color: root.mind-base.with_alpha(0.7);
                font-family: "Fraunces";
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }
        if !root.gray-state: AvatarWrap {
            size: 26px;
            initial: root.initial-text;
            breathing: true;
        }

        Text {
            text: root.name-text;
            font-family: "Fraunces";
            font-size: 13px;
            font-italic: true;
            color: RedesignTheme.t.fg;
            vertical-alignment: center;
        }
    }

    // Unfolded layout
    if !root.folded: VerticalLayout {
        padding-top: 26px;
        padding-bottom: 16px;
        padding-left: 18px;
        padding-right: 18px;
        alignment: center;
        spacing: 8px;

        HorizontalLayout {
            alignment: center;
            // T3：灰寂态虚线感头像（52px，1px mind-base 边框 + 灰底径向 + 无 box-shadow）。
            if root.gray-state: Rectangle {
                width: 52px;
                height: 52px;
                border-radius: 0px;
                border-width: 1px;
                border-color: root.mind-base;
                background: @radial-gradient(circle, root.mind-base.with-alpha(0.4) 0%, transparent 74%);
                // 状态点 opacity 跟 8s 单钟（gray 阶段仍呼吸）。
                opacity: SystemConstants.amp-avatar;
                Text {
                    text: root.initial-text;
                    color: root.mind-base.with_alpha(0.7);
                    font-family: "Fraunces";
                    font-size: 22px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
            if !root.gray-state: AvatarWrap {
                size: 52px;
                initial: root.initial-text;
                breathing: true;
            }
        }

        HorizontalLayout {
            alignment: center;
            Text {
                text: root.name-text;
                font-family: "Fraunces";
                font-size: 17px;
                font-italic: true;
                color: RedesignTheme.t.fg;
            }
        }

        HorizontalLayout {
            alignment: center;
            // T3：灰寂态编年史条用 mind-base 灰（birth->mind-base）；主诊室态沿用默认。
            ChronicleBar {
                width: 200px;
                height: 4px;
                opacity: 0.7;
                now: root.gray-state ? root.mind-base : RedesignTheme.t.mind-drive-accent;
            }
        }

        HorizontalLayout {
            alignment: center;
            // C-2 / T3: state pill (border-radius: 0, mind-drive-accent 22%)
            if !root.folded: Rectangle {
                border-radius: 0px;
                background: root.gray-state
                    ? root.mind-base.with-alpha(0.4)
                    : RedesignTheme.t.mind-drive-accent.with-alpha(0.22);

                HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    padding-top: 3px;
                    padding-bottom: 3px;
                    Text {
                        text: root.state-text;
                        font-family: "JetBrains Mono";
                        font-size: 10px;
                        // T3：灰寂态 mind-line 用 mind-base 70%+白；主诊室态沿用 token。
                        color: root.gray-state ? root.mind-base.with_alpha(0.9) : RedesignTheme.t.mind-drive-line;
                        letter-spacing: 0.8px;
                    }
                }
            }
        }
    }
}
