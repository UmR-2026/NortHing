import { RedesignTheme } from "../redesign_palette.slint";
import { AppStrings } from "../strings.slint";
import { AvatarWrap } from "AvatarWrap.slint";
import { ChronicleBar } from "ChronicleBar.slint";
import { SystemConstants } from "../system_constants.slint";

export component RoomHead inherits Rectangle {
    in-out property <bool> folded: false;
    in property <string> state-text: AppStrings.room-head-state-text;
    in property <bool> dark-mode: true;
    callback toggle-fold();

    // 状态行兼作窗口拖拽区（T1 已知无 Rust FFI，留 TODO 注释）
    // TODO: add window drag

    property <length> cx: root.width / 2;

    background: root.folded
        ? @linear-gradient(90deg, transparent 0%, RedesignTheme.t.rep-500.with-alpha(0.15) 50%, transparent 100%)
        : @radial-gradient(circle, RedesignTheme.t.rep-500.with-alpha(0.15) 0%, transparent 78%);

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        // I6 修复：缝线 16% mind 色用 mind token（mind-drive-line）近似，非硬编码 hex。
        background: RedesignTheme.t.mind-drive-frame;
    }

    // C4 修复：整块 TouchArea 触发 toggle-fold（click 覆 RoomHead 全宽）。
    // 直接翻转 folded（in-out），无需外部 Rust 回调即可交互。
    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.folded = !root.folded;
            root.toggle-fold();
        }
    }

    // Folded layout
    if root.folded: HorizontalLayout {
        padding-top: 8px;
        padding-bottom: 8px;
        padding-left: 18px;
        padding-right: 18px;
        alignment: center;
        spacing: 12px;

        AvatarWrap {
            size: 26px;
            initial: AppStrings.room-head-initial;
            breathing: true;
        }

        Text {
            text: AppStrings.room-head-name;
            font-family: "Fraunces";
            font-size: 13px;
            font-italic: true;
            color: RedesignTheme.t.fg;
            vertical-alignment: center;
        }
    }

    // Unfolded layout
    if !root.folded: VerticalLayout {
        padding-top: 26px;
        padding-bottom: 16px;
        padding-left: 18px;
        padding-right: 18px;
        alignment: center;
        spacing: 8px;

        HorizontalLayout {
            alignment: center;
            AvatarWrap {
                size: 52px;
                initial: AppStrings.room-head-initial;
                breathing: true;
            }
        }

        HorizontalLayout {
            alignment: center;
            Text {
                text: AppStrings.room-head-name;
                font-family: "Fraunces";
                font-size: 17px;
                font-italic: true;
                color: RedesignTheme.t.fg;
            }
        }

        HorizontalLayout {
            alignment: center;
            ChronicleBar {
                width: 200px;
                height: 4px;
                opacity: 0.7;
            }
        }

        HorizontalLayout {
            alignment: center;
            Rectangle {
                background: RedesignTheme.t.rep-500.with-alpha(0.22);

                HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    padding-top: 3px;
                    padding-bottom: 3px;
                    Text {
                        text: root.state-text;
                        font-family: "JetBrains Mono";
                        font-size: 10px;
                        // I6 修复：mind-line 用 token，非硬编码 hex。
                        color: RedesignTheme.t.mind-drive-line;
                        letter-spacing: 0.8px;
                    }
                }
            }
        }
    }
}
