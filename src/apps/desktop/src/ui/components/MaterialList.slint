// Material List Item Component

import { RedesignTheme } from "../redesign_palette.slint";

export component MaterialListItem inherits Rectangle {
    in property <string> text: "";
    in property <string> secondary-text: "";
    in property <bool> selected: false;
    in property <bool> selectable: true;
    
    callback clicked();
    
    height: 48px;
    background: selected ? RedesignTheme.t.rep-500 : transparent;
    border-radius: RedesignTheme.t.r-sm;
    
    VerticalLayout {
        padding: RedesignTheme.t.s2;
        alignment: center;
        
        Text {
            text: root.text;
            font-size: RedesignTheme.t.fs-body;
            color: selected ? RedesignTheme.t.on-rep : RedesignTheme.t.fg;
        }
        
        if secondary-text != "": Text {
            text: root.secondary-text;
            font-size: RedesignTheme.t.fs-md;
            color: selected ? RedesignTheme.t.on-rep : RedesignTheme.t.muted;
            opacity: 0.6;
        }
    }
    
    ta := TouchArea {
        enabled: root.selectable;
        clicked => { root.clicked(); }
    }
    
    states [
        hover when ta.has-hover && !selected: {
            root.background: RedesignTheme.t.muted;
            root.opacity: 0.05;
        }
    ]
}
