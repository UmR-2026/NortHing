// InnerDrawer - 左抽屉「内在」壳（T4-3）

import { RedesignTheme } from "../redesign_palette.slint";

export component InnerDrawer inherits Rectangle {
    in property<bool> open: false;
    callback close();
    callback open-archive();
    callback export-markdown();

    // 透明遮罩
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000;
        opacity: root.open ? 0.5 : 0;

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.close(); }
        }
    }

    // 抽屉面板（320px 全高，从左侧滑入）
    Rectangle {
        x: root.open ? 0px : -320px;
        y: 0;
        width: 320px;
        height: parent.height;
        background: RedesignTheme.t.surface;
        border-width: 1px;
        border-color: RedesignTheme.t.border;
        drop-shadow-color: #00000040;
        drop-shadow-blur: 8px;
        drop-shadow-offset-x: 4px;

        animate x { duration: 250ms; easing: ease-in-out; }

        VerticalLayout {
            padding: RedesignTheme.t.s4;
            spacing: RedesignTheme.t.s3;

            // 头部：「内在」+ 关闭 ×
            HorizontalLayout {
                alignment: center;
                spacing: RedesignTheme.t.s3;

                Text {
                    text: "内在";
                    color: RedesignTheme.t.fg;
                    font-size: RedesignTheme.t.fs-lg;
                    vertical-alignment: center;
                }

                TouchArea {
                    width: 24px;
                    height: 24px;
                    clicked => { root.close(); }

                    Text {
                        text: "×";
                        color: RedesignTheme.t.muted;
                        font-size: RedesignTheme.t.fs-lg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }

            // 自我认知卡
            Rectangle {
                background: RedesignTheme.t.elevated;
                border-radius: RedesignTheme.t.r-md;
                border-width: 1px;
                border-color: RedesignTheme.t.border;

                VerticalLayout {
                    padding: RedesignTheme.t.s3;
                    spacing: RedesignTheme.t.s2;

                    Text {
                        text: "知序";
                        color: RedesignTheme.t.fg;
                        font-size: RedesignTheme.t.fs-name;
                        // TODO(T4-6): 接 identity prop 替代硬编码
                    }

                    Text {
                        text: "自我认知摘要待接入 identity.md";
                        color: RedesignTheme.t.faint;
                        font-size: RedesignTheme.t.fs-sm;
                    }

                    TouchArea {
                        clicked => { /* TODO(T4-6): 本批不跳设置，接入后接 settings 路由 */ }

                        Text {
                            text: "查看 →";
                            color: RedesignTheme.t.rep-500;
                            font-size: RedesignTheme.t.fs-sm;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // 档案册入口行
            Rectangle {
                background: RedesignTheme.t.raised;
                border-radius: RedesignTheme.t.r-sm;

                // TODO(T4-4): T4-4 启用后移除 opacity: 0.5
                HorizontalLayout {
                    padding: RedesignTheme.t.s3;
                    alignment: center;

                    Text {
                        text: "档案册 →";
                        color: RedesignTheme.t.fg;
                        font-size: RedesignTheme.t.fs-body;
                    }
                }
            }

            // 导出当前会话 Markdown 入口行
            Rectangle {
                background: RedesignTheme.t.raised;
                border-radius: RedesignTheme.t.r-sm;

                HorizontalLayout {
                    padding: RedesignTheme.t.s3;
                    alignment: center;

                    Text {
                        text: "导出当前会话 Markdown";
                        color: RedesignTheme.t.fg;
                        font-size: RedesignTheme.t.fs-body;
                    }
                }

                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.export-markdown(); root.close(); }
                }
            }
        }
    }
}
