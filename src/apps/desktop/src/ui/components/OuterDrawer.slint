import { SkillItem } from "../theme.slint";
export component OuterDrawer inherits Rectangle {
    in property<bool> open: false;
    in property<[SkillItem]> skills: [];
    in property<string> mcp-status: "";
    in property<bool> dark-mode: false;
    callback close();
    callback toggle-skill(string);
    callback toggle-theme();
    callback open-session-settings();
}
