// ToggleSwitch — 可复用的开关组件
// 两种尺寸：默认 44×24（通用页）、small=true 36×20（卡片内）
// 设计真值：settings-general.html / settings-models.html .toggle

import { RedesignTheme } from "../redesign_palette.slint";

export component ToggleSwitch inherits Rectangle {
    in-out property <bool> value: false;
    in property <bool> small: false;
    in property <bool> disabled: false;
    callback toggled(bool);

    width: root.small ? 36px : 44px;
    height: root.small ? 20px : 24px;
    border-radius: RedesignTheme.t.r-pill;
    background: root.value
        ? RedesignTheme.t.rep-500
        : RedesignTheme.t.border;
    opacity: root.disabled ? 0.5 : 1.0;
    animate background { duration: 200ms; easing: ease-in-out; }

    // 滑块
    Rectangle {
        width: root.small ? 16px : 18px;
        height: root.small ? 16px : 18px;
        y: root.small ? 2px : 3px;
        x: root.value
            ? (root.small ? 18px : 23px)
            : (root.small ? 2px : 3px);
        border-radius: RedesignTheme.t.r-pill;
        background: RedesignTheme.t.surface;
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000010;
        animate x { duration: 200ms; easing: ease-in-out; }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: !root.disabled;
        clicked => {
            root.value = !root.value;
            root.toggled(root.value);
        }
    }
}
