// DeckBar - v4 合一按钮 + 见证注 + 上下文收纳
import { RedesignTheme } from "../redesign_palette.slint";

export component DeckBar inherits Rectangle {
    in-out property <string> text: "";
    in property <bool> streaming: false;
    in property <string> placeholder: "向它描述你观察到的现象…";
    in property <string> model-name: "";
    in property <bool> disabled: false;
    in property <string> workspace-name: "";
    
    out property <bool> focused: ti.has-focus;
    callback send();
    callback stop();
    callback model-clicked();
    callback settings-clicked();

    background: RedesignTheme.t.surface;
    border-color: #433E3E; // 档三缝线 16% mind 色 (approx for dark mode, ignoring dynamic light mode for this mock or use a constant)
    border-width: 1px;

    VerticalLayout {
        padding: 10px;
        padding-left: 16px;
        padding-right: 16px;
        padding-bottom: 12px;
        spacing: 8px;

        // witness-row
        HorizontalLayout {
            padding: 0px;
            alignment: stretch;
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: "你的言辞将被记录为见证";
                font-family: "JetBrains Mono";
                font-size: 10px;
                letter-spacing: 0.8px;
                color: RedesignTheme.t.faint;
                horizontal-alignment: right;
            }
        }

        // input-row
        HorizontalLayout {
            spacing: 10px;
            alignment: center;
            height: 38px;

            // attach +
            TouchArea {
                width: attach-txt.width;
                height: parent.height;
                attach-txt := Text {
                    text: "@ 文件";
                    font-family: "JetBrains Mono";
                    font-size: 10px;
                    color: RedesignTheme.t.rep-500;
                    vertical-alignment: center;
                }
            }

            // input-box
            Rectangle {
                horizontal-stretch: 1;
                border-width: 1px;
                border-color: ti.has-focus ? RedesignTheme.t.rep-500 : RedesignTheme.t.border;
                border-radius: 4px;
                background: RedesignTheme.t.elevated;
                animate border-color { duration: 200ms; }

                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 9px; padding-bottom: 9px;
                    ti := TextInput {
                        horizontal-stretch: 1;
                        height: parent.height;
                        text <=> root.text;
                        font-size: 13px;
                        color: RedesignTheme.t.muted;
                        wrap: word-wrap;
                        enabled: !root.disabled;
                        accepted => { root.send(); }
                    }
                    if ti.has-focus: Rectangle {
                        width: 7px; height: 13px;
                        background: RedesignTheme.t.rep-500;
                        y: (parent.height - self.height) / 2;
                        opacity: Math.mod(animation-tick() / 1000ms, 1) < 0.5 ? 1 : 0.15;
                    }
                }
                if root.text == "" && !ti.has-focus: Text {
                    x: 13px; // Absolute positioning relative to the Rectangle, outside the layout
                    y: 9px;
                    text: root.placeholder;
                    font-size: 13px;
                    color: RedesignTheme.t.muted;
                    opacity: 0.5;
                }
            }

            // send button
            ta := TouchArea {
                width: 38px;
                height: 28px;
                clicked => {
                    if root.streaming {
                        root.stop();
                    } else {
                        root.send();
                    }
                }
                
                Rectangle {
                    width: root.streaming ? 38px : 0px; // streaming 态是按钮形状
                    height: parent.height;
                    border-width: root.streaming ? 1px : 0px;
                    border-color: root.streaming ? RedesignTheme.t.danger : transparent;
                    border-radius: 4px;
                    background: root.streaming && ta.has-hover ? RedesignTheme.t.danger : transparent;

                    Text {
                        text: root.streaming ? "■" : "➤";
                        font-size: root.streaming ? 11px : 14px;
                        color: root.streaming 
                            ? (parent.background == transparent ? RedesignTheme.t.danger : #ffffff) 
                            : (ta.has-hover ? RedesignTheme.t.rep-500 : RedesignTheme.t.muted);
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }
        }
    }
}
