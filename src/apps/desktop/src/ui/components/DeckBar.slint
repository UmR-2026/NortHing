// DeckBar - v4 合一按钮 + 见证注 + 上下文收纳
import { RedesignTheme } from "../redesign_palette.slint";
import { AppStrings } from "../strings.slint";

export component DeckBar inherits Rectangle {
    in-out property <string> text: "";
    in property <bool> streaming: false;
    in property <string> placeholder: AppStrings.deck-input-placeholder;
    in property <string> model-name: "";
    in property <bool> disabled: false;
    in property <string> workspace-name: "";

    out property <bool> focused: ti.has-focus;
    callback send();
    callback stop();
    callback model-clicked();
    callback settings-clicked();

    background: RedesignTheme.t.surface;
    // I6/m5 修复：档三缝线 16% mind 色用 mind token；绑 dark-mode 经 RedesignTheme.dark 间接（mind-drive-frame 双主题已派生）。
    border-color: RedesignTheme.t.mind-drive-frame;
    border-width: 1px;

    VerticalLayout {
        padding: 10px;
        padding-left: 16px;
        padding-right: 16px;
        padding-bottom: 12px;
        spacing: 8px;

        // witness-row
        HorizontalLayout {
            padding: 0px;
            alignment: stretch;
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: AppStrings.deck-witness-note;
                font-family: "JetBrains Mono";
                font-size: 10px;
                letter-spacing: 0.8px;
                color: RedesignTheme.t.faint;
                horizontal-alignment: right;
            }
        }

        // input-row
        HorizontalLayout {
            spacing: 10px;
            height: 38px;

            // attach +
            TouchArea {
                width: attach-txt.width;
                height: parent.height;
                // 真值 L190: .attach { font-mono; 10px; color: var(--mind-line); }
                attach-txt := Text {
                    text: AppStrings.deck-attach;
                    font-family: "JetBrains Mono";
                    font-size: 10px;
                    color: RedesignTheme.t.mind-drive-line;
                    vertical-alignment: center;
                }
            }

            // input-box（真值 L191-192: focus/hover border-color var(--accent-solid) = mind-base）
            Rectangle {
                horizontal-stretch: 1;
                border-width: 1px;
                border-color: (ti.has-focus || box-ta.has-hover) ? RedesignTheme.t.mind-drive-accent : RedesignTheme.t.border;
                border-radius: 4px;
                background: RedesignTheme.t.elevated;
                animate border-color { duration: 200ms; }

                box-ta := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => { ti.focus(); }
                }

                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 9px; padding-bottom: 9px;
                    if root.text == "" && !ti.has-focus: Text {
                        text: root.placeholder;
                        font-size: 13px;
                        color: RedesignTheme.t.muted;
                        opacity: 0.5;
                        vertical-alignment: center;
                    }
                    ti := TextInput {
                        horizontal-stretch: 1;
                        height: parent.height;
                        text <=> root.text;
                        font-size: 13px;
                        color: RedesignTheme.t.muted;
                        wrap: word-wrap;
                        enabled: !root.disabled;
                        accepted => { root.send(); }
                    }
                    if ti.has-focus: Rectangle {
                        width: 7px; height: 13px;
                        background: RedesignTheme.t.mind-drive-accent;
                        y: (parent.height - self.height) / 2;
                        opacity: Math.mod(animation-tick() / 1000ms, 1) < 0.5 ? 1 : 0.15;
                    }
                }
            }

            // send button
            send-btn := Rectangle {
                width: 32px;
                height: 28px;
                border-radius: 4px;
                border-width: root.streaming ? 1px : 0px;
                border-color: root.streaming ? RedesignTheme.t.danger : transparent;
                background: root.streaming && send-ta.has-hover ? RedesignTheme.t.danger : transparent;
                animate background, border-color { duration: 150ms; }

                if root.streaming: Rectangle {
                    width: 7px; height: 7px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    background: send-ta.has-hover ? #ffffff : RedesignTheme.t.danger;
                }

                if !root.streaming: Path {
                    width: 13px; height: 13px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    stroke: send-ta.has-hover ? RedesignTheme.t.mind-drive-line : RedesignTheme.t.muted;
                    stroke-width: 1px;
                    commands: "M 1.2 6.5 L 11.8 6.5 M 6.6 1.3 L 11.8 6.5 L 6.6 11.7";
                }

                send-ta := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => {
                        if root.streaming {
                            root.stop();
                        } else {
                            root.send();
                        }
                    }
                }
            }
        }
    }
}
