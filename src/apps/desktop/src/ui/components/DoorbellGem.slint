import { RedesignTheme } from "../redesign_palette.slint";
import { SystemConstants } from "../system_constants.slint";

export component DoorbellGem inherits Rectangle {
    in property <bool> is-left: true;
    in property <bool> is-open: false;
    in property <color> base-color: RedesignTheme.t.rep-500;
    in property <string> tooltip: "瀹冪殑鍐呭湪";
    callback toggle();

    width: 12px;
    height: 64px;
    
    // The "鏂彛" (break) to cover the border of the room box
    Rectangle {
        width: 2px;
        height: 64px;
        x: root.is-left ? 0px : parent.width - 2px;
        background: RedesignTheme.t.surface;
    }
    
    // The Gem itself
    gem := Rectangle {
        width: 12px;
        height: 12px;
        x: 0px;
        y: (parent.height - self.height) / 2;
        // rotation-angle: root.is-open ? 0deg : 45deg;
        border-width: root.is-open ? 1px : 6px; // 6px fills it completely
        border-color: root.base-color;
        background: transparent;
        opacity: root.is-open ? 0.22 : 0.55;
        
        animate border-width, opacity { duration: 350ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
    }
    
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.toggle(); }
        
        // Hover label
        if self.has-hover: Rectangle {
            x: root.is-left ? 20px : -50px;
            y: (parent.height - 18px) / 2;
            width: 46px;
            height: 18px;
            background: RedesignTheme.t.bg;
            border-width: 1px;
            border-color: RedesignTheme.t.border;
            border-radius: 2px;
            Text {
                text: root.tooltip;
                font-family: "JetBrains Mono";
                font-size: 9px;
                color: RedesignTheme.t.fg;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width; height: parent.height;
            }
        }
    }
    
    // Add hover opacity change
    states [
        hover when ta.has-hover: {
            gem.opacity: 0.95;
        }
    ]
}
