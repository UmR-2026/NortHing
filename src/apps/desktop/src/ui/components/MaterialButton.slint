// Material Button Component

import { RedesignTheme } from "../redesign_palette.slint";

export component MaterialButton inherits Rectangle {
    in property <string> text: "Button";
    in property <bool> primary: true;
    in property <bool> disabled: false;
    in property <length> font-size: RedesignTheme.t.fs-body;
    
    callback clicked();
    
    height: 36px;
    border-radius: RedesignTheme.t.r-sm;
    background: disabled ? RedesignTheme.t.muted : (primary ? RedesignTheme.t.rep-500 : transparent);
    border-width: primary ? 0px : 1px;
    border-color: disabled ? RedesignTheme.t.faint : RedesignTheme.t.rep-500;
    
    drop-shadow-color: primary ? RedesignTheme.t.shadow.with_alpha(0.25) : transparent;
    drop-shadow-blur: primary ? 2px : 0px;
    drop-shadow-offset-y: primary ? 1px : 0px;
    
    Text {
        text: root.text;
        font-size: root.font-size;
        color: disabled ? RedesignTheme.t.faint : (primary ? RedesignTheme.t.on-rep : RedesignTheme.t.rep-500);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    
    ta := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
    
    states [
        hover when ta.pressed: {
            root.opacity: 0.8;
        }
    ]
}
