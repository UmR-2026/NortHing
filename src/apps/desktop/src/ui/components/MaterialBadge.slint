// Material Badge Component

import { RedesignTheme } from "../redesign_palette.slint";

export component MaterialBadge inherits Rectangle {
    in property <string> text: "";
    in property <color> background-color: RedesignTheme.t.danger;
    
    width: 24px;
    height: 16px;
    background: background-color;
    border-radius: RedesignTheme.t.r-md;
    
    Text {
        text: root.text;
        font-size: RedesignTheme.t.fs-md;
        color: RedesignTheme.t.on-danger;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
