import { RedesignTheme } from "../redesign_palette.slint";

export component MindMod inherits Rectangle {
    in property <bool> is-open: false;
    in-out property <length> drag-x: 0px;
    in-out property <length> drag-y: 0px;

    width: 280px;
    height: 400px;
    
    // Visibility and slide animation
    opacity: root.is-open ? 1.0 : 0.0;
    // Slint animation on x is driven by parent layout or bindings. 
    // We'll handle slide via x offset in SpaceView.

    background: RedesignTheme.t.elevated;
    border-width: 1px;
    border-color: RedesignTheme.t.border;
    border-radius: 4px;
    drop-shadow-color: RedesignTheme.t.shadow;
    drop-shadow-blur: 12px;

    VerticalLayout {
        padding: 0px;

        // Header (drag handle)
        TouchArea {
            height: 32px;
            moved => {
                root.drag-x += self.mouse-x - self.pressed-x;
                root.drag-y += self.mouse-y - self.pressed-y;
            }
            
            Rectangle {
                width: parent.width;
                height: parent.height;
                border-width: 0px;
                // bottom border
                Rectangle {
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: RedesignTheme.t.border;
                }
                
                HorizontalLayout {
                    padding-left: 14px; padding-right: 14px;
                    alignment: space-between;
                    Text {
                        text: "它的内在";
                        color: RedesignTheme.t.rep-400;
                        font-family: "JetBrains Mono";
                        font-size: 10px;
                        letter-spacing: 0.8px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "▴ 收纳";
                        color: RedesignTheme.t.muted;
                        font-size: 9px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Mock contents
        VerticalLayout {
            padding: 14px;
            spacing: 12px;

            Text { text: "子进程"; font-size: 11px; color: RedesignTheme.t.fg; }
            Text { text: "技能候选"; font-size: 11px; color: RedesignTheme.t.fg; }
            Text { text: "意识更新"; font-size: 11px; color: RedesignTheme.t.fg; }
            Text { text: "已归档"; font-size: 11px; color: RedesignTheme.t.faint; }
        }
        
        Rectangle { vertical-stretch: 1; }
    }
}
