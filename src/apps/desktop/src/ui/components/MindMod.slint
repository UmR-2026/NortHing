import { RedesignTheme } from "../redesign_palette.slint";
import { AppStrings } from "../strings.slint";

export component MindMod inherits Rectangle {
    in property <bool> is-open: false;
    in property <color> base-color: RedesignTheme.t.mind-drive-line;
    in-out property <length> drag-x: 0px;
    in-out property <length> drag-y: 0px;

    // T3：onboarding 诞生存根模式。true 时渲染仪式关卡 + 印记预览 + 终端井，
    // 替代默认的「它的内在」mock 内容。标题沿用 mind-mod-title 语感但走 onb-cert-title。
    in property <bool> onboarding-mode: false;
    in property <string> cert-title: AppStrings.mind-mod-title;
    in property <color> cert-mind-base: #7e8896;
    in property <bool> cert-step1-done: false;
    in property <bool> cert-step2-done: false;
    in property <bool> cert-step3-done: false;
    in property <bool> has-items: false;
    in property <string> cert-step1-status: AppStrings.onb-cert-step-pending;
    in property <string> cert-step2-status: AppStrings.onb-cert-step-pending;
    in property <string> cert-step3-status: AppStrings.onb-cert-step-pending;
    in property <string> cert-color-status: AppStrings.onb-cert-color-pending;
    in property <bool> cert-colored: false;
    in property <string> cert-identity-name: AppStrings.onb-head-name;
    // I2 修复：身份凝结 user-title / relation-title 实时渲染
    in property <string> cert-user-title: "";
    in property <string> cert-relation-title: "";
    in property <string> cert-user-ph: AppStrings.onb-field-user-ph;
    in property <string> cert-relation-ph: AppStrings.onb-field-relation-ph;

    width: 280px;
    height: 400px;

    // I8 修复：抽屉浮出动效（opacity 350ms cubic-bezier，非瞬切）。
    opacity: root.is-open ? 1.0 : 0.0;
    animate opacity { duration: 350ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }

    background: RedesignTheme.t.elevated;
    border-width: 1px;
    border-color: RedesignTheme.t.border;
    border-radius: 4px;
    drop-shadow-color: RedesignTheme.t.shadow;
    drop-shadow-blur: 12px;

    VerticalLayout {
        padding: 0px;

        // Header (drag handle)
        TouchArea {
            height: 32px;
            moved => {
                root.drag-x += self.mouse-x - self.pressed-x;
                root.drag-y += self.mouse-y - self.pressed-y;
            }
            
            Rectangle {
                width: parent.width;
                height: parent.height;
                border-width: 0px;
                // bottom border
                Rectangle {
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: RedesignTheme.t.border;
                }
                
                HorizontalLayout {
                    padding-left: 14px; padding-right: 14px;
                    alignment: space-between;
                    Text {
                        text: root.onboarding-mode ? root.cert-title : AppStrings.mind-mod-title;
                        color: root.onboarding-mode ? RedesignTheme.t.muted : root.base-color;
                        font-family: "JetBrains Mono";
                        font-size: 10px;
                        letter-spacing: 0.8px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.onboarding-mode ? AppStrings.onb-cert-collapse : AppStrings.mind-mod-collapse;
                        color: RedesignTheme.t.muted;
                        font-size: 9px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // T3：onboarding 诞生存根内容（仪式关卡 + 印记预览 + 终端井）。
        if root.onboarding-mode: Flickable {
            vertical-stretch: 1;
            width: parent.width;

            VerticalLayout {
                padding: 0px;
                spacing: 0px;
                width: parent.width;

                // 仪式关卡
                VerticalLayout {
                    padding-top: 12px;
                    padding-bottom: 12px;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 8px;
                    Text {
                        text: AppStrings.onb-cert-steps-title;
                        font-family: "JetBrains Mono";
                        font-size: 9px;
                        color: RedesignTheme.t.muted;
                        letter-spacing: 0.8px;
                    }
                    // step1
                    HorizontalLayout {
                        spacing: 7px;
                        Rectangle {
                            width: 8px; height: 8px; border-width: 1px;
                            border-color: root.cert-step1-done ? RedesignTheme.t.on-rep : RedesignTheme.t.muted;
                            background: root.cert-step1-done ? RedesignTheme.t.on-rep : transparent;
                            y: 3px;
                        }
                        Text {
                            text: AppStrings.onb-cert-step1;
                            font-size: 11px;
                            color: root.cert-step1-done ? RedesignTheme.t.faint : RedesignTheme.t.muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.cert-step1-status;
                            font-family: "JetBrains Mono";
                            font-size: 9px;
                            color: root.cert-step1-done ? RedesignTheme.t.on-rep : RedesignTheme.t.faint;
                            vertical-alignment: center;
                        }
                    }
                    // step2
                    HorizontalLayout {
                        spacing: 7px;
                        Rectangle {
                            width: 8px; height: 8px; border-width: 1px;
                            border-color: root.cert-step2-done ? RedesignTheme.t.on-rep : RedesignTheme.t.muted;
                            background: root.cert-step2-done ? RedesignTheme.t.on-rep : transparent;
                            y: 3px;
                        }
                        Text {
                            text: AppStrings.onb-cert-step2;
                            font-size: 11px;
                            color: root.cert-step2-done ? RedesignTheme.t.faint : RedesignTheme.t.muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.cert-step2-status;
                            font-family: "JetBrains Mono";
                            font-size: 9px;
                            color: root.cert-step2-done ? RedesignTheme.t.on-rep : RedesignTheme.t.faint;
                            vertical-alignment: center;
                        }
                    }
                    // step3
                    HorizontalLayout {
                        spacing: 7px;
                        Rectangle {
                            width: 8px; height: 8px; border-width: 1px;
                            border-color: root.cert-step3-done ? RedesignTheme.t.on-rep : RedesignTheme.t.muted;
                            background: root.cert-step3-done ? RedesignTheme.t.on-rep : transparent;
                            y: 3px;
                        }
                        Text {
                            text: AppStrings.onb-cert-step3;
                            font-size: 11px;
                            color: root.cert-step3-done ? RedesignTheme.t.faint : RedesignTheme.t.muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.cert-step3-status;
                            font-family: "JetBrains Mono";
                            font-size: 9px;
                            color: root.cert-step3-done ? RedesignTheme.t.on-rep : RedesignTheme.t.faint;
                            vertical-alignment: center;
                        }
                    }
                }

                // section divider
                Rectangle { height: 1px; background: RedesignTheme.t.border; }

                // 印记预览
                VerticalLayout {
                    padding-top: 12px;
                    padding-bottom: 12px;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 8px;
                    Text {
                        text: AppStrings.onb-cert-preview-title;
                        font-family: "JetBrains Mono";
                        font-size: 9px;
                        color: RedesignTheme.t.muted;
                        letter-spacing: 0.8px;
                    }
                    HorizontalLayout {
                        spacing: 7px;
                        Text {
                            text: AppStrings.onb-cert-color-label;
                            font-family: "JetBrains Mono";
                            font-size: 11px;
                            color: RedesignTheme.t.muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.cert-color-status;
                            font-family: "JetBrains Mono";
                            font-size: 10px;
                            color: root.cert-colored ? root.cert-mind-base : RedesignTheme.t.muted;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 7px;
                        Text {
                            text: AppStrings.onb-cert-identity-label;
                            font-family: "JetBrains Mono";
                            font-size: 11px;
                            color: RedesignTheme.t.muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.cert-identity-name;
                            font-family: "JetBrains Mono";
                            font-size: 10px;
                            color: RedesignTheme.t.muted;
                            vertical-alignment: center;
                        }
                    }
                    // I2 修复：user-title / relation-title 实时渲染
                    HorizontalLayout {
                        spacing: 7px;
                        Text {
                            text: AppStrings.onb-cert-user-label;
                            font-family: "JetBrains Mono";
                            font-size: 11px;
                            color: RedesignTheme.t.muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.cert-user-title != "" ? root.cert-user-title : root.cert-user-ph;
                            font-family: "JetBrains Mono";
                            font-size: 10px;
                            color: root.cert-user-title != "" ? RedesignTheme.t.fg : RedesignTheme.t.faint;
                            font-italic: root.cert-user-title == "";
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 7px;
                        Text {
                            text: AppStrings.onb-cert-relation-label;
                            font-family: "JetBrains Mono";
                            font-size: 11px;
                            color: RedesignTheme.t.muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.cert-relation-title != "" ? root.cert-relation-title : root.cert-relation-ph;
                            font-family: "JetBrains Mono";
                            font-size: 10px;
                            color: root.cert-relation-title != "" ? RedesignTheme.t.fg : RedesignTheme.t.faint;
                            font-italic: root.cert-relation-title == "";
                            vertical-alignment: center;
                        }
                    }
                }

                // 终端井（外层 padding 代替 margin，Rectangle 无 margin 属性）
                VerticalLayout {
                    padding-top: 10px;
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-bottom: 14px;
                    Rectangle {
                        border-width: 1px;
                        border-color: RedesignTheme.t.border;
                        border-radius: 4px;
                        background: RedesignTheme.t.bg;

                        VerticalLayout {
                            padding-top: 10px;
                            padding-bottom: 10px;
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: "$ northing init --ritual\n> chamber: uninhabited\n> awaiting human mind choice...\n> status: ready for awakening\n> _";
                                font-family: "JetBrains Mono";
                                font-size: 10px;
                                color: RedesignTheme.t.muted;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        // 默认 mock 内容（T2 主诊室态）
        if !root.onboarding-mode: VerticalLayout {
            padding-top: 14px; padding-bottom: 14px;
            padding-left: 14px; padding-right: 14px;
            spacing: 12px;
            if root.has-items : VerticalLayout {
                spacing: 12px;
                Text { text: AppStrings.mind-mod-item-subprocess; font-size: 11px; color: RedesignTheme.t.fg; }
                Text { text: AppStrings.mind-mod-item-skill-candidate; font-size: 11px; color: RedesignTheme.t.fg; }
                Text { text: AppStrings.mind-mod-item-awareness-update; font-size: 11px; color: RedesignTheme.t.fg; }
                Text { text: AppStrings.mind-mod-item-archived; font-size: 11px; color: RedesignTheme.t.faint; }
            }
            if !root.has-items : Text {
                text: AppStrings.mind-mod-empty;
                font-size: 10px;
                color: RedesignTheme.t.muted;
                font-family: "JetBrains Mono";
            }

            
            
            
            
        }
        
        Rectangle { vertical-stretch: 1; }
    }
}
