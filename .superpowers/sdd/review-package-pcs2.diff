+                            map.insert(
+                                dir_name.to_string(),
+                                BuiltinSkillSpec {
+                                    dir_name: dir_name.to_string(),
+                                    group,
+                                },
+                            );
+                        }
+                    }
+                }
+            }
+        }
+    }
+    map
