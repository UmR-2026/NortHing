-    changes = 0
-    for old, new in REPLACEMENTS:
-        # Skip identity mappings (old == new)
-        if old == new:
-            continue
-        old_b = old.encode("utf-8")
-        new_b = new.encode("utf-8")
-        if old_b in data:
-            count = data.count(old_b)
-            data = data.replace(old_b, new_b)
-            changes += count
-    return data, changes
-
-
