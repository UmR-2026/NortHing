-    ".git",
-    "target",
-    "node_modules",
-    "dist",
-    "build",
-    "__pycache__",
-}
-
-TEXT_EXTS = {
-    ".rs", ".toml", ".md", ".txt", ".json", ".yaml", ".yml",
-    ".sh", ".ps1", ".bat", ".cjs", ".mjs", ".js", ".ts", ".tsx",
-    ".css", ".scss", ".html", ".svg",
-    ".gitignore", ".gitattributes",
-    ".properties", ".conf", ".cfg", ".ini",
-    ".ftl", ".po", ".xml",
-    ".env", ".envrc",
-    ".slint", ".py", ".c", ".h", ".cpp", ".hpp",
-    ".service", ".timer",
-    ".5", ".7",
