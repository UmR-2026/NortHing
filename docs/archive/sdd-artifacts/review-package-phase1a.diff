-def should_skip(rel_path: str) -> bool:
-    parts = rel_path.replace("\\", "/").split("/")
-    if any(p in EXCLUDE_DIRS for p in parts):
-        return True
-    for pattern in EXCLUDE_PATH_PATTERNS:
-        if pattern.search(rel_path.replace("\\", "/")):
