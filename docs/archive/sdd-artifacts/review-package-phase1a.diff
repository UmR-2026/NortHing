-def parse_args_skip_self(args_text: str) -> list:
-    """Parse Rust arg list, return list of parameter names (skipping `self`/`&self`/`&mut self`)."""
-    out = []
-    depth = 0
-    cur = ""
-    for c in args_text:
-        if c == '(':
-            depth += 1
-            cur += c
-        elif c == ')':
-            depth -= 1
-            cur += c
-        elif c == ',' and depth == 0:
-            arg = cur.strip()
-            if arg:
