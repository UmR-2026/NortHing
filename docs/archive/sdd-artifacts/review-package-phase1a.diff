-                # Rebuild the declaration: indent + pub(super) + async + fn + new_name
-                # Capture original params + return type after the method name.
-                m2 = re.match(r'^(\s*)(?:pub(?:\([^)]+\))?\s+)?(?:async\s+)?fn\s+' + re.escape(method_name) + r'(.*)$', line)
